@LIT_SITE_CFG_IN_HEADER@

config.llvm_tools_dir = lit_config.substitute("@LLVM_TOOLS_DIR@")
config.ctcompile_src_root = "@CTCOMPILE_SOURCE_DIR@"
config.ctcompile_obj_root = "@CTCOMPILE_BINARY_DIR@"
config.ctcompile_tools_dirs = "@CTCOMPILE_TOOLS_DIRS@".split(";")

# THE HOST COMPILER AND THE ENGINE'S HEADERS, because an EmitC test that only
# checks the emitted text proves the weaker half. What matters is that the
# translation unit COMPILES against the real ABI - the C++ compiler is the
# strictest verifier this pipeline has, and it is free.
config.host_cxx = "@CMAKE_CXX_COMPILER@"
config.ctbrowser_include = "@CTBROWSER_MONOREPO_ROOT@/ctbrowser/include"

# THE ORACLES THE CTNative PYTHON DRIVERS COMPARE AGAINST: the Node CMake found
# for the Bootstrap data probes (BootstrapData.cmake, REQUIRED) and the
# interpreter reference (Native.cmake). Passed on the RUN lines as %node and
# %native_reference rather than rediscovered by walking up from ctjs-opt.
config.node = "@CTCOMPILE_BOOTSTRAP_NODE@"
config.native_reference = "@CTCOMPILE_BINARY_DIR@/test/ctcompile-test-native-reference"

# THE REST OF WHAT THE FORMER `cmake -P` CHECKS WERE HANDED. The monorepo root
# reaches tools/check and the vendored corpora; nm and the two clean-compile
# toolchains are what Native.cmake found; ctbrowser's tools directory holds
# the launcher (ctrun) and ctbrowse for the packaging round trip.
config.monorepo_root = "@CTBROWSER_MONOREPO_ROOT@"
config.ctbrowser_tools_dir = "@CMAKE_BINARY_DIR@/tools"
config.nm = "@_native_nm@"
config.clean_compilers = "@CTCOMPILE_CLEAN_GXX@,@CTCOMPILE_CLEAN_CLANGXX@"
config.cmake = "@CMAKE_COMMAND@"
config.dom_clang = "@_native_dom_clang@"
config.build_root = "@CMAKE_BINARY_DIR@"

import lit.llvm
lit.llvm.initialize(lit_config, config)

lit_config.load_config(config, "@CTCOMPILE_SOURCE_DIR@/test/lit.cfg.py")
