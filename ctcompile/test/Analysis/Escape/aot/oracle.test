# AOT-compiled frames record a catch-pad id instead of a bytecode position, so
# their allocations must show up as unclaimed and never as escape violations.
# The recording format writes that reserved compiled pc as an ordinary number,
# so escape-oracle.py reads it as UNCLAIMED with no special case.
# The first binary covers return, caught throw and mixed AOT/VM unwind; the
# second checks the boxed emitter's normalised return value, which keeps the
# compiled sentinel pc rather than inventing a source site.
#
# RUN: ctcompile-test-escape-oracle-aot --out %t.rec
# RUN: python3 %{monorepo}/tools/check/escape-oracle.py --recording %t.rec --infer all-escapes --name aot-unchecked --expect-unclaimed 4 --expect-violations 0 --expect-sound 0
# RUN: ctcompile-test-escape-oracle-aot-return --out %t.return.rec
# RUN: python3 %{monorepo}/tools/check/escape-oracle.py --recording %t.return.rec --infer all-escapes --name aot-return --expect-unclaimed 5 --expect-violations 0 --expect-sound 0
