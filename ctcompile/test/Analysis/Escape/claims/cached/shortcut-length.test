// RUN: split-file %s %t
// RUN: python3 %S/../check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name cached-shortcut-length
// RUN: FileCheck %s < %t/escape-claims-cached-shortcut-length.claims

// Actual incoming edges distinguish a direct shortcut from the longer path.
// Saved children, changing bounds and another receiver must retain escapes.
// CHECK: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj escapes:stored

//--- source.js
function cachedShortcutLengthCleared(flag) {
    var child = {}, array = [child, 0, child], holder = [array];
    var loaded = holder[0];
    if (flag) loaded = array;
    var length = loaded.length;
    for (var i = 0; i < length; i++) loaded[i] = 0;
    return array;
}
function cachedShortcutLengthSaved(flag) {
    var child = {}, array = [child, 0, child], holder = [array];
    var loaded = holder[0];
    if (flag) loaded = array;
    var length = loaded.length;
    for (var i = 0; i < length; i++) loaded[i] = 0;
    return child;
}
function cachedShortcutLengthChanged(flag) {
    var child = {}, array = [child, 0, child], holder = [array];
    var loaded = holder[0];
    if (flag) loaded = array;
    var length = loaded.length;
    for (var i = 0; i < length; i++) { loaded[i] = 0; length = 1; }
    return array;
}
function cachedShortcutLengthDifferent(flag) {
    var child = {}, array = [child, 0, child], holder = [array];
    var loaded = holder[0];
    if (flag) loaded = [0, 0, 0];
    var length = loaded.length;
    for (var i = 0; i < length; i++) loaded[i] = 0;
    return array;
}
cachedShortcutLengthCleared(false); cachedShortcutLengthCleared(true);
cachedShortcutLengthSaved(false); cachedShortcutLengthSaved(true);
cachedShortcutLengthChanged(false); cachedShortcutLengthChanged(true);
cachedShortcutLengthDifferent(false); cachedShortcutLengthDifferent(true);
