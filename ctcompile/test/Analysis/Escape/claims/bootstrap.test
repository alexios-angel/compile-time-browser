# Escape claims over the bootstrap corpus; check.py in this directory documents
# what is asserted. The collector's mark budget is unlimited for the fixture and
# bootstrap and bounded for p5 and phaser, the two big bundles, where each frame
# pop would otherwise cost a full mark.
# RUN: cat %{monorepo}/ctbrowser/vendor/bootstrap/bootstrap.bundle.js > %t.js && echo >> %t.js && cat %S/../../Types/bootstrap-driver.js >> %t.js
# RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t.js --work %t --name bootstrap
