// RUN: split-file %s %t
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name composed-index-overwrite
// RUN: FileCheck %s < %t/escape-claims-composed-index-overwrite.claims

// CHECK: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 7 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 8 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 9 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 10 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 11 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 12 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 13 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 14 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 15 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 16 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 17 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 18 {{[0-9]+}} obj escapes:stored

//--- source.js
function quotientOffset() {
    var child = {}, a = [0, child, child, 0];
    for (var i = 0; i < a.length; i += 2) a[i / 2 + 1] = 0;
    return a;
}
function offsetQuotient() {
    var child = {}, a = [0, child, child, 0];
    for (var i = 0; i < a.length; i += 2) a[(i + 2) / 2] = 0;
    return a;
}
function scalingOffset() {
    var child = {}, a = [0, child, 0, child];
    for (var i = 0; i < a.length; i += 2) a[(i * 2) / 2 + 1] = 0;
    return a;
}
function commuted() {
    var child = {}, a = [0, child, 0, child];
    for (var i = 0; i < a.length; i += 2) a[1 + (2 * i) / 2] = 0;
    return a;
}
function signedIntermediate() {
    var child = {}, a = [0, child, child, 0];
    for (var i = 0; i < a.length; i += 2) a[(i - 2) / 2 + 2] = 0;
    return a;
}
function reloadGap() {
    var child = {}, a = [0, child, 2, child, 0];
    for (var i = 0; i < a.length; i += 4) a[i / a[2] + 1] = 0;
    return a;
}
function saved() {
    var child = {}, a = [0, child, child, 0], saved = a[1];
    for (var i = 0; i < a.length; i += 2) a[i / 2 + 1] = 0;
    return saved;
}
function remaining() {
    var child = {}, a = [child, child, child, 0];
    for (var i = 0; i < a.length; i += 2) a[i / 2 + 1] = 0;
    return a;
}
function zeroTrip() {
    var child = {}, a = [0, child];
    for (var i = 2; i < a.length; i += 2) a[i / 2 + 1] = 0;
    return a;
}
function fractionalIntermediate() {
    var child = {}, a = [child, child, child];
    for (var i = 0; i < a.length; i++) a[(i / 2) * 2] = 0;
    return a;
}
function roundedIntermediate() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(i + 9007199254740992) - 9007199254740992] = 0;
    return a;
}
function overlappingReload() {
    var child = {}, a = [0, child, 0, 2, 0];
    for (var i = 0; i < a.length; i += 4) a[i / a[3] + 1] = 0;
    return a;
}
function laterOverlap() {
    var child = {}, a = [0, child, 2, child, 0];
    for (var i = 0; i < a.length; i += 4) {
        a[i / a[2] + 1] = 0;
        a[2] = 1;
    }
    return a;
}
function changingOffset() {
    var child = {}, a = [0, child, child, 0], offset = 1;
    for (var i = 0; i < a.length; i += 2) {
        a[i / 2 + offset] = 0;
        offset = 0;
    }
    return a;
}
function stringOffset() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i += 2) a[i / 2 + "1"] = 0;
    return a;
}
function zeroFactor() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i += 2) a[(i / 2) * 0] = 0;
    return a;
}
function growth() {
    var child = {}, a = [child, 0];
    for (var i = 0; i < a.length; i += 4) a[i * 2 + 2] = 0;
    return a;
}
function cycle() {
    var child = {}, a = [0, child, child, 0];
    for (var i = 0; i < a.length; i += 2) {
        a[i / 2 + 1] = a;
        a[i / 2 + 1] = 0;
    }
    return a;
}
quotientOffset(); offsetQuotient(); scalingOffset(); commuted(); signedIntermediate(); reloadGap();
saved(); remaining(); zeroTrip(); fractionalIntermediate(); roundedIntermediate();
overlappingReload(); laterOverlap(); changingOffset(); stringOffset(); zeroFactor(); growth(); cycle();
