// CHECK: escape {{[0-9a-f]+}} 57 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 58 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 59 {{[0-9]+}} obj escapes:stored
