// CHECK: escape {{[0-9a-f]+}} 18 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 19 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 20 {{[0-9]+}} obj escapes:stored

