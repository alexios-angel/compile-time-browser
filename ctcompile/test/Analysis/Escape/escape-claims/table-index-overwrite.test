    return a;
}
function dividedTableKey() {
    var child = {}, a = [0, child, child], keys = ['1', '2'];
    for (var i = 0; i < a.length; i++) a[2 / keys[i % 2]] = 0;
    return a;
}
function shiftedTableKey() {
    var child = {}, a = [child, 0, child], keys = [false, '1'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2] << 1] = 0;
    return a;
}
function poweredTableKey() {
