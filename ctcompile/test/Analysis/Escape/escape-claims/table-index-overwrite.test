}
function overwrittenStringTableReceiver() {
    var child = {}, keys = ['0', '1'], a = [child, keys, child];
    for (var i = 0; i < a.length; i++) a[a[1][i % 2]] = 0;
    return a;
}
stringTableKey(); mixedTableKey(); selectedStringTableKey(); nestedStringTableKey();
retainedStringTableKey(); savedStringTableChild(); noncanonicalStringTableKey();
concatenatedStringTableKey(); mutatedStringTableAlias(); overwrittenStringTableReceiver();

