}
function noncanonicalStringTableKey() {
    var child = {}, a = [child, 0, child], keys = ['00', '2'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return a;
}
function concatenatedStringTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2] + 0] = 0;
    return a;
}
function mutatedStringTableAlias() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'], alias = keys;
    for (var i = 0; i < a.length; i++) {
        alias[1] = '0';
