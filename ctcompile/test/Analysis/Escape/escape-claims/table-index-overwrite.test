// RUN: split-file %s %t
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name table-index-overwrite
// RUN: FileCheck %s < %t/escape-claims-table-index-overwrite.claims

// Varying reads need an invariant independent table. Replay keeps actual writes,
// saved identities and untouched children; mutation and overlapping receiver reads refuse.
// CHECK: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 7 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 8 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 9 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 10 {{[0-9]+}} obj escapes:stored

// Canonical String table keys retain property spelling and primitive identity.
// CHECK: escape {{[0-9a-f]+}} 11 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 12 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 13 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 14 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 15 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 16 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 17 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 18 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 19 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 20 {{[0-9]+}} obj escapes:stored

// Explicit unary conversions retain original table values and prior String operations.
// CHECK: escape {{[0-9a-f]+}} 21 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 22 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 23 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 24 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 25 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 26 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 27 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 28 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 29 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 30 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 31 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 32 {{[0-9]+}} obj escapes:stored

// Numeric binary conversions preserve primitive identity without broadening Add.
// CHECK: escape {{[0-9a-f]+}} 33 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 34 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 35 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 36 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 37 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 38 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 39 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 40 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 41 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 42 {{[0-9]+}} obj escapes:stored

// BigInt keys convert only at property boundaries, preserving retained children.
// CHECK: escape {{[0-9a-f]+}} 43 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 44 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 45 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 46 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 47 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 48 {{[0-9]+}} obj escapes:stored

//--- source.js
function varyingTableKey() {
    var child = {}, a = [child, 0, child], keys = [0, 2];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return a;
}
function reversedTableKey() {
    var child = {}, a = [child, 0, child], keys = [2, 0];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return a;
}
function selectedTableKey() {
    var child = {}, keys = [0, 2], a = [child, keys, child];
    for (var i = 0; i < a.length; i++) a[a[1][i % 2]] = 0;
    return a;
}
function retainedTableKey() {
    var child = {}, a = [child, 0, child], keys = [0, 0];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return a;
}
function savedTableChild() {
    var child = {}, a = [child, 0, child], keys = [0, 2], saved = a[0];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return [saved, a];
}
function mutatedTableKey() {
    var child = {}, a = [child, 0, child], keys = [0, 2];
    for (var i = 0; i < a.length; i++) {
        keys[1] = 0;
        a[keys[i % 2]] = 0;
    }
    return a;
}
function mutatedTableAlias() {
    var child = {}, a = [child, 0, child], keys = [0, 2], alias = keys;
    for (var i = 0; i < a.length; i++) {
        alias[1] = 0;
        a[keys[i % 2]] = 0;
    }
    return a;
}
function resizedTableKey() {
    var child = {}, a = [child, 0, child], keys = [0, 2];
    for (var i = 0; i < a.length; i++) {
        keys.length = 1;
        a[keys[i % 2]] = 0;
    }
    return a;
}
function guardTableKey() {
    var child = {}, a = [0, child, 2];
    for (var i = 0; i < a.length; i++) a[a[i % 2]] = 0;
    return a;
}
function overwrittenTableReceiver() {
    var child = {}, keys = [0, 1], a = [child, keys, child];
    for (var i = 0; i < a.length; i++) a[a[1][i % 2]] = 0;
    return a;
}
varyingTableKey(); reversedTableKey(); selectedTableKey(); retainedTableKey();
savedTableChild(); mutatedTableKey(); mutatedTableAlias(); resizedTableKey();
guardTableKey(); overwrittenTableReceiver();

function stringTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return a;
}
function mixedTableKey() {
    var child = {}, a = [child, 0, child], keys = [0, '2'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return a;
}
function selectedStringTableKey() {
    var child = {}, keys = ['0', '2'], a = [child, keys, child];
    for (var i = 0; i < a.length; i++) a[a[1][i % 2]] = 0;
    return a;
}
function nestedStringTableKey() {
    var child = {}, a = [child, 0, child], picks = ['0', '1'], keys = ['0', '2'];
    for (var i = 0; i < a.length; i++) a[keys[picks[i % 2]]] = 0;
    return a;
}
function retainedStringTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '0'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return a;
}
function savedStringTableChild() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'], saved = a[0];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return [saved, a];
}
function noncanonicalStringTableKey() {
    var child = {}, a = [child, 0, child], keys = ['00', '2'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return a;
}
function concatenatedStringTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2] + 0] = 0;
    return a;
}
function mutatedStringTableAlias() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'], alias = keys;
    for (var i = 0; i < a.length; i++) {
        alias[1] = '0';
        a[keys[i % 2]] = 0;
    }
    return a;
}
function overwrittenStringTableReceiver() {
    var child = {}, keys = ['0', '1'], a = [child, keys, child];
    for (var i = 0; i < a.length; i++) a[a[1][i % 2]] = 0;
    return a;
}
stringTableKey(); mixedTableKey(); selectedStringTableKey(); nestedStringTableKey();
retainedStringTableKey(); savedStringTableChild(); noncanonicalStringTableKey();
concatenatedStringTableKey(); mutatedStringTableAlias(); overwrittenStringTableReceiver();

function convertedStringTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'];
    for (var i = 0; i < a.length; i++) a[+keys[i % 2]] = 0;
    return a;
}
function negatedStringTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '-2'];
    for (var i = 0; i < a.length; i++) a[-keys[i % 2]] = 0;
    return a;
}
function complementedStringTableKey() {
    var child = {}, a = [child, 0, child], keys = ['-1', '-3'];
    for (var i = 0; i < a.length; i++) a[~keys[i % 2]] = 0;
    return a;
}
function selectedConvertedTableKey() {
    var child = {}, keys = ['0', '2'], a = [child, keys, child];
    for (var i = 0; i < a.length; i++) a[+a[1][i % 2]] = 0;
    return a;
}
function mixedConvertedTableKey() {
    var child = {}, a = [child, 0, child], keys = [null, '2'];
    for (var i = 0; i < a.length; i++) a[+keys[i % 2]] = 0;
    return a;
}
function retainedConvertedTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '0'];
    for (var i = 0; i < a.length; i++) a[+keys[i % 2]] = 0;
    return a;
}
function savedConvertedTableChild() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'], saved = a[0];
    for (var i = 0; i < a.length; i++) a[+keys[i % 2]] = 0;
    return [saved, a];
}
function noncanonicalConvertedTableKey() {
    var child = {}, a = [child, 0, child], keys = ['00', '2'];
    for (var i = 0; i < a.length; i++) a[+keys[i % 2]] = 0;
    return a;
}
function concatenatedConvertedTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'];
    for (var i = 0; i < a.length; i++) a[+(keys[i % 2] + 0)] = 0;
    return a;
}
function mutatedConvertedTableAlias() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'], alias = keys;
    for (var i = 0; i < a.length; i++) {
        alias[1] = '0';
        a[+keys[i % 2]] = 0;
    }
    return a;
}
function overwrittenConvertedTableReceiver() {
    var child = {}, keys = ['0', '1'], a = [child, keys, child];
    for (var i = 0; i < a.length; i++) a[+a[1][i % 2]] = 0;
    return a;
}
function unconvertedSignedTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '-2'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return a;
}
convertedStringTableKey(); negatedStringTableKey(); complementedStringTableKey();
selectedConvertedTableKey(); mixedConvertedTableKey(); retainedConvertedTableKey();
savedConvertedTableChild(); noncanonicalConvertedTableKey(); concatenatedConvertedTableKey();
mutatedConvertedTableAlias(); overwrittenConvertedTableReceiver(); unconvertedSignedTableKey();

function subtractedTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2] - 0] = 0;
    return a;
}
function multipliedTableKey() {
    var child = {}, a = [child, 0, child], keys = [null, '2'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2] * 1] = 0;
    return a;
}
function dividedTableKey() {
    var child = {}, a = [0, child, child], keys = ['1', '2'];
    for (var i = 0; i < a.length; i++) a[2 / keys[i % 2]] = 0;
    return a;
}
function shiftedTableKey() {
    var child = {}, a = [child, 0, child], keys = [false, '1'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2] << 1] = 0;
    return a;
}
function poweredTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2] ** 1] = 0;
    return a;
}
function savedBinaryTableChild() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'], saved = a[0];
    for (var i = 0; i < a.length; i++) a[keys[i % 2] - 0] = 0;
    return saved;
}
function concatenatedBinaryTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '0'];
    for (var i = 0; i < a.length; i++) a[+(keys[i % 2] + 0)] = 0;
    return a;
}
function noncanonicalBinaryTableKey() {
    var child = {}, a = [child, 0, child], keys = ['00', '2'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2] * 1] = 0;
    return a;
}
function mutatedBinaryTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '2'];
    for (var i = 0; i < a.length; i++) {
        a[keys[i % 2] - 0] = 0;
        keys[1] = '0';
    }
    return a;
}
function overlappingBinaryTableReceiver() {
    var child = {}, keys = ['0', '1'], a = [child, keys, child];
    for (var i = 0; i < a.length; i++) a[a[1][i % 2] * 1] = 0;
    return a;
}
subtractedTableKey(); multipliedTableKey(); dividedTableKey(); shiftedTableKey(); poweredTableKey();
savedBinaryTableChild(); concatenatedBinaryTableKey(); noncanonicalBinaryTableKey();
mutatedBinaryTableKey(); overlappingBinaryTableReceiver();
function bigintTableKey() {
    var child = {}, a = [child, 0, child], keys = [0n, 2n];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return a;
}
function mixedBigintTableKey() {
    var child = {}, a = [child, 0, child], keys = [0n, '2'];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return a;
}
function nestedBigintTableKey() {
    var child = {}, a = [child, 0, child], picks = [0n, 1n], keys = [0n, 2n];
    for (var i = 0; i < a.length; i++) a[keys[picks[i % 2]]] = 0;
    return a;
}
function savedBigintTableChild() {
    var child = {}, a = [child, 0, child], keys = [0n, 2n], saved = a[0];
    for (var i = 0; i < a.length; i++) a[keys[i % 2]] = 0;
    return [saved, a];
}
function mutatedBigintTableKey() {
    var child = {}, a = [child, 0, child], keys = [0n, 2n];
    for (var i = 0; i < a.length; i++) {
        a[keys[i % 2]] = 0;
        keys[1] = 0n;
    }
    return a;
}
function mixedBigintArithmeticTableKey() {
    var child = {}, a = [child, 0, child], keys = [0n, 2n];
    for (var i = 0; i < a.length; i++) a[keys[i % 2] + 0] = 0;
    return a;
}
bigintTableKey(); mixedBigintTableKey(); nestedBigintTableKey();
savedBigintTableChild(); mutatedBigintTableKey(); mixedBigintArithmeticTableKey();
