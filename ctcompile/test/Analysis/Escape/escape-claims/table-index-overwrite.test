// CHECK: escape {{[0-9a-f]+}} 41 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 42 {{[0-9]+}} obj escapes:stored

// BigInt keys convert only at property boundaries, preserving retained children.
// CHECK: escape {{[0-9a-f]+}} 43 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 44 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 45 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 46 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 47 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 48 {{[0-9]+}} obj escapes:stored

// Bounded decimal conversion keeps spelling separate from numeric facts.
// CHECK: escape {{[0-9a-f]+}} 49 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 50 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 51 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 52 {{[0-9]+}} obj escapes:stored
