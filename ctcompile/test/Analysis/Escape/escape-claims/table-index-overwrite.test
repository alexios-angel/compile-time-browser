// CHECK: escape {{[0-9a-f]+}} 12 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 13 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 14 {{[0-9]+}} obj confined
