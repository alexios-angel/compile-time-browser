// Decimal points and exponents convert only to bounded integral Number facts.
// CHECK: escape {{[0-9a-f]+}} 61 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 62 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 63 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 64 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 65 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 66 {{[0-9]+}} obj escapes:stored

// Fractional Strings truncate only at bitwise operations, preserving original keys.
// CHECK: escape {{[0-9a-f]+}} 67 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 68 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 69 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 70 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 71 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 72 {{[0-9]+}} obj escapes:stored

// Each new child site must be observed, including retained-child controls.
