    return a;
}
function mixedConvertedTableKey() {
    var child = {}, a = [child, 0, child], keys = [null, '2'];
    for (var i = 0; i < a.length; i++) a[+keys[i % 2]] = 0;
    return a;
}
function retainedConvertedTableKey() {
    var child = {}, a = [child, 0, child], keys = ['0', '0'];
    for (var i = 0; i < a.length; i++) a[+keys[i % 2]] = 0;
    return a;
}
function savedConvertedTableChild() {
