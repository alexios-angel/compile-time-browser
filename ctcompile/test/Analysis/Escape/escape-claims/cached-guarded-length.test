// RUN: split-file %s %t
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name cached-guarded-length
// RUN: FileCheck %s < %t/escape-claims-cached-guarded-length.claims

// The guard separates allocation and read blocks without repeating either.
// Saved children, changing bounds and changed receivers remain escaping.
// CHECK: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj escapes:stored

//--- source.js
function cachedGuardedLengthCleared(flag) {
    var child = {}, array = [child, 0, child], holder = [array];
    if (flag) return 0;
    var loaded = holder[0], length = loaded.length;
    for (var i = 0; i < length; i++) loaded[i] = 0;
    return array;
}
function cachedGuardedLengthSaved(flag) {
    var child = {}, array = [child, 0, child], holder = [array];
    if (flag) return 0;
    var loaded = holder[0], length = loaded.length, saved = loaded[0];
    for (var i = 0; i < length; i++) loaded[i] = 0;
    return saved;
}
function cachedGuardedLengthChanged(flag) {
    var child = {}, array = [child, 0, child], holder = [array];
    if (flag) return 0;
    var loaded = holder[0], length = loaded.length;
    for (var i = 0; i < length; i++) {
        loaded[i] = 0;
        length = 1;
    }
    return array;
}
function cachedGuardedLengthReceiverChanged(flag) {
    var child = {}, array = [child, 0, child], holder = [array];
    if (flag) return 0;
    var loaded = holder[0], length = loaded.length;
    loaded = [0, 0, 0];
    for (var i = 0; i < length; i++) loaded[i] = 0;
    return array;
}
cachedGuardedLengthCleared(false); cachedGuardedLengthCleared(true);
cachedGuardedLengthSaved(false); cachedGuardedLengthSaved(true);
cachedGuardedLengthChanged(false); cachedGuardedLengthChanged(true);
cachedGuardedLengthReceiverChanged(false); cachedGuardedLengthReceiverChanged(true);
