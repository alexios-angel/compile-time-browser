// RUN: split-file %s %t
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name bitor-xor-index-overwrite
// RUN: FileCheck %s < %t/escape-claims-bitor-xor-index-overwrite.claims

// CHECK: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 7 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 8 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 9 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 10 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 11 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 12 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 13 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 14 {{[0-9]+}} obj escapes:stored

//--- source.js
function orWrites() {
    var child = {}, a = [0, child, 0, child];
    for (var i = 0; i < a.length; i++) a[i | 1] = 0;
    return a;
}
function orCommuted() {
    var child = {}, a = [0, child];
    for (var i = 0; i < a.length; i++) a[1 | i] = 0;
    return a;
}
function xorWrites() {
    var child = {}, a = [child, child, child, child];
    for (var i = 0; i < a.length; i++) a[i ^ 1] = 0;
    return a;
}
function xorCommuted() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[1 ^ i] = 0;
    return a;
}
function orReload() {
    var child = {}, a = [1, child, 0, 0];
    for (var i = 0; i < a.length; i++) a[i | a[0]] = 0;
    return a;
}
function xorReload() {
    var child = {}, a = [child, child, 1, 0];
    for (var i = 0; i < a.length; i++) a[(i & 1) ^ a[2]] = 0;
    return a;
}
function savedChild() {
    var child = {}, a = [child, child], saved = a[0];
    for (var i = 0; i < a.length; i++) a[i ^ 1] = 0;
    return saved;
}
function remainingGap() {
    var child = {}, a = [child, child, child, child];
    for (var i = 0; i < a.length; i++) a[i | 1] = 0;
    return a;
}
function highSignedBand() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(2147483646 + i) ^ 2147483647] = 0;
    return a;
}
function unsignedBand() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(2147483648 + i) ^ 2147483648] = 0;
    return a;
}
function negativeMask() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i | -1] = 0;
    return a;
}
function fractionalMask() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i ^ 1.5] = 0;
    return a;
}
function overwrittenReload() {
    var child = {}, a = [1, child, 0, 0];
    for (var i = 0; i < a.length; i++) {
        a[i | a[0]] = 0;
        a[0] = 0;
    }
    return a;
}
function varyingMask() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i ^ i] = 0;
    return a;
}
orWrites(); orCommuted(); xorWrites(); xorCommuted(); orReload(); xorReload(); savedChild();
remainingGap(); highSignedBand(); unsignedBand(); negativeMask(); fractionalMask();
overwrittenReload(); varyingMask();
