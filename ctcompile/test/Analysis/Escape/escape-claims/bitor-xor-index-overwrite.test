}
function savedSignedChild() {
    var child = {}, a = [child, child], saved = a[0];
    for (var i = 0; i < a.length; i++) a[(~i) ^ -1] = 0;
    return saved;
}
function signedRemainingGap() {
    var child = {}, a = [child, child, child, child];
    for (var i = 0; i < a.length; i++) a[(i | -2147483647) + 2147483648] = 0;
