remainingGap(); highSignedBand(); unsignedBand(); negativeMask(); fractionalMask();
overwrittenReload(); varyingMask();
negativeXor(); negativeXorCommuted(); negativeLowBand(); signedOrOutput();
unsignedMaskOrOutput(); unsignedInputOrOutput(); signedOrReload(); savedSignedChild();
signedRemainingGap(); signedCrossZero(); upperInputCrossing(); lowerInputCrossing();
overwrittenSignedReload(); highPrefixInteriorExtrema();
