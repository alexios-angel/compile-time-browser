// RUN: split-file %s %t
// RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/source.js | FileCheck %s --check-prefix=IMPORT
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name signed-product
// RUN: FileCheck %s --check-prefix=CLAIM < %t/escape-claims-signed-product.claims

// Products retain signed Number snapshots and exact canonical String conversions.
// IMPORT-LABEL: ctjs.func @snapshotReleased$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.set_property
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @snapshotReturned$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.set_property
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @positiveReleased$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @positiveReturned$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @zeroReleased$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @zeroReturned$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @coercibleRight$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @coercibleLeft$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.binary mul
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 7 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 7 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 8 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 8 {{[0-9]+}} arr confined

// IMPORT-LABEL: ctjs.func @stringSnapshotReturned$
// IMPORT: ctjs.get_property
// IMPORT: ctjs.set_property
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @noncanonicalFactor$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.binary mul
// CLAIM: escape {{[0-9a-f]+}} 9 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 9 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 9 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 10 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 10 {{[0-9]+}} arr escapes:passed

//--- source.js
function snapshotReleased() {
    var child = {}, array = [child, child, child], seed = [1, 1, 1], saved = 0;
    var negative = 1 - seed.length;
    seed.length = 0;
    var factor = 1 + 0, step = negative * factor;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function snapshotReturned() {
    var child = {}, array = [child, child, child], seed = [1, 1, 1], saved = 0;
    var negative = 1 - seed.length;
    seed.length = 0;
    var factor = 1 + 0, step = factor * negative;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return saved;
}
function positiveReleased() {
    var child = {}, array = [child, child, child], saved = 0;
    var negative = 1 - 3, step = negative * negative;
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return 0;
}
function positiveReturned() {
    var child = {}, array = [child, child, child], saved = 0;
    var negative = 1 - 3, step = negative * negative;
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return saved;
}
function zeroReleased() {
    var child = {}, array = [child, child, child], saved = 0;
    var negative = 1 - 3, start = negative * 0;
    for (var i = start; i < array.length; i++) {
        saved = array[i];
    }
    return 0;
}
function zeroReturned() {
    var child = {}, array = [child, child, child], saved = 0;
    var negative = 1 - 3, start = 0 * negative;
    for (var i = start; i < array.length; i++) {
        saved = array[i];
    }
    return saved;
}
function coercibleRight() {
    var child = {}, array = [child, child, child], saved = 0;
    var negative = 1 - 3, step = negative * "1";
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function coercibleLeft() {
    var child = {}, array = [child, child, child], saved = 0;
    var negative = 1 - 3, step = "1" * negative;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function stringSnapshotReturned() {
    var child = {}, array = [child, child, child], source = ["2"], saved = 0;
    var factor = source[0];
    source[0] = 0;
    var step = factor * "1";
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return saved;
}
function noncanonicalFactor() {
    var child = {}, array = [child, child, child], saved = 0;
    var negative = 1 - 3, step = negative * "01";
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
snapshotReleased();
var snapshotRetained = snapshotReturned();
positiveReleased();
var positiveRetained = positiveReturned();
zeroReleased();
var zeroRetained = zeroReturned();
coercibleRight();
coercibleLeft();
var stringRetained = stringSnapshotReturned();
noncanonicalFactor();
