// RUN: split-file %s %t
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name offset-index-overwrite
// RUN: FileCheck %s < %t/escape-claims-offset-index-overwrite.claims

// CHECK: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 7 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 8 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 9 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 10 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 11 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 12 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 13 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 14 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 15 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 16 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 17 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 18 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 19 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 20 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 21 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 22 {{[0-9]+}} obj escapes:stored

//--- source.js
function next() {
    var child = {}, a = [0, child, 0, child];
    for (var i = 0; i < a.length; i += 2) a[i + 1] = 0;
    return a;
}
function commuted() {
    var child = {}, a = [0, child, 0, child];
    for (var i = 0; i < a.length; i += 2) a[1 + i] = 0;
    return a;
}
function previous() {
    var child = {}, a = [child, 0, child, 0];
    for (var i = 1; i < a.length; i += 2) a[i - 1] = 0;
    return a;
}
function negative() {
    var child = {}, a = [child, 0, child, 0], offset = -1;
    for (var i = 1; i < a.length; i += 2) a[i + offset] = 0;
    return a;
}
function reloadedOffset() {
    var child = {}, a = [1, child, 1, child];
    for (var i = 0; i < a.length; i += 2) a[i + a[0]] = 0;
    return a;
}
function previousStride() {
    var child = {}, a = [child, 2, child, 0];
    for (var i = 1; i < a.length; i += a[1]) a[i - 1] = 0;
    return a;
}
function zeroTrip() {
    var child = {}, a = [0, child];
    for (var i = 2; i < a.length; i += 2) a[i + 1] = 0;
    return a;
}
function underflow() {
    var child = {}, a = [child, 0];
    for (var i = 0; i < a.length; i++) a[i - 1] = 0;
    return a;
}
function overrun() {
    var child = {}, a = [0, child, 0];
    for (var i = 0; i < a.length; i += 2) a[i + 1] = 0;
    return a;
}
function overlap() {
    var child = {}, a = [1, 1, child, 1];
    for (var i = 0; i < a.length; i += 2) a[i + a[1]] = 0;
    return a;
}
function saved() {
    var child = {}, a = [0, child], saved = a[1];
    for (var i = 0; i < a.length; i += 2) a[i + 1] = 0;
    return saved;
}
function remaining() {
    var child = {}, a = [child, child, 0, child];
    for (var i = 0; i < a.length; i += 2) a[i + 1] = 0;
    return a;
}
function stringOffset() {
    var child = {}, a = [child];
    for (var i = 0; i < a.length; i += 2) a[i + "1"] = 0;
    return a;
}
function changingOffset() {
    var child = {}, a = [0, child, child, 0], offset = 1;
    for (var i = 0; i < a.length; i += 2) {
        a[i + offset] = 0;
        offset = 0;
    }
    return a;
}
function laterStrideOverlap() {
    var child = {}, a = [0, child, 0, 2];
    for (var i = 0; i < a.length; i += a[3]) a[i + 1] = 3;
    return a;
}
function cycle() {
    var child = {}, a = [0, child];
    for (var i = 0; i < a.length; i += 2) {
        a[i + 1] = a;
        a[i + 1] = 0;
    }
    return a;
}
next(); commuted(); previous(); negative(); reloadedOffset(); previousStride();
zeroTrip(); underflow(); overrun(); overlap(); saved(); remaining();
stringOffset(); changingOffset(); laterStrideOverlap(); cycle();

function stringPrevious() {
    var child = {}, a = [child, 0, child, 0];
    for (var i = 1; i < a.length; i += 2) a[i - "1"] = 0;
    return a;
}
function booleanPrevious() {
    var child = {}, a = [child, 0, child, 0];
    for (var i = 1; i < a.length; i += 2) a[i - true] = 0;
    return a;
}
function negativeStringOffset() {
    var child = {}, a = [0, child, 0, child];
    for (var i = 0; i < a.length; i += 2) a[i - "-1"] = 0;
    return a;
}
function nullOffset() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i - null] = 0;
    return a;
}
function noncanonicalOffset() {
    var child = {}, a = [child, 0, child, 0];
    for (var i = 1; i < a.length; i += 2) a[i - "01"] = 0;
    return a;
}
function undefinedOffset() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i - undefined] = 0;
    return a;
}
stringPrevious(); booleanPrevious(); negativeStringOffset(); nullOffset();
noncanonicalOffset(); undefinedOffset();
