// RUN: split-file %s %t
// RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/source.js | FileCheck %s --check-prefix=IMPORT
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name sub-snapshot
// RUN: FileCheck %s --check-prefix=CLAIM < %t/escape-claims-sub-snapshot.claims

// Exact Number subtraction preserves its negative result through Plus/Neg
// and source-array mutation. A coercible operand grants no signed snapshot.
// IMPORT-LABEL: ctjs.func @subReleased$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.unary plus
// IMPORT: ctjs.binary sub
// IMPORT-LABEL: ctjs.func @subReturned$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.unary plus
// IMPORT: ctjs.binary sub
// IMPORT-LABEL: ctjs.func @snapshotReleased$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.set_property
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @snapshotReturned$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.set_property
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @coercibleLeft$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.binary sub
// IMPORT-LABEL: ctjs.func @coercibleRight$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.binary sub
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} arr escapes:passed

//--- source.js
function subReleased() {
    var child = {}, array = [child, child, child], saved = 0;
    var left = 1 + 0, right = 1 + 2, negative = left - right, step = +negative;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function subReturned() {
    var child = {}, array = [child, child, child], saved = 0;
    var left = 1 + 0, right = 1 + 2, negative = left - right, step = +negative;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return saved;
}
function snapshotReleased() {
    var child = {}, array = [child, child, child], saved = 0, seed = [1, 1, 1];
    var left = 1 + 0, right = seed.length, negative = left - right;
    seed.length = 0;
    var step = -negative;
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return 0;
}
function snapshotReturned() {
    var child = {}, array = [child, child, child], saved = 0, seed = [1, 1, 1];
    var left = 1 + 0, right = seed.length, negative = left - right;
    seed.length = 0;
    var step = -negative;
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return saved;
}
function coercibleLeft() {
    var child = {}, array = [child, child, child], saved = 0;
    var step = "1" - 3;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function coercibleRight() {
    var child = {}, array = [child, child, child], saved = 0;
    var step = 1 - "3";
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
subReleased();
var subRetained = subReturned();
snapshotReleased();
var snapshotRetained = snapshotReturned();
coercibleLeft();
coercibleRight();
