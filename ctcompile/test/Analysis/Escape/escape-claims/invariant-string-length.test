// RUN: split-file %s %t
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name invariant-string-length
// RUN: FileCheck %s < %t/escape-claims-invariant-string-length.claims

// Original ASCII literals agree with Script's byte length and JS UTF-16 length.
// Unknown, computed and non-ASCII strings retain their conservative boundary.
// CHECK: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 7 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 8 {{[0-9]+}} obj confined

// CHECK: escape {{[0-9a-f]+}} 9 {{[0-9]+}} obj escapes:stored

//--- source.js
function released() {
    var child = {}, array = [child], text = 'a', saved = 0;
    for (var i = 0; i < array.length; i += text.length) saved = array[i];
    return 0;
}
function retained() {
    var child = {}, array = [child], text = 'a', saved = 0;
    for (var i = 0; i < array.length; i += text.length) saved = array[i];
    return saved;
}
function savedLength() {
    var child = {}, array = [child], text = 'a', stride = text.length, saved = 0;
    text = 'bb';
    for (var i = 0; i < array.length; i += stride) saved = array[i];
    return 0;
}
function loadedString() {
    var child = {}, array = [child], texts = ['a'], saved = 0;
    for (var i = 0; i < array.length; i += texts[0].length) saved = array[i];
    return 0;
}
function unicodeLength() {
    var child = {}, array = [child], text = 'é', saved = 0;
    for (var i = 0; i < array.length; i += text.length) saved = array[i];
    return 0;
}
function computedLength() {
    var child = {}, array = [child], text = typeof 1, saved = 0;
    for (var i = 0; i < array.length; i += text.length) saved = array[i];
    return 0;
}
// Every latch reads the same literal despite the earlier initial value.
function changedString() {
    var child = {}, array = [child], text = 'a', saved = 0;
    for (var i = 0; i < array.length; i += text.length) {
        saved = array[i]; text = 'bb';
    }
    return 0;
}
function loopWrite() {
    var child = {}, array = [child], text = 'a', saved = 0;
    for (var i = 0; i < array.length; i += text.length) {
        saved = array[i]; array[0] = 0;
    }
    return 0;
}
function growingString() {
    var child = {}, array = [child], text = 'a', saved = 0;
    for (var i = 0; i < array.length; i += text.length) {
        saved = array[i]; text = text + 'b';
    }
    return 0;
}
released(); retained(); savedLength(); loadedString(); unicodeLength(); computedLength();
changedString(); loopWrite(); growingString();
