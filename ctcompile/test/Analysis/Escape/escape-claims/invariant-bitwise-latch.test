// RUN: split-file %s %t
// RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/source.js | FileCheck %s --check-prefix=IMPORT
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name invariant-bitwise-latch
// RUN: FileCheck %s --check-prefix=CLAIM < %t/escape-claims-invariant-bitwise-latch.claims

// Invariant bitwise latches preserve original primitive snapshots, signed results
// and masked shift counts. Changed/reloaded operands and unsafe bounds refuse.
// IMPORT-LABEL: ctjs.func @savedAnd$
// IMPORT: ctjs.binary_static bitand
// IMPORT-LABEL: ctjs.func @savedOr$
// IMPORT: ctjs.binary_static bitor
// IMPORT-LABEL: ctjs.func @savedXor$
// IMPORT: ctjs.binary_static bitxor
// IMPORT-LABEL: ctjs.func @maskedLeft$
// IMPORT: ctjs.binary_static shl
// IMPORT-LABEL: ctjs.func @signedRight$
// IMPORT: ctjs.binary_static shr
// IMPORT: ctjs.binary sub
// IMPORT-LABEL: ctjs.func @unsignedRight$
// IMPORT: ctjs.binary_static ushr
// IMPORT-LABEL: ctjs.func @nested$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.binary_static bitor
// IMPORT-LABEL: ctjs.func @changing$
// IMPORT: ctjs.binary_static bitand
// IMPORT-LABEL: ctjs.func @reloaded$
// IMPORT: ctjs.binary_static bitor
// IMPORT-LABEL: ctjs.func @noncanonical$
// IMPORT: ctjs.binary_static bitor
// IMPORT-LABEL: ctjs.func @deep$
// IMPORT: ctjs.binary sub
// IMPORT: ctjs.binary_static bitor
// IMPORT: ctjs.binary_static shl
// IMPORT-LABEL: ctjs.func @originalKey$
// IMPORT: ctjs.binary_static bitand
// IMPORT-LABEL: ctjs.func @overflow$
// IMPORT: ctjs.binary_static ushr
// IMPORT-LABEL: ctjs.func @zeroStride$
// IMPORT: ctjs.binary_static bitxor
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 7 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 7 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 8 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 8 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 9 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 9 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 9 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 10 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 10 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 11 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 11 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 12 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 12 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 13 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 13 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 14 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 14 {{[0-9]+}} arr escapes:passed

//--- source.js
function savedAnd() {
    var child = {}, array = [child], inputs = [true], base = inputs[0], saved = 0;
    inputs[0] = child;
    for (var i = 0; i < array.length; i += base & 1) saved = array[i];
    return 0;
}
function savedOr() {
    var child = {}, array = [child], saved = 0, base = false;
    for (var i = 0; i < array.length; i += base | true) saved = array[i];
    return saved;
}
function savedXor() {
    var child = {}, array = [child], saved = 0, base = '-2';
    for (var i = 0; i < array.length; i += base ^ '-1') saved = array[i];
    return 0;
}
function maskedLeft() {
    var child = {}, array = [child], saved = 0, base = 1, count = 32;
    for (var i = 0; i < array.length; i += base << count) saved = array[i];
    return 0;
}
function signedRight() {
    var child = {}, array = [child], saved = 0, base = '-1', count = -1;
    for (var i = 0; i < array.length; i -= base >> count) saved = array[i];
    return saved;
}
function unsignedRight() {
    var child = {}, array = [child], saved = 0, base = '-1', count = -1;
    for (var i = 0; i < array.length; i += base >>> count) saved = array[i];
    return 0;
}
function nested() {
    var child = {}, array = [child], saved = 0, base = 1;
    for (var i = 0; i < array.length; i += (base - 0) | 0) saved = array[i];
    return 0;
}
function changing() {
    var child = {}, array = [child], saved = 0, base = 1;
    for (var i = 0; i < array.length; i += base & 1) {
        saved = array[i];
        base = base + 2;
    }
    return 0;
}
function reloaded() {
    var child = {}, array = [child], inputs = [1], saved = 0;
    for (var i = 0; i < array.length; i += inputs[0] | 0) saved = array[i];
    return 0;
}
function noncanonical() {
    var child = {}, array = [child], saved = 0, base = '01';
    for (var i = 0; i < array.length; i += base | 0) saved = array[i];
    return 0;
}
function deep() {
    var child = {}, array = [child], saved = 0, base = 1;
    for (var i = 0; i < array.length; i += ((base - 0) | 0) << 0) saved = array[i];
    return 0;
}
function originalKey() {
    var child = {}, array = [child], saved = 0, base = true;
    for (var i = 0; i < array.length; i += base & 1) saved = array[i];
    return array[base];
}
function overflow() {
    var child = {}, array = [child, child], saved = 0, base = -1;
    for (var i = 1; i < array.length; i += base >>> 0) saved = array[i];
    return 0;
}
function zeroStride() {
    var child = {}, array = [], saved = 0, base = 1;
    for (var i = 0; i < array.length; i += base ^ base) saved = array[i];
    return 0;
}
savedAnd();
var heldSavedOr = savedOr();
savedXor();
maskedLeft();
var heldSignedRight = signedRight();
unsignedRight();
nested();
changing();
reloaded();
noncanonical();
deep();
var heldOriginalKey = originalKey();
overflow();
zeroStride();
