// RUN: split-file %s %t
// RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/source.js | FileCheck %s --check-prefix=IMPORT
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name invariant-power-latch
// RUN: FileCheck %s --check-prefix=CLAIM < %t/escape-claims-invariant-power-latch.claims

// Bounded nested powers use unchanged original primitive operands. General powers,
// changing inputs, noncanonical conversions, zero strides and bounds refuse.
// IMPORT-LABEL: ctjs.func @savedPower$
// IMPORT: ctjs.binary pow
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @savedNegative$
// IMPORT: ctjs.binary pow
// IMPORT: ctjs.binary sub
// IMPORT-LABEL: ctjs.func @savedString$
// IMPORT: ctjs.binary pow
// IMPORT-LABEL: ctjs.func @zeroExponent$
// IMPORT: ctjs.binary pow
// IMPORT-LABEL: ctjs.func @changingExponent$
// IMPORT: ctjs.binary pow
// IMPORT-LABEL: ctjs.func @nested$
// IMPORT: ctjs.binary pow
// IMPORT: ctjs.binary pow
// IMPORT-LABEL: ctjs.func @general$
// IMPORT: ctjs.binary pow
// IMPORT-LABEL: ctjs.func @zeroStride$
// IMPORT: ctjs.binary pow
// IMPORT-LABEL: ctjs.func @noncanonical$
// IMPORT: ctjs.binary pow
// IMPORT-LABEL: ctjs.func @originalKey$
// IMPORT: ctjs.binary pow
// IMPORT-LABEL: ctjs.func @overflow$
// IMPORT: ctjs.binary pow
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 7 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 7 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 8 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 8 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 9 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 9 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 10 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 10 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 11 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 11 {{[0-9]+}} arr escapes:passed

//--- source.js
function savedPower() {
    var child = {}, array = [child], saved = 0, base = 2 - 1, exponent = true;
    for (var i = 0; i < array.length; i += base ** exponent) saved = array[i];
    return 0;
}
function savedNegative() {
    var child = {}, array = [child], saved = 0, base = -1, exponent = true;
    for (var i = 0; i < array.length; i -= base ** exponent) saved = array[i];
    return saved;
}
function savedString() {
    var child = {}, array = [child], inputs = ['-1'], base = inputs[0], saved = 0;
    inputs[0] = child;
    for (var i = 0; i < array.length; i -= base ** 3) saved = array[i];
    return 0;
}
function zeroExponent() {
    var child = {}, array = [child], saved = 0, base = null, exponent = false;
    for (var i = 0; i < array.length; i += base ** exponent) saved = array[i];
    return 0;
}
function changingExponent() {
    var child = {}, array = [child], saved = 0, exponent = 1;
    for (var i = 0; i < array.length; i += 1 ** exponent) {
        saved = array[i];
        exponent = exponent + 1;
    }
    return 0;
}
function nested() {
    var child = {}, array = [child], saved = 0, base = 1;
    for (var i = 0; i < array.length; i += (base ** true) ** true) saved = array[i];
    return 0;
}
function general() {
    var child = {}, array = [child], saved = 0, base = 2;
    for (var i = 0; i < array.length; i += base ** 2) saved = array[i];
    return 0;
}
function zeroStride() {
    var child = {}, array = [child], saved = 0, base = false;
    for (var i = 1; i < array.length; i += base ** true) saved = array[i];
    return 0;
}
function noncanonical() {
    var child = {}, array = [child], saved = 0, base = '01';
    for (var i = 0; i < array.length; i += base ** true) saved = array[i];
    return 0;
}
function originalKey() {
    var child = {}, array = [child], saved = 0, base = true;
    for (var i = 0; i < array.length; i += base ** 2) saved = array[i];
    return array[base];
}
function overflow() {
    var child = {}, array = [child, child], saved = 0, base = 4294967295;
    for (var i = 1; i < array.length; i += base ** true) saved = array[i];
    return 0;
}
savedPower();
var heldSavedNegative = savedNegative();
savedString();
zeroExponent();
changingExponent();
nested();
general();
zeroStride();
noncanonical();
var heldOriginalKey = originalKey();
overflow();
