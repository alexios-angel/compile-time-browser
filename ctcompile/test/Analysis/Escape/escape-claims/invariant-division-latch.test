// RUN: split-file %s %t
// RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/source.js | FileCheck %s --check-prefix=IMPORT
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name invariant-division-latch
// RUN: FileCheck %s --check-prefix=CLAIM < %t/escape-claims-invariant-division-latch.claims

// Nested exact quotients/remainders use unchanged original primitive operands.
// Zero divisors, fractional/zero strides, changing operands and bounds refuse.
// IMPORT-LABEL: ctjs.func @savedQuotient$
// IMPORT: ctjs.binary div
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @savedNegative$
// IMPORT: ctjs.binary div
// IMPORT: ctjs.binary sub
// IMPORT-LABEL: ctjs.func @savedRemainder$
// IMPORT: ctjs.binary mod
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @changingDivisor$
// IMPORT: ctjs.binary div
// IMPORT-LABEL: ctjs.func @nested$
// IMPORT: ctjs.binary div
// IMPORT: ctjs.binary div
// IMPORT-LABEL: ctjs.func @zeroDivisor$
// IMPORT: ctjs.binary div
// IMPORT-LABEL: ctjs.func @fractional$
// IMPORT: ctjs.binary div
// IMPORT-LABEL: ctjs.func @originalKey$
// IMPORT: ctjs.binary mod
// IMPORT-LABEL: ctjs.func @overflow$
// IMPORT: ctjs.binary div
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 7 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 7 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 8 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 8 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 9 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 9 {{[0-9]+}} arr escapes:passed

//--- source.js
function savedQuotient() {
    var child = {}, array = [child], saved = 0, step = 2 - 1, divisor = true;
    for (var i = 0; i < array.length; i += step / divisor) saved = array[i];
    return 0;
}
function savedNegative() {
    var child = {}, array = [child], saved = 0, step = -1, divisor = true;
    for (var i = 0; i < array.length; i -= step / divisor) saved = array[i];
    return saved;
}
function savedRemainder() {
    var child = {}, array = [child], inputs = ['3'], step = inputs[0], saved = 0;
    inputs[0] = child;
    for (var i = 0; i < array.length; i += step % 2) saved = array[i];
    return 0;
}
function changingDivisor() {
    var child = {}, array = [child], saved = 0, divisor = 1;
    for (var i = 0; i < array.length; i += 2 / divisor) {
        saved = array[i];
        divisor = divisor + 1;
    }
    return 0;
}
function nested() {
    var child = {}, array = [child], saved = 0, step = 1;
    for (var i = 0; i < array.length; i += (step / true) / true) saved = array[i];
    return 0;
}
function zeroDivisor() {
    var child = {}, array = [child], saved = 0, divisor = 0;
    for (var i = 1; i < array.length; i += 1 / divisor) saved = array[i];
    return 0;
}
function fractional() {
    var child = {}, array = [child], saved = 0, divisor = 2;
    for (var i = 0; i < array.length; i += 1 / divisor) saved = array[i];
    return 0;
}
function originalKey() {
    var child = {}, array = [child], saved = 0, step = true;
    for (var i = 0; i < array.length; i += step % 2) saved = array[i];
    return array[step];
}
function overflow() {
    var child = {}, array = [child, child], saved = 0, step = 4294967295;
    for (var i = 1; i < array.length; i += step / true) saved = array[i];
    return 0;
}
savedQuotient();
var heldSavedNegative = savedNegative();
savedRemainder();
changingDivisor();
nested();
zeroDivisor();
fractional();
var heldOriginalKey = originalKey();
overflow();
