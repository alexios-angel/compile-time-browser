//--- source.js
function snapshotReleased() {
    var child = {}, array = [child, child, child], seed = [1, 1, 1], saved = 0;
    var negative = 1 - seed.length;
    seed.length = 0;
    var step = negative - 1;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function snapshotReturned() {
    var child = {}, array = [child, child, child], seed = [1, 1, 1], saved = 0;
    var negative = 1 - seed.length;
    seed.length = 0;
    var step = negative - (0 - 1);
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return saved;
}
function positiveReleased() {
    var child = {}, array = [child, child, child], saved = 0;
    var negative = 1 - 3, step = (0 - 1) - negative;
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return 0;
}
function positiveReturned() {
    var child = {}, array = [child, child, child], saved = 0;
    var negative = 1 - 3, step = (0 - 1) - negative;
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return saved;
}
function zeroReleased() {
    var child = {}, array = [child, child, child], saved = 0;
    var negative = 1 - 3, start = negative - negative;
    for (var i = start; i < array.length; i++) {
        saved = array[i];
    }
    return 0;
}
function zeroReturned() {
    var child = {}, array = [child, child, child], saved = 0;
    var negative = 1 - 3, start = negative - negative;
    for (var i = start; i < array.length; i++) {
        saved = array[i];
    }
    return saved;
}
function coercibleRight() {
    var child = {}, array = [child, child, child], saved = 0;
    var negative = 1 - 3, step = negative - "1";
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function coercibleLeft() {
    var child = {}, array = [child, child, child], saved = 0;
    var step = "-2" - 1;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function stringSnapshotReleased() {
    var child = {}, array = [child, child], seed = [1], saved = 0;
    var length = seed.length;
    seed.length = 0;
    var step = length - "2";
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function stringSnapshotReturned() {
    var child = {}, array = [child, child], seed = [1], saved = 0;
    var length = seed.length;
    seed.length = 0;
    var step = length - "2";
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return saved;
}
function leftStringSnapshotReleased() {
    var child = {}, array = [child, child], seed = [1, 1], saved = 0;
    var length = seed.length;
    seed.length = 0;
    var step = "1" - length;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function leftStringSnapshotReturned() {
    var child = {}, array = [child, child], seed = [1, 1], saved = 0;
    var length = seed.length;
    seed.length = 0;
    var step = "1" - length;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return saved;
}
function bothStringsReleased() {
    var child = {}, array = [child, child], saved = 0;
    var step = "1" - "2";
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function bothStringsReturned() {
    var child = {}, array = [child, child], saved = 0;
    var step = "1" - "2";
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return saved;
}
snapshotReleased();
var snapshotRetained = snapshotReturned();
positiveReleased();
var positiveRetained = positiveReturned();
zeroReleased();
var zeroRetained = zeroReturned();
coercibleRight();
coercibleLeft();
stringSnapshotReleased();
var stringRetained = stringSnapshotReturned();
leftStringSnapshotReleased();
