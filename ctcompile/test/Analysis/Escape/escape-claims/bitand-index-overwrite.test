//--- source.js
function masked() {
    var child = {}, a = [child, child, 0, 0];
    for (var i = 0; i < a.length; i++) a[i & 1] = 0;
    return a;
}
function commuted() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[1 & i] = 0;
    return a;
}
function signedInput() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[-i & 1] = 0;
    return a;
}
function crossedInputBand() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(2147483647 + i) & 1] = 0;
    return a;
}
function composed() {
    var child = {}, a = [child, 0, child, 0];
    for (var i = 0; i < a.length; i++) a[(i & 1) * 2] = 0;
    return a;
}
function reload() {
    var child = {}, a = [child, child, 1, 0];
    for (var i = 0; i < a.length; i++) a[i & a[2]] = 0;
    return a;
}
function savedMask() {
    var child = {}, a = [child, child, 1, 0], mask = a[2];
    a[2] = 0;
    for (var i = 0; i < a.length; i++) a[i & mask] = 0;
    return a;
}
function savedChild() {
    var child = {}, a = [child, child], saved = a[0];
