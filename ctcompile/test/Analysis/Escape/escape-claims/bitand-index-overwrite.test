}
function varyingMask() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i & i] = 0;
    return a;
}
function unsignedMask() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i & 4294967295] = 0;
    return a;
}
function commutedNegativeMask() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[-1 & i] = 0;
    return a;
}
function negativeSignedComposition() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[~(~i & -1)] = 0;
    return a;
}
function highSignedComposition() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[((2147483648 + i) & -1) + 2147483648] = 0;
    return a;
}
function lowConversionBand() {
