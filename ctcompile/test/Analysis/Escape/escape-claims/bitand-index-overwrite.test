    for (var i = 0; i < a.length; i++) a[~i & -1] = 0;
    return a;
}
function signedReloadOverwrite() {
    var child = {}, a = [child, child, -2147483647, 0];
    for (var i = 0; i < a.length; i++) {
        a[i & a[2]] = 0;
