    for (var i = 0; i < a.length; i++) a[i & 0] = 0;
    return a;
}
function zeroTrip() {
    var child = {}, a = [child];
    for (var i = 1; i < a.length; i++) a[i & 0] = 0;
    return a;
}
function negativeMask() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i & -1] = 0;
    return a;
}
function fractionalMask() {
