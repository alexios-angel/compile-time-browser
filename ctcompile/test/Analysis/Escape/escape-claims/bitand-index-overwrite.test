    for (var i = 0; i < a.length; i++) a[((-4294967294 + i) & -1) - 2] = 0;
    return a;
}
function signedReload() {
    var child = {}, a = [child, child, -2147483647, 0];
    for (var i = 0; i < a.length; i++) a[i & a[2]] = 0;
    return a;
}
function savedSignedMask() {
    var child = {}, a = [child, child, -2147483647, 0], mask = a[2];
    a[2] = 0;
    for (var i = 0; i < a.length; i++) a[i & mask] = 0;
