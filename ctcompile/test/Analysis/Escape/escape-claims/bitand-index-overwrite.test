// RUN: split-file %s %t
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name bitand-index-overwrite
// RUN: FileCheck %s < %t/escape-claims-bitand-index-overwrite.claims

// CHECK: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 7 {{[0-9]+}} obj confined
// CHECK: escape {{[0-9a-f]+}} 8 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 9 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 10 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 11 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 12 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 13 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 14 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 15 {{[0-9]+}} obj escapes:stored
// CHECK: escape {{[0-9a-f]+}} 16 {{[0-9]+}} obj escapes:stored

//--- source.js
function masked() {
    var child = {}, a = [child, child, 0, 0];
    for (var i = 0; i < a.length; i++) a[i & 1] = 0;
    return a;
}
function commuted() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[1 & i] = 0;
    return a;
}
function signedInput() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[-i & 1] = 0;
    return a;
}
function crossedInputBand() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(2147483647 + i) & 1] = 0;
    return a;
}
function composed() {
    var child = {}, a = [child, 0, child, 0];
    for (var i = 0; i < a.length; i++) a[(i & 1) * 2] = 0;
    return a;
}
function reload() {
    var child = {}, a = [child, child, 1, 0];
    for (var i = 0; i < a.length; i++) a[i & a[2]] = 0;
    return a;
}
function savedMask() {
    var child = {}, a = [child, child, 1, 0], mask = a[2];
    a[2] = 0;
    for (var i = 0; i < a.length; i++) a[i & mask] = 0;
    return a;
}
function savedChild() {
    var child = {}, a = [child, child], saved = a[0];
    for (var i = 0; i < a.length; i++) a[i & 1] = 0;
    return saved;
}
function remainingGap() {
    var child = {}, a = [child, child, child, child];
    for (var i = 0; i < a.length; i++) a[i & 2] = 0;
    return a;
}
function zeroMask() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i & 0] = 0;
    return a;
}
function zeroTrip() {
    var child = {}, a = [child];
    for (var i = 1; i < a.length; i++) a[i & 0] = 0;
    return a;
}
function negativeMask() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i & -1] = 0;
    return a;
}
function fractionalMask() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i & 1.5] = 0;
    return a;
}
function stringMask() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i & "1"] = 0;
    return a;
}
function overwrittenReload() {
    var child = {}, a = [child, child, 1, 0];
    for (var i = 0; i < a.length; i++) {
        a[i & a[2]] = 0;
        a[2] = 0;
    }
    return a;
}
function varyingMask() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i & i] = 0;
    return a;
}
masked(); commuted(); signedInput(); crossedInputBand(); composed(); reload(); savedMask();
savedChild(); remainingGap(); zeroMask(); zeroTrip(); negativeMask(); fractionalMask(); stringMask();
overwrittenReload(); varyingMask();
