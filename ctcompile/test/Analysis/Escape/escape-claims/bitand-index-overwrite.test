    return saved;
}
function signedCrossZero() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[((i - 1) & -1) + 1] = 0;
    return a;
}
function signedCrossUpper() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[((2147483647 + i) & -1) & 1] = 0;
    return a;
}
function signedCrossLower() {
