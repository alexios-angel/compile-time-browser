// RUN: split-file %s %t
// RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/source.js | FileCheck %s --check-prefix=IMPORT
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name invariant-product-latch
// RUN: FileCheck %s --check-prefix=CLAIM < %t/escape-claims-invariant-product-latch.claims

// Nested products keep both original primitive snapshots. Changing operands,
// replacement, unknown conversion and final-index overflow refuse.
// IMPORT-LABEL: ctjs.func @savedProduct$
// IMPORT: ctjs.binary mul
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @savedNegative$
// IMPORT: ctjs.binary mul
// IMPORT: ctjs.binary sub
// IMPORT-LABEL: ctjs.func @savedString$
// IMPORT: ctjs.binary mul
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @changingLeft$
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @changingRight$
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @nested$
// IMPORT: ctjs.binary mul
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @unknown$
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @zero$
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @noncanonical$
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @originalKey$
// IMPORT: ctjs.binary mul
// IMPORT-LABEL: ctjs.func @overflow$
// IMPORT: ctjs.binary mul
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 7 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 7 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 8 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 8 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 9 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 9 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 10 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 10 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 11 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 11 {{[0-9]+}} arr escapes:passed

//--- source.js
function savedProduct() {
    var child = {}, array = [child], saved = 0, step = 2 - 1, factor = true;
    for (var i = 0; i < array.length; i += step * factor) saved = array[i];
    return 0;
}
function savedNegative() {
    var child = {}, array = [child], saved = 0, step = 2 - 1, factor = -1;
    for (var i = 0; i < array.length; i -= factor * step) saved = array[i];
    return saved;
}
function savedString() {
    var child = {}, array = [child], inputs = ['1'], step = inputs[0], saved = 0;
    inputs[0] = child;
    for (var i = 0; i < array.length; i += step * true) saved = array[i];
    return 0;
}
function changingLeft() {
    var child = {}, array = [child], saved = 0, step = 1;
    for (var i = 0; i < array.length; i += step * true) {
        saved = array[i];
        step = step + 1;
    }
    return 0;
}
function changingRight() {
    var child = {}, array = [child], saved = 0, step = 1;
    for (var i = 0; i < array.length; i += true * step) {
        saved = array[i];
        step = step + 1;
    }
    return 0;
}
function nested() {
    var child = {}, array = [child], saved = 0, step = 1;
    for (var i = 0; i < array.length; i += (step * true) * true) saved = array[i];
    return 0;
}
function unknown(step) {
    var child = {}, array = [child], saved = 0;
    for (var i = 0; i < array.length; i += step * true) saved = array[i];
    return 0;
}
function zero() {
    var child = {}, array = [child], saved = 0, step = 0;
    for (var i = 1; i < array.length; i += step * true) saved = array[i];
    return 0;
}
function noncanonical() {
    var child = {}, array = [child], saved = 0, step = '01';
    for (var i = 0; i < array.length; i += step * true) saved = array[i];
    return 0;
}
function originalKey() {
    var child = {}, array = [child], saved = 0, step = true;
    for (var i = 0; i < array.length; i += step * true) saved = array[i];
    return array[step];
}
function overflow() {
    var child = {}, array = [child, child], saved = 0, step = 4294967295;
    for (var i = 1; i < array.length; i += step * true) saved = array[i];
    return 0;
}
savedProduct();
var heldSavedNegative = savedNegative();
savedString();
changingLeft();
changingRight();
nested();
unknown(1);
zero();
noncanonical();
var heldOriginalKey = originalKey();
overflow();
