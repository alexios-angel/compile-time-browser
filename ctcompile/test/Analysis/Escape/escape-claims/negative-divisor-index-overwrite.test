//--- source.js
function unit() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[1 + i / -1] = 0;
    return a;
}
function signedZero() {
    var child = {}, a = [child, 0];
    for (var i = 0; i < a.length; i += 2) a[i / -2] = 0;
    return a;
}
function nonzeroStart() {
    var child = {}, a = [0, child, child, 0, 0, 0];
    for (var i = 2; i < a.length; i += 2) a[3 + i / -2] = 0;
    return a;
}
function signedIntermediate() {
    var child = {}, a = [child, child, child, 0, 0];
    for (var i = 0; i < a.length; i += 2) a[1 + (i - 2) / -2] = 0;
    return a;
}
function doubleNegative() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(i / -1) / -1] = 0;
    return a;
}
function negativeScaledDividend() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(i * -1) / -1] = 0;
    return a;
}
function gap() {
    var child = {}, a = [0, child, -2, child, 0];
    for (var i = 0; i < a.length; i += 4) a[3 + i / a[2]] = 0;
    return a;
}
function nestedReload() {
    var child = {}, a = [0, child, -2, child, 0, 2];
    for (var i = 0; i < a.length; i += 4) a[3 + i / a[a[5]]] = 0;
    return a;
}
function saved() {
    var child = {}, a = [child, child], saved = a[1];
    for (var i = 0; i < a.length; i++) a[1 + i / -1] = 0;
    return saved;
}
function remaining() {
    var child = {}, a = [child, child, child, 0];
    for (var i = 0; i < a.length; i += 2) a[2 + i / -2] = 0;
    return a;
}
function zeroTrip() {
    var child = {}, a = [child];
    for (var i = 1; i < a.length; i++) a[i / -1] = 0;
    return a;
}
function fractionalStart() {
    var child = {}, a = [child, child, 0, 0];
    for (var i = 1; i < a.length; i += 2) a[2 + i / -2] = 0;
    return a;
}
function fractionalStep() {
    var child = {}, a = [child, child, child];
    for (var i = 0; i < a.length; i++) a[1 + i / -2] = 0;
    return a;
}
function zeroDivisor() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[1 + i / 0] = 0;
    return a;
}
function negativeZeroDivisor() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[1 + i / -0] = 0;
    return a;
}
function stringDivisor() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[1 + i / "-1"] = 0;
    return a;
}
function fractionalDivisor() {
    var child = {}, a = [child, child, child];
    for (var i = 0; i < a.length; i++) a[2 + i / -0.5] = 0;
    return a;
}
function overlappingDivisor() {
    var child = {}, a = [0, child, 0, -2, 0];
    for (var i = 0; i < a.length; i += 4) a[3 + i / a[3]] = 0;
    return a;
}
function laterOverlap() {
    var child = {}, a = [0, child, -2, child, 0];
    for (var i = 0; i < a.length; i += 4) {
        a[3 + i / a[2]] = 0;
        a[2] = 0;
    }
    return a;
}
function negativePosition() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i / -1] = 0;
    return a;
}
function reversedOperands() {
    var child = {}, a = [child, child, child];
    for (var i = 0; i < a.length; i++) a[2 + -2 / i] = 0;
    return a;
}
function cycle() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) {
        a[1 + i / -1] = a;
        a[1 + i / -1] = 0;
    }
    return a;
}
function fractionalIntermediate() {
    var child = {}, a = [child, child, child];
    for (var i = 0; i < a.length; i++) a[2 + (i / -2) * 2] = 0;
    return a;
}
unit(); signedZero(); nonzeroStart(); signedIntermediate(); doubleNegative();
negativeScaledDividend(); gap(); nestedReload(); saved(); remaining(); zeroTrip();
fractionalStart(); fractionalStep(); zeroDivisor(); negativeZeroDivisor();
stringDivisor(); fractionalDivisor(); overlappingDivisor(); laterOverlap();
negativePosition(); reversedOperands(); cycle(); fractionalIntermediate();
