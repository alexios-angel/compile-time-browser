// RUN: split-file %s %t
// RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/source.js | FileCheck %s --check-prefix=IMPORT
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name primitive-unary
// RUN: FileCheck %s --check-prefix=CLAIM < %t/escape-claims-primitive-unary.claims

// Only unary results acquire Number facts; the source primitives keep their keys.
// IMPORT-LABEL: ctjs.func @plusReleased$
// IMPORT: ctjs.unary plus
// IMPORT-LABEL: ctjs.func @plusReturned$
// IMPORT: ctjs.unary plus
// IMPORT-LABEL: ctjs.func @negReleased$
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.unary neg
// IMPORT-LABEL: ctjs.func @negReturned$
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.unary neg
// IMPORT-LABEL: ctjs.func @bitnotReleased$
// IMPORT: ctjs.unary plus
// IMPORT: ctjs.unary bitnot
// IMPORT-LABEL: ctjs.func @bitnotReturned$
// IMPORT: ctjs.unary bitnot
// IMPORT-LABEL: ctjs.func @originalKey$
// IMPORT: ctjs.get_property
// IMPORT-LABEL: ctjs.func @unknownInput$
// IMPORT: ctjs.unary plus
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 7 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 7 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 8 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 8 {{[0-9]+}} arr escapes:passed

//--- source.js
function plusReleased() {
    var child = {}, array = [child, child, child], saved = 0, step = +true;
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return 0;
}
function plusReturned() {
    var child = {}, array = [child, child, child], saved = 0, step = +true;
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return saved;
}
function negReleased() {
    var child = {}, array = [child, child, child], saved = 0, start = -null, step = -true;
    for (var i = start; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function negReturned() {
    var child = {}, array = [child, child, child], saved = 0, start = -null, step = -true;
    for (var i = start; i < array.length; i -= step) {
        saved = array[i];
    }
    return saved;
}
function bitnotReleased() {
    var child = {}, array = [child, child, child], saved = 0, start = +false, step = ~false;
    for (var i = start; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function bitnotReturned() {
    var child = {}, array = [child, child, child], saved = 0, step = ~null;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return saved;
}
function originalKey() {
    var child = {}, array = [child], saved = array[null];
    return 0;
}
function unknownInput(input) {
    var child = {}, array = [child, child, child], saved = 0, step = +input;
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return 0;
}
plusReleased();
var plusRetained = plusReturned();
negReleased();
var negRetained = negReturned();
bitnotReleased();
var bitnotRetained = bitnotReturned();
originalKey();
unknownInput(true);
