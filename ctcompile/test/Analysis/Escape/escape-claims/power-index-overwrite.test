// RUN: split-file %s %t
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name power-index-overwrite
// RUN: FileCheck %s < %t/escape-claims-power-index-overwrite.claims

// Zero/unit exponents preserve each source operation, actual writes and snapshots.
// Reloads must be disjoint from every write; general powers remain unproved.
