//--- source.js
function unit() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i ** 1] = 0;
    return a;
}
function stringUnit() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i ** "1"] = 0;
    return a;
}
function zero() {
    var child = {}, a = [0, child];
    for (var i = 0; i < a.length; i++) a[i ** 0] = 0;
    return a;
}
function nullZero() {
    var child = {}, a = [0, child];
    for (var i = 0; i < a.length; i++) a[i ** null] = 0;
    return a;
}
function signedBase() {
    var child = {}, a = [child, child, child];
    for (var i = 0; i < a.length; i++) a[2 + (-i) ** 1] = 0;
    return a;
}
function gappedUnit() {
    var child = {}, a = [child, 0, child];
    for (var i = 0; i < a.length; i += 2) a[i ** 1] = 0;
    return a;
}
function reloadedZero() {
    var child = {}, a = [0, child];
    for (var i = 0; i < a.length; i++) a[i ** a[0]] = 0;
    return a;
}
function reloadedUnitGap() {
    var child = {}, a = [child, 1, child];
    for (var i = 0; i < a.length; i += 2) a[i ** a[1]] = 0;
    return a;
}
function retainedZero() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i ** 0] = 0;
    return a;
}
function saved() {
    var child = {}, a = [child, child], saved = a[1];
    for (var i = 0; i < a.length; i++) a[i ** 1] = 0;
    return saved;
}
function laterStore() {
    var child = {}, a = [0, child, child];
    for (var i = 0; i < a.length; i++) {
        a[i ** a[0]] = 0;
        a[0] = 1;
    }
    return a;
}
function overlappingExponent() {
    var child = {}, a = [1, child];
    for (var i = 0; i < a.length; i++) a[i ** a[0]] = 0;
    return a;
}
function nonunitExponent() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i ** 2] = 0;
    return a;
}
function changingExponent() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i ** i] = 0;
    return a;
}
function reversedOperands() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[1 ** i] = 0;
    return a;
}
function noncanonicalExponent() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i ** "01"] = 0;
    return a;
}
function undefinedExponent() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i ** undefined] = 0;
    return a;
}
unit(); stringUnit(); zero(); nullZero(); signedBase(); gappedUnit();
reloadedZero(); reloadedUnitGap(); retainedZero(); saved(); laterStore();
overlappingExponent(); nonunitExponent(); changingExponent(); reversedOperands();
noncanonicalExponent(); undefinedExponent();

function unitBase() {
    var child = {}, a = [0, child];
    for (var i = 0; i < a.length; i++) a[1 ** i] = 0;
    return a;
}
function stringBase() {
    var child = {}, a = [0, child];
    for (var i = 0; i < a.length; i++) a["1" ** i] = 0;
    return a;
}
function booleanBase() {
    var child = {}, a = [0, child];
    for (var i = 0; i < a.length; i++) a[true ** i] = 0;
    return a;
}
function negativeExponent() {
    var child = {}, a = [0, child];
    for (var i = 0; i < a.length; i++) a[1 ** (-i)] = 0;
    return a;
}
function crossingExponent() {
    var child = {}, a = [0, child, 0];
    for (var i = 0; i < a.length; i++) a[1 ** (i - 1)] = 0;
    return a;
}
function reloadedUnitBase() {
    var child = {}, a = [1, child];
    for (var i = 0; i < a.length; i++) a[a[0] ** i] = 0;
    return a;
}
function laterBaseStore() {
    var child = {}, a = [1, child, child];
    for (var i = 0; i < a.length; i++) {
        a[a[0] ** i] = 0;
        a[0] = 0;
    }
    return a;
}
function overlappingBase() {
    var child = {}, a = [0, 1, child];
    for (var i = 0; i < a.length; i++) a[a[1] ** i] = 0;
    return a;
}
function savedUnitBase() {
    var child = {}, a = [0, child], saved = a[1];
    for (var i = 0; i < a.length; i++) a[1 ** i] = 0;
    return saved;
}
function zeroBase() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[0 ** i] = 0;
    return a;
}
unitBase(); stringBase(); booleanBase(); negativeExponent(); crossingExponent();
reloadedUnitBase(); laterBaseStore(); overlappingBase(); savedUnitBase(); zeroBase();

function falseBase() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[false ** i] = 0;
    return a;
}
function nullBase() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[null ** i] = 0;
    return a;
}
function zeroStringBase() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a["0" ** i] = 0;
    return a;
}
function negativeZeroBase() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(-0) ** i] = 0;
    return a;
}
function reloadedZeroBase() {
    var child = {}, a = [child, child, 0];
    for (var i = 0; i < a.length; i++) a[a[2] ** i] = 0;
    return a;
}
function positiveZeroBase() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[0 ** (i + 1)] = 0;
    return a;
}
function savedZeroBase() {
    var child = {}, a = [child, child], saved = a[1];
    for (var i = 0; i < a.length; i++) a[0 ** i] = 0;
    return saved;
}
function laterZeroBaseStore() {
    var child = {}, a = [child, child, 0];
    for (var i = 0; i < a.length; i++) {
        a[a[2] ** i] = 0;
        a[2] = 1;
    }
    return a;
}
function overlappingZeroBase() {
    var child = {}, a = [0, child];
    for (var i = 0; i < a.length; i++) a[a[0] ** i] = 0;
    return a;
}
function negativeZeroExponent() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[0 ** (i - 1)] = 0;
    return a;
}
function growingZeroBase() {
    var child = {}, a = [child];
    for (var i = 0; i < a.length; i++) a[0 ** i] = 0;
    return a;
}
function descendingZeroExponent() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[0 ** (1 - i)] = 0;
    return a;
}
function nonzeroZeroBaseStart() {
    var child = {}, a = [child, 0];
    for (var i = 1; i < a.length; i++) a[0 ** i] = 0;
    return a;
}
falseBase(); nullBase(); zeroStringBase(); negativeZeroBase(); reloadedZeroBase();
positiveZeroBase(); savedZeroBase(); laterZeroBaseStore(); overlappingZeroBase();
negativeZeroExponent(); growingZeroBase(); descendingZeroExponent(); nonzeroZeroBaseStart();

function negativeUnitParity() {
    var child = {}, a = [child, 0, child];
    for (var i = 0; i < a.length; i++) a[1 + (-1) ** i] = 0;
    return a;
}
function negativeStringParity() {
    var child = {}, a = [child, 0, child];
    for (var i = 0; i < a.length; i++) a[1 + "-1" ** i] = 0;
    return a;
}
function negativeExponentParity() {
    var child = {}, a = [child, 0, child];
    for (var i = 0; i < a.length; i++) a[1 + (-1) ** (-i)] = 0;
    return a;
}
function evenExponentParity() {
    var child = {}, a = [0, 0, child];
    for (var i = 0; i < a.length; i++) a[1 + (-1) ** (2 * i)] = 0;
    return a;
}
function oddExponentParity() {
    var child = {}, a = [child, 0, 0];
    for (var i = 0; i < a.length; i++) a[1 + (-1) ** (2 * i + 1)] = 0;
    return a;
}
function singletonExponentParity() {
    var child = {}, a = [child, 0];
    for (var i = 1; i < a.length; i++) a[1 + (-1) ** i] = 0;
    return a;
}
function reloadedParityBase() {
    var child = {}, a = [child, -1, child];
    for (var i = 0; i < a.length; i++) a[1 + a[1] ** i] = 0;
    return a;
}
function retainedParityChild() {
    var child = {}, a = [child, 0, child];
    for (var i = 0; i < a.length; i += 2) a[1 + (-1) ** i] = 0;
    return a;
}
function laterParityBaseStore() {
    var child = {}, a = [child, -1, child];
    for (var i = 0; i < a.length; i++) {
        a[1 + a[1] ** i] = 0;
        a[1] = 0;
    }
    return a;
}
function overlappingParityBase() {
    var child = {}, a = [-1, 0, child];
    for (var i = 0; i < a.length; i++) a[1 + a[0] ** i] = 0;
    return a;
}
function negativeParityKey() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(-1) ** i] = 0;
    return a;
}
function fractionalParityExponent() {
    var child = {}, a = [child, 0, child];
    for (var i = 0; i < a.length; i++) a[1 + (-1) ** (i / 2)] = 0;
    return a;
}
function growingParityKey() {
    var child = {}, a = [child, 0];
    for (var i = 0; i < a.length; i++) a[1 + (-1) ** i] = 0;
    return a;
}
negativeUnitParity(); negativeStringParity(); negativeExponentParity(); evenExponentParity();
oddExponentParity(); singletonExponentParity(); reloadedParityBase(); retainedParityChild();
laterParityBaseStore(); overlappingParityBase(); negativeParityKey(); fractionalParityExponent();
growingParityKey();
