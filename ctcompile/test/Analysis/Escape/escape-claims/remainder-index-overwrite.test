//--- source.js
function wrapped() {
    var child = {}, a = [child, child, 0, 0];
    for (var i = 0; i < a.length; i++) a[i % 2] = 0;
    return a;
}
function noWrap() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i % 3] = 0;
    return a;
}
function composed() {
    var child = {}, a = [child, 0, child, 0];
    for (var i = 0; i < a.length; i++) a[(i % 2) * 2] = 0;
    return a;
}
function offsetInput() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(i + 3) % 2] = 0;
    return a;
}
function descendingInput() {
    var child = {}, a = [child, child, 0, 0];
    for (var i = 0; i < a.length; i++) a[(3 - i) % 2] = 0;
    return a;
}
function reload() {
    var child = {}, a = [child, child, 2, 0];
    for (var i = 0; i < a.length; i++) a[i % a[2]] = 0;
    return a;
}
function savedDivisor() {
    var child = {}, a = [child, child, 2, 0], divisor = a[2];
    a[2] = 0;
    for (var i = 0; i < a.length; i++) a[i % divisor] = 0;
    return a;
}
function savedChild() {
    var child = {}, a = [child, child], saved = a[0];
    for (var i = 0; i < a.length; i++) a[i % 2] = 0;
    return saved;
}
function remainingGap() {
    var child = {}, a = [child, child, child, child];
    for (var i = 0; i < a.length; i++) a[i % 2] = 0;
    return a;
}
function zeroTrip() {
    var child = {}, a = [child];
    for (var i = 1; i < a.length; i++) a[i % 2] = 0;
    return a;
}
function zeroDivisor() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i % 0] = 0;
    return a;
}
function negativeDivisor() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i % -2] = 0;
    return a;
}
function fractionalDivisor() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i % 1.5] = 0;
    return a;
}
function stringDivisor() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i % "2"] = 0;
    return a;
}
function varyingDivisor() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i % (i + 1)] = 0;
    return a;
}
function negativeDividend() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(-i) % 2 + 1] = 0;
    return a;
}
function overwrittenReload() {
    var child = {}, a = [child, child, 2, 0];
    for (var i = 0; i < a.length; i++) {
        a[i % a[2]] = 0;
        a[2] = 0;
    }
    return a;
}
function overlappingReload() {
    var child = {}, a = [2, child, 0, 0];
    for (var i = 0; i < a.length; i++) a[i % a[0]] = 0;
    return a;
}
function interiorReload() {
    var child = {}, a = [2, child, child, 0];
    for (var i = 0; i < a.length; i++) a[(1 + i) % a[0]] = 0;
    return a;
}
function unprovedDividend() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(4294967295 + i) % 2] = 0;
    return a;
}
function negativeZero() {
    var child = {}, a = [child, child];
    for (var i = -0; i < a.length; i++) a[i % 2] = 0;
    return a;
}
function negatedRemainder() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[-((-i) % 2)] = 0;
    return a;
}
function bothNegative() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(-i) % -2 + 1] = 0;
    return a;
}
function crossingZero() {
    var child = {}, a = [child, child, child, 0];
    for (var i = 0; i < a.length; i++) a[(i - 1) % 2 + 1] = 0;
    return a;
}
function signedReload() {
    var child = {}, a = [child, child, -2, 0];
    for (var i = 0; i < a.length; i++) a[(-i) % a[2] + 1] = 0;
    return a;
}
function savedNegativeDivisor() {
    var child = {}, a = [child, child, -2, 0], divisor = a[2];
    a[2] = 0;
    for (var i = 0; i < a.length; i++) a[(-i) % divisor + 1] = 0;
    return a;
}
function offsetNegative() {
    var child = {}, a = [child, child, 0, 0];
    for (var i = 0; i < a.length; i++) a[(-i - 3) % 2 + 1] = 0;
    return a;
}
function signedSavedChild() {
    var child = {}, a = [child, child], saved = a[0];
    for (var i = 0; i < a.length; i++) a[(-i) % -2 + 1] = 0;
    return saved;
}
function negativeFinalIndex() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(-i) % 2] = 0;
    return a;
}
function signedInteriorReload() {
    var child = {}, a = [child, 2, child, 0];
    for (var i = 0; i < a.length; i++) a[(i - 1) % a[1] + 1] = 0;
    return a;
}
function signedLaterWrite() {
    var child = {}, a = [child, child, -2, 0];
    for (var i = 0; i < a.length; i++) {
        a[(-i) % a[2] + 1] = 0;
        a[2] = 0;
    }
    return a;
}
function negativeZeroDivisor() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(-i) % -0 + 1] = 0;
    return a;
}
function negativeStringDivisor() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[(-i) % "-2" + 1] = 0;
    return a;
}
wrapped(); noWrap(); composed(); offsetInput(); descendingInput(); reload(); savedDivisor();
savedChild(); remainingGap(); zeroTrip(); zeroDivisor(); negativeDivisor(); fractionalDivisor();
stringDivisor(); varyingDivisor(); negativeDividend(); overwrittenReload(); overlappingReload();
interiorReload(); unprovedDividend(); negativeZero();
negatedRemainder(); bothNegative(); crossingZero(); signedReload(); savedNegativeDivisor();
offsetNegative(); signedSavedChild(); negativeFinalIndex(); signedInteriorReload();
signedLaterWrite(); negativeZeroDivisor(); negativeStringDivisor();
