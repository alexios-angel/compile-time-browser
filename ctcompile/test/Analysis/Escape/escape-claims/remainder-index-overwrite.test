function wrapped() {
    var child = {}, a = [child, child, 0, 0];
    for (var i = 0; i < a.length; i++) a[i % 2] = 0;
    return a;
}
function noWrap() {
    var child = {}, a = [child, child];
    for (var i = 0; i < a.length; i++) a[i % 3] = 0;
    return a;
}
function composed() {
    var child = {}, a = [child, 0, child, 0];
    for (var i = 0; i < a.length; i++) a[(i % 2) * 2] = 0;
    return a;
}
