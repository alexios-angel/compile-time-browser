// RUN: split-file %s %t
// RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/source.js | FileCheck %s --check-prefix=IMPORT
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name negated-guard
// RUN: FileCheck %s --check-prefix=CLAIM < %t/escape-claims-negated-guard.claims

// Keep the comparison operands and logical negation in the imported source.
// Both finite forms retain returned children; negating a strict comparison
// remains an inclusive bound, outside the proof even when the child dies here.
// IMPORT-LABEL: ctjs.func @released$
// IMPORT: ctjs.compare ge
// IMPORT: ctjs.unary not
// IMPORT-LABEL: ctjs.func @returned$
// IMPORT: ctjs.compare ge
// IMPORT: ctjs.unary not
// IMPORT-LABEL: ctjs.func @reversedReleased$
// IMPORT: ctjs.compare le
// IMPORT: ctjs.unary not
// IMPORT-LABEL: ctjs.func @reversedReturned$
// IMPORT: ctjs.compare le
// IMPORT: ctjs.unary not
// IMPORT-LABEL: ctjs.func @inclusive$
// IMPORT: ctjs.compare gt
// IMPORT: ctjs.unary not
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} arr escapes:passed

//--- source.js
function released() {
    var child = {}, array = [child], saved = 0;
    for (var i = 0; !(i >= array.length); i++) {
        saved = array[i];
    }
    return 0;
}
function returned() {
    var child = {}, array = [child], saved = 0;
    for (var i = 0; !(i >= array.length); i++) {
        saved = array[i];
    }
    return saved;
}
function reversedReleased() {
    var child = {}, array = [child], saved = 0;
    for (var i = 0; !(array.length <= i); i++) {
        saved = array[i];
    }
    return 0;
}
function reversedReturned() {
    var child = {}, array = [child], saved = 0;
    for (var i = 0; !(array.length <= i); i++) {
        saved = array[i];
    }
    return saved;
}
function inclusive() {
    var child = {}, array = [child], saved = 0;
    for (var i = 0; !(i > array.length); i++) {
        saved = array[i];
    }
    return 0;
}
released();
var retained = returned();
reversedReleased();
var reversedRetained = reversedReturned();
inclusive();
