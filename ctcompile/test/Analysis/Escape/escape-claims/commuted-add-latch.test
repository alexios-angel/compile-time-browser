// RUN: split-file %s %t
// RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/source.js | FileCheck %s --check-prefix=IMPORT
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name commuted-add-latch
// RUN: FileCheck %s --check-prefix=CLAIM < %t/escape-claims-commuted-add-latch.claims

// The original Add order survives import. Number strides retain returned
// children and discharge only unreturned children. A String stride still
// executes here, but cannot borrow the numeric induction certificate.
// IMPORT-LABEL: ctjs.func @released$
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @returned$
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @carriedReleased$
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @carriedReturned$
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @coercible$
// IMPORT: ctjs.binary add
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} arr escapes:passed

//--- source.js
function released() {
    var child = {}, array = [child], saved = 0;
    for (var i = 0; i < array.length; i = 1 + i) {
        saved = array[i];
    }
    return 0;
}
function returned() {
    var child = {}, array = [child], saved = 0;
    for (var i = 0; i < array.length; i = 1 + i) {
        saved = array[i];
    }
    return saved;
}
function carriedReleased() {
    var child = {}, array = [child, child, child], saved = 0, step = 2;
    for (var i = 0; !(array.length <= i); i = step + i) {
        saved = array[i];
    }
    return 0;
}
function carriedReturned() {
    var child = {}, array = [child, child, child], saved = 0, step = 2;
    for (var i = 0; !(array.length <= i); i = step + i) {
        saved = array[i];
    }
    return saved;
}
function coercible() {
    var child = {}, array = [child], saved = 0;
    for (var i = 0; i < array.length; i = "1" + i) {
        saved = array[i];
    }
    return 0;
}
released();
var retained = returned();
carriedReleased();
var carriedRetained = carriedReturned();
coercible();
