// RUN: split-file %s %t
// RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/source.js | FileCheck %s --check-prefix=IMPORT
// RUN: python3 %S/check.py --oracle ctcompile-test-type-oracle --claims ctcompile-test-escape-claims --script %{monorepo}/tools/check/escape-oracle.py --corpus %t/source.js --work %t --name signed-unary
// RUN: FileCheck %s --check-prefix=CLAIM < %t/escape-claims-signed-unary.claims

// Plus preserves a held negative Number; a second Neg restores its magnitude.
// Saved values survive source mutation. Coercible String inputs prove neither.
// IMPORT-LABEL: ctjs.func @plusReleased$
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.unary plus
// IMPORT: ctjs.binary sub
// IMPORT-LABEL: ctjs.func @plusReturned$
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.unary plus
// IMPORT: ctjs.binary sub
// IMPORT-LABEL: ctjs.func @doubleNegReleased$
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @doubleNegReturned$
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.binary add
// IMPORT-LABEL: ctjs.func @coerciblePlus$
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.unary plus
// IMPORT: ctjs.binary sub
// IMPORT-LABEL: ctjs.func @coercibleNeg$
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.unary neg
// IMPORT: ctjs.binary add
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 1 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 2 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} obj confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 3 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 4 {{[0-9]+}} arr confined
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 5 {{[0-9]+}} arr escapes:passed
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} obj escapes:stored
// CLAIM: escape {{[0-9a-f]+}} 6 {{[0-9]+}} arr escapes:passed

//--- source.js
function plusReleased() {
    var child = {}, array = [child, child, child], saved = 0;
    var magnitude = 1 + 1, negative = -magnitude, step = +negative;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function plusReturned() {
    var child = {}, array = [child, child, child], saved = 0;
    var magnitude = 1 + 1, negative = -magnitude, step = +negative;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return saved;
}
function doubleNegReleased() {
    var child = {}, array = [child, child, child], saved = 0, seed = [1, 1];
    var magnitude = seed.length, negative = -magnitude;
    seed.length = 0;
    var step = -negative;
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return 0;
}
function doubleNegReturned() {
    var child = {}, array = [child, child, child], saved = 0, seed = [1, 1];
    var magnitude = seed.length, negative = -magnitude;
    seed.length = 0;
    var step = -negative;
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return saved;
}
function coerciblePlus() {
    var child = {}, array = [child, child, child], saved = 0, magnitude = "2";
    var negative = -magnitude, step = +negative;
    for (var i = 0; i < array.length; i -= step) {
        saved = array[i];
    }
    return 0;
}
function coercibleNeg() {
    var child = {}, array = [child, child, child], saved = 0, magnitude = "2";
    var negative = -magnitude, step = -negative;
    for (var i = 0; i < array.length; i += step) {
        saved = array[i];
    }
    return 0;
}
plusReleased();
var plusRetained = plusReturned();
doubleNegReleased();
var doubleNegRetained = doubleNegReturned();
coerciblePlus();
coercibleNeg();
