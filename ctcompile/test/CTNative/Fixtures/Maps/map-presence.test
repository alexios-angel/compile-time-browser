# THE NATIVE GATE OVER map-presence.js. The modules are the build's: Native.cmake's
# ctcompile_add_native_pipeline lowers this program through the closed world,
# the lift and the lowering (refusing to write a module while any function
# carries `ctnative.not_native`), then applies the printing policy and its
# mutation. Each is gated here: compiled standalone with no ctbrowser library,
# shown by nm to reach no interpreter, run, and compared global by global with
# the interpreter's own answer (compilation-unit.py); compiled clean on both
# toolchains with a provenance comment over every definition (compile-clean.py);
# and the printed pins paired, spelling-only, and shown to bite (print-deduced.py).
# A trailing global on a RUN line under `not` is the off-by-one negative proof:
# the mutation must fail naming that global, so the gate's teeth stay in the suite.

# Conditional has/set/get follows must-presence and erasure effects.
# RUN: %compilation_unit --module %{obj}/map_presence.pipeline.emitc.mlir --js %S/map-presence.js --work %t --name map_presence
# RUN: not %compilation_unit --module %{obj}/map_presence.pipeline.emitc.mlir --js %S/map-presence.js --work %t --name map_presence_off_by_one --mutate lifetime42 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# OFF-BY-ONE: global 'lifetime42' differs
# RUN: %compilation_unit --module %{obj}/map_presence.pipeline.deduced.emitc.mlir --js %S/map-presence.js --work %t --name map_presence_deduced
# RUN: %compile_clean --module %{obj}/map_presence.pipeline.emitc.mlir --work %t --name map_presence
# RUN: %compile_clean --module %{obj}/map_presence.pipeline.deduced.emitc.mlir --work %t --name map_presence_deduced
# RUN: %print_deduced --plain %{obj}/map_presence.pipeline.emitc.mlir --deduced %{obj}/map_presence.pipeline.deduced.emitc.mlir --mutated %{obj}/map_presence.pipeline.mutated.emitc.mlir --work %t --name map_presence
