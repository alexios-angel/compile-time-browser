# Native differential test of globals.js. The modules come from
# ctcompile_add_native_pipeline in Native.cmake, which lowers the program to
# native C++ (writing no module while any function carries `ctnative.not_native`)
# plus a variant printed with deduced `auto` types and one with a wrong type pin.
# compilation-unit.py compiles a module standalone, checks with nm that it calls
# no interpreter, runs it, and compares every global with the interpreter's.
# compile-clean.py checks a warning-free build on both toolchains with a
# provenance comment over every definition. print-deduced.py checks that the
# deduced module differs only in type spellings and that the wrong pin fails.
# A `not ... --mutate G` line adds one to global G in the C++ and expects the
# comparison to fail naming G, proving the comparison can catch a difference.

# Number and boolean globals, with no functions.
# RUN: %compilation_unit --module %{obj}/numeric.pipeline.emitc.mlir --js %S/globals.js --work %t --name numeric
# RUN: not %compilation_unit --module %{obj}/numeric.pipeline.emitc.mlir --js %S/globals.js --work %t --name numeric_off_by_one --mutate total 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# OFF-BY-ONE: global 'total' differs
# RUN: %compilation_unit --module %{obj}/numeric.pipeline.deduced.emitc.mlir --js %S/globals.js --work %t --name numeric_deduced
# RUN: %compile_clean --module %{obj}/numeric.pipeline.emitc.mlir --work %t --name numeric
# RUN: %compile_clean --module %{obj}/numeric.pipeline.deduced.emitc.mlir --work %t --name numeric_deduced
# RUN: %print_deduced --plain %{obj}/numeric.pipeline.emitc.mlir --deduced %{obj}/numeric.pipeline.deduced.emitc.mlir --mutated %{obj}/numeric.pipeline.mutated.emitc.mlir --work %t --name numeric
