# Native differential test of argument.js. The modules come from
# ctcompile_add_native_pipeline in Native.cmake, which lowers the program to
# native C++ (writing no module while any function carries `ctnative.not_native`)
# plus a variant printed with deduced `auto` types and one with a wrong type pin.
# compilation-unit.py compiles a module standalone, checks with nm that it calls
# no interpreter, runs it, and compares every global with the interpreter's.
# compile-clean.py checks a warning-free build on both toolchains with a
# provenance comment over every definition. print-deduced.py checks that the
# deduced module differs only in type spellings and that the wrong pin fails.
# A `not ... --mutate G` line adds one to global G in the C++ and expects the
# comparison to fail naming G, proving the comparison can catch a difference.

# An argument is a parameter too.
# RUN: %compilation_unit --module %{obj}/object_arguments.pipeline.emitc.mlir --js %S/argument.js --work %t --name object_arguments
# RUN: %compilation_unit --module %{obj}/object_arguments.pipeline.deduced.emitc.mlir --js %S/argument.js --work %t --name object_arguments_deduced
# RUN: %compile_clean --module %{obj}/object_arguments.pipeline.emitc.mlir --work %t --name object_arguments
# RUN: %compile_clean --module %{obj}/object_arguments.pipeline.deduced.emitc.mlir --work %t --name object_arguments_deduced
# RUN: %print_deduced --plain %{obj}/object_arguments.pipeline.emitc.mlir --deduced %{obj}/object_arguments.pipeline.deduced.emitc.mlir --mutated %{obj}/object_arguments.pipeline.mutated.emitc.mlir --work %t --name object_arguments
