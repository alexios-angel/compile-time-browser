# Differential test of array-sort.js: each sort with a comparator calls its
# specialised comparator through the runtime, as
# `ctnative::Array.prototype.sort.call(a, comparator)`, and the runtime's merge
# sort calls it in the interpreter's order. The C++ is compiled against public
# Core, checked for interpreter symbols with nm, run, and every global
# compared with the interpreter's (compilation-unit.py). The negative changes
# the printed String `ascending` and requires the comparison to fail naming
# it. compile-clean.py checks a warning-free build on both toolchains.
# string-arrays-calls.py is the generic pipeline driver for a fixture that is
# not registered in NativeFixtures.cmake.

# RUN: python3 %S/string-arrays-calls.py --translate ctjs-translate --opt ctjs-opt --js %S/array-sort.js --out %t/array-sort.emitc.mlir
# RUN: ctjs-translate --mlir-to-cpp %t/array-sort.emitc.mlir | FileCheck %s
# RUN: %compilation_unit --module %t/array-sort.emitc.mlir --js %S/array-sort.js --work %t --name array_sort --core-build %build
# RUN: not %compilation_unit --module %t/array-sort.emitc.mlir --js %S/array-sort.js --work %t --name array_sort_negative --core-build %build --mutate ascending --mutate-as string 2>&1 | FileCheck %s --check-prefix=NEGATIVE
# RUN: %compile_clean --module %t/array-sort.emitc.mlir --work %t --name array_sort

# CHECK: ctnative::Array.prototype.sort.call(
# NEGATIVE: global 'ascending' differs
