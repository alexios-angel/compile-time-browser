# Native differential test of read-overwrite.js. The modules come from
# ctcompile_add_native_pipeline in Native.cmake, which lowers the program to
# native C++ (writing no module while any function carries `ctnative.not_native`)
# plus a variant printed with deduced `auto` types and one with a wrong type pin.
# compilation-unit.py compiles a module standalone, checks with nm that it calls
# no interpreter, runs it, and compares every global with the interpreter's.
# compile-clean.py checks a warning-free build on both toolchains with a
# provenance comment over every definition. print-deduced.py checks that the
# deduced module differs only in type spellings and that the wrong pin fails.
# A `not ... --mutate G` line adds one to global G in the C++ and expects the
# comparison to fail naming G, proving the comparison can catch a difference.

# Built with the default optimizations.
# RUN: %compilation_unit --module %{obj}/array_read_overwrite.pipeline.emitc.mlir --js %S/read-overwrite.js --work %t --name array_read_overwrite
# RUN: not %compilation_unit --module %{obj}/array_read_overwrite.pipeline.emitc.mlir --js %S/read-overwrite.js --work %t --name array_read_overwrite_off_by_one --mutate value 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# OFF-BY-ONE: global 'value' differs
# RUN: %compilation_unit --module %{obj}/array_read_overwrite.pipeline.deduced.emitc.mlir --js %S/read-overwrite.js --work %t --name array_read_overwrite_deduced
# RUN: %compile_clean --module %{obj}/array_read_overwrite.pipeline.emitc.mlir --work %t --name array_read_overwrite
# RUN: %compile_clean --module %{obj}/array_read_overwrite.pipeline.deduced.emitc.mlir --work %t --name array_read_overwrite_deduced
# RUN: %print_deduced --plain %{obj}/array_read_overwrite.pipeline.emitc.mlir --deduced %{obj}/array_read_overwrite.pipeline.deduced.emitc.mlir --mutated %{obj}/array_read_overwrite.pipeline.mutated.emitc.mlir --work %t --name array_read_overwrite

# The same program built with NO_DEFAULT_OPTIMIZATIONS.
# RUN: %compilation_unit --module %{obj}/array_read_overwrite_unoptimized.pipeline.emitc.mlir --js %S/read-overwrite.js --work %t --name array_read_overwrite_unoptimized
# RUN: not %compilation_unit --module %{obj}/array_read_overwrite_unoptimized.pipeline.emitc.mlir --js %S/read-overwrite.js --work %t --name array_read_overwrite_unoptimized_off_by_one --mutate value 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# RUN: %compilation_unit --module %{obj}/array_read_overwrite_unoptimized.pipeline.deduced.emitc.mlir --js %S/read-overwrite.js --work %t --name array_read_overwrite_unoptimized_deduced
# RUN: %compile_clean --module %{obj}/array_read_overwrite_unoptimized.pipeline.emitc.mlir --work %t --name array_read_overwrite_unoptimized
# RUN: %compile_clean --module %{obj}/array_read_overwrite_unoptimized.pipeline.deduced.emitc.mlir --work %t --name array_read_overwrite_unoptimized_deduced
# RUN: %print_deduced --plain %{obj}/array_read_overwrite_unoptimized.pipeline.emitc.mlir --deduced %{obj}/array_read_overwrite_unoptimized.pipeline.deduced.emitc.mlir --mutated %{obj}/array_read_overwrite_unoptimized.pipeline.mutated.emitc.mlir --work %t --name array_read_overwrite_unoptimized
