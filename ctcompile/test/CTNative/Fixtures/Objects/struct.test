# THE NATIVE GATE OVER struct.js. The modules are the build's: Native.cmake's
# ctcompile_add_native_pipeline lowers this program through the closed world,
# the lift and the lowering (refusing to write a module while any function
# carries `ctnative.not_native`), then applies the printing policy and its
# mutation. Each is gated here: compiled standalone with no ctbrowser library,
# shown by nm to reach no interpreter, run, and compared global by global with
# the interpreter's own answer (compilation-unit.py); compiled clean on both
# toolchains with a provenance comment over every definition (compile-clean.py);
# and the printed pins paired, spelling-only, and shown to bite (print-deduced.py).
# A trailing global on a RUN line under `not` is the off-by-one negative proof:
# the mutation must fail naming that global, so the gate's teeth stay in the suite.

# Phase 56: object literals with closed shapes, on the stack
# RUN: %compilation_unit --module %{obj}/structs.pipeline.emitc.mlir --js %S/struct.js --work %t --name structs
# RUN: not %compilation_unit --module %{obj}/structs.pipeline.emitc.mlir --js %S/struct.js --work %t --name structs_off_by_one --mutate swap_answer 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# OFF-BY-ONE: global 'swap_answer' differs
# RUN: %compilation_unit --module %{obj}/structs.pipeline.deduced.emitc.mlir --js %S/struct.js --work %t --name structs_deduced
# RUN: %compile_clean --module %{obj}/structs.pipeline.emitc.mlir --work %t --name structs
# RUN: %compile_clean --module %{obj}/structs.pipeline.deduced.emitc.mlir --work %t --name structs_deduced
# RUN: %print_deduced --plain %{obj}/structs.pipeline.emitc.mlir --deduced %{obj}/structs.pipeline.deduced.emitc.mlir --mutated %{obj}/structs.pipeline.mutated.emitc.mlir --work %t --name structs
