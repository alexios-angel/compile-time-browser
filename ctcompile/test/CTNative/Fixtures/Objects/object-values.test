# THE NATIVE GATE OVER object-values.js. The modules are the build's: Native.cmake's
# ctcompile_add_native_pipeline lowers this program through the closed world,
# the lift and the lowering (refusing to write a module while any function
# carries `ctnative.not_native`), then applies the printing policy and its
# mutation. Each is gated here: compiled standalone with no ctbrowser library,
# shown by nm to reach no interpreter, run, and compared global by global with
# the interpreter's own answer (compilation-unit.py); compiled clean on both
# toolchains with a provenance comment over every definition (compile-clean.py);
# and the printed pins paired, spelling-only, and shown to bite (print-deduced.py).
# A trailing global on a RUN line under `not` is the off-by-one negative proof:
# the mutation must fail naming that global, so the gate's teeth stay in the suite.

# The ordinary differential pipeline, with opt-in compile-time heap evaluation.
# Numeric observers receive heap arguments, so they remain runtime functions.
# RUN: %compilation_unit --module %{obj}/object_values.pipeline.emitc.mlir --js %S/object-values.js --work %t --name object_values
# RUN: not %compilation_unit --module %{obj}/object_values.pipeline.emitc.mlir --js %S/object-values.js --work %t --name object_values_off_by_one --mutate raw42 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# OFF-BY-ONE: global 'raw42' differs
# RUN: %compilation_unit --module %{obj}/object_values.pipeline.deduced.emitc.mlir --js %S/object-values.js --work %t --name object_values_deduced
# RUN: %compile_clean --module %{obj}/object_values.pipeline.emitc.mlir --work %t --name object_values
# RUN: %compile_clean --module %{obj}/object_values.pipeline.deduced.emitc.mlir --work %t --name object_values_deduced
# RUN: %print_deduced --plain %{obj}/object_values.pipeline.emitc.mlir --deduced %{obj}/object_values.pipeline.deduced.emitc.mlir --mutated %{obj}/object_values.pipeline.mutated.emitc.mlir --work %t --name object_values
