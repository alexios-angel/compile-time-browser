# Native differential test of index-truncation.js. The modules come from
# ctcompile_add_native_pipeline in Native.cmake, which lowers the program to
# native C++ (writing no module while any function carries `ctnative.not_native`)
# plus a variant printed with deduced `auto` types and one with a wrong type pin.
# compilation-unit.py compiles a module standalone, checks with nm that it calls
# no interpreter, runs it, and compares every global with the interpreter's.
# compile-clean.py checks a warning-free build on both toolchains with a
# provenance comment over every definition. print-deduced.py checks that the
# deduced module differs only in type spellings and that the wrong pin fails.
# A `not ... --mutate G` line adds one to global G in the C++ and expects the
# comparison to fail naming G, proving the comparison can catch a difference.

# ND-8: a fractional Number key names a property, an integral one (or -0) an element.
# RUN: %compilation_unit --module %{obj}/index_truncation.pipeline.emitc.mlir --js %S/index-truncation.js --work %t --name index_truncation
# RUN: not %compilation_unit --module %{obj}/index_truncation.pipeline.emitc.mlir --js %S/index-truncation.js --work %t --name index_truncation_off_by_one --mutate idx_integral 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# OFF-BY-ONE: global 'idx_integral' differs
# RUN: %compilation_unit --module %{obj}/index_truncation.pipeline.deduced.emitc.mlir --js %S/index-truncation.js --work %t --name index_truncation_deduced
# RUN: %compile_clean --module %{obj}/index_truncation.pipeline.emitc.mlir --work %t --name index_truncation
# RUN: %compile_clean --module %{obj}/index_truncation.pipeline.deduced.emitc.mlir --work %t --name index_truncation_deduced
# RUN: %print_deduced --plain %{obj}/index_truncation.pipeline.emitc.mlir --deduced %{obj}/index_truncation.pipeline.deduced.emitc.mlir --mutated %{obj}/index_truncation.pipeline.mutated.emitc.mlir --work %t --name index_truncation
