# Differential test of array-callbacks.js: each Array callback method calls
# its specialised callback through the runtime, as
# `ctnative::Array.prototype.X.call(a, std::bind_front(callback, captures...))`
# or with the bare callback when it captures nothing. The C++ is compiled
# against public Core, checked for interpreter symbols with nm, run, and every
# global compared with the interpreter's (compilation-unit.py). The negative
# changes the printed String `kept` and requires the comparison to fail naming
# it. compile-clean.py checks a warning-free build on both toolchains.
# string-arrays-calls.py is the generic pipeline driver for a fixture that is
# not registered in NativeFixtures.cmake.

# RUN: python3 %S/string-arrays-calls.py --translate ctjs-translate --opt ctjs-opt --js %S/array-callbacks.js --out %t/array-callbacks.emitc.mlir
# RUN: ctjs-translate --mlir-to-cpp %t/array-callbacks.emitc.mlir | FileCheck %s
# RUN: %compilation_unit --module %t/array-callbacks.emitc.mlir --js %S/array-callbacks.js --work %t --name array_callbacks --core-build %build
# RUN: not %compilation_unit --module %t/array-callbacks.emitc.mlir --js %S/array-callbacks.js --work %t --name array_callbacks_negative --core-build %build --mutate kept --mutate-as string 2>&1 | FileCheck %s --check-prefix=NEGATIVE
# RUN: %compile_clean --module %t/array-callbacks.emitc.mlir --work %t --name array_callbacks

# CHECK-DAG: ctnative::Array.prototype.filter.call(
# CHECK-DAG: ctnative::Array.prototype.map.call(
# CHECK-DAG: ctnative::Array.prototype.some.call(
# CHECK-DAG: ctnative::Array.prototype.every.call(
# CHECK-DAG: ctnative::Array.prototype.find.call(
# CHECK-DAG: ctnative::Array.prototype.reduce.call(
# CHECK-DAG: ctnative::Array.prototype.forEach.call(
# CHECK-DAG: std::bind_front(
# NEGATIVE: global 'kept' differs
