# Differential test of array-callback-cells.js: each callback captures a
# binding it or its frame writes, and takes it by address, as
# `std::bind_front(callback, pointer)` with `pointer = &binding`. The C++ is
# compiled against public Core, checked for interpreter symbols with nm, run,
# and every global compared with the interpreter's (compilation-unit.py). The negative changes the
# printed Number `sortCalls`, the comparator's call count, and requires the
# comparison to fail naming it. compile-clean.py checks a warning-free build on
# both toolchains. string-arrays-calls.py is the generic pipeline driver for a
# fixture that is not registered in NativeFixtures.cmake.

# RUN: python3 %S/string-arrays-calls.py --translate ctjs-translate --opt ctjs-opt --js %S/array-callback-cells.js --out %t/array-callback-cells.emitc.mlir
# RUN: ctjs-translate --mlir-to-cpp %t/array-callback-cells.emitc.mlir | FileCheck %s
# RUN: %compilation_unit --module %t/array-callback-cells.emitc.mlir --js %S/array-callback-cells.js --work %t --name array_callback_cells --core-build %build
# RUN: not %compilation_unit --module %t/array-callback-cells.emitc.mlir --js %S/array-callback-cells.js --work %t --name array_callback_cells_negative --core-build %build --mutate sortCalls 2>&1 | FileCheck %s --check-prefix=NEGATIVE
# RUN: %compile_clean --module %t/array-callback-cells.emitc.mlir --work %t --name array_callback_cells

# CHECK-DAG: ctnative::Array.prototype.forEach.call(
# CHECK-DAG: ctnative::Array.prototype.sort.call(
# CHECK-DAG: ctnative::js_num* const [[ADDRESS:v[0-9]+]] = &v{{[0-9]+}};
# CHECK-DAG: std::bind_front(fn_{{[0-9]+}}, [[ADDRESS]]);
# CHECK-DAG: ctnative::js_string* const v{{[0-9]+}} = &v{{[0-9]+}};
# NEGATIVE: global 'sortCalls' differs
