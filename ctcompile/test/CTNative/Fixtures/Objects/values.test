# Native differential test of values.js. The modules come from
# ctcompile_add_native_pipeline in Native.cmake, which lowers the program to
# native C++ (writing no module while any function carries `ctnative.not_native`)
# plus a variant printed with deduced `auto` types and one with a wrong type pin.
# compilation-unit.py compiles a module standalone, checks with nm that it calls
# no interpreter, runs it, and compares every global with the interpreter's.
# compile-clean.py checks a warning-free build on both toolchains with a
# provenance comment over every definition. print-deduced.py checks that the
# deduced module differs only in type spellings and that the wrong pin fails.
# A `not ... --mutate G` line adds one to global G in the C++ and expects the
# comparison to fail naming G, proving the comparison can catch a difference.

# The ordinary differential pipeline, with opt-in compile-time heap evaluation.
# Numeric observers receive heap arguments, so they remain runtime functions.
# RUN: %compilation_unit --module %{obj}/object_values.pipeline.emitc.mlir --js %S/values.js --work %t --name object_values
# RUN: not %compilation_unit --module %{obj}/object_values.pipeline.emitc.mlir --js %S/values.js --work %t --name object_values_off_by_one --mutate raw42 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# OFF-BY-ONE: global 'raw42' differs
# RUN: %compilation_unit --module %{obj}/object_values.pipeline.deduced.emitc.mlir --js %S/values.js --work %t --name object_values_deduced
# RUN: %compile_clean --module %{obj}/object_values.pipeline.emitc.mlir --work %t --name object_values
# RUN: %compile_clean --module %{obj}/object_values.pipeline.deduced.emitc.mlir --work %t --name object_values_deduced
# RUN: %print_deduced --plain %{obj}/object_values.pipeline.emitc.mlir --deduced %{obj}/object_values.pipeline.deduced.emitc.mlir --mutated %{obj}/object_values.pipeline.mutated.emitc.mlir --work %t --name object_values
