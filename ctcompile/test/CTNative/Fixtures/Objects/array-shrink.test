# THE NATIVE GATE OVER array-shrink.js. The modules are the build's: Native.cmake's
# ctcompile_add_native_pipeline lowers this program through the closed world,
# the lift and the lowering (refusing to write a module while any function
# carries `ctnative.not_native`), then applies the printing policy and its
# mutation. Each is gated here: compiled standalone with no ctbrowser library,
# shown by nm to reach no interpreter, run, and compared global by global with
# the interpreter's own answer (compilation-unit.py); compiled clean on both
# toolchains with a provenance comment over every definition (compile-clean.py);
# and the printed pins paired, spelling-only, and shown to bite (print-deduced.py).
# A trailing global on a RUN line under `not` is the off-by-one negative proof:
# the mutation must fail naming that global, so the gate's teeth stay in the suite.

# array_shrink
# RUN: %compilation_unit --module %{obj}/array_shrink.pipeline.emitc.mlir --js %S/array-shrink.js --work %t --name array_shrink
# RUN: not %compilation_unit --module %{obj}/array_shrink.pipeline.emitc.mlir --js %S/array-shrink.js --work %t --name array_shrink_off_by_one --mutate shortened 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# OFF-BY-ONE: global 'shortened' differs
# RUN: %compilation_unit --module %{obj}/array_shrink.pipeline.deduced.emitc.mlir --js %S/array-shrink.js --work %t --name array_shrink_deduced
# RUN: %compile_clean --module %{obj}/array_shrink.pipeline.emitc.mlir --work %t --name array_shrink
# RUN: %compile_clean --module %{obj}/array_shrink.pipeline.deduced.emitc.mlir --work %t --name array_shrink_deduced
# RUN: %print_deduced --plain %{obj}/array_shrink.pipeline.emitc.mlir --deduced %{obj}/array_shrink.pipeline.deduced.emitc.mlir --mutated %{obj}/array_shrink.pipeline.mutated.emitc.mlir --work %t --name array_shrink

# array_shrink_unoptimized
# RUN: %compilation_unit --module %{obj}/array_shrink_unoptimized.pipeline.emitc.mlir --js %S/array-shrink.js --work %t --name array_shrink_unoptimized
# RUN: not %compilation_unit --module %{obj}/array_shrink_unoptimized.pipeline.emitc.mlir --js %S/array-shrink.js --work %t --name array_shrink_unoptimized_off_by_one --mutate shortened 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# RUN: %compilation_unit --module %{obj}/array_shrink_unoptimized.pipeline.deduced.emitc.mlir --js %S/array-shrink.js --work %t --name array_shrink_unoptimized_deduced
# RUN: %compile_clean --module %{obj}/array_shrink_unoptimized.pipeline.emitc.mlir --work %t --name array_shrink_unoptimized
# RUN: %compile_clean --module %{obj}/array_shrink_unoptimized.pipeline.deduced.emitc.mlir --work %t --name array_shrink_unoptimized_deduced
# RUN: %print_deduced --plain %{obj}/array_shrink_unoptimized.pipeline.emitc.mlir --deduced %{obj}/array_shrink_unoptimized.pipeline.deduced.emitc.mlir --mutated %{obj}/array_shrink_unoptimized.pipeline.mutated.emitc.mlir --work %t --name array_shrink_unoptimized
