# THE NATIVE GATE OVER owned-method-table-slot.js. The modules are the build's: Native.cmake's
# ctcompile_add_native_pipeline lowers this program through the closed world,
# the lift and the lowering (refusing to write a module while any function
# carries `ctnative.not_native`), then applies the printing policy and its
# mutation. Each is gated here: compiled standalone with no ctbrowser library,
# shown by nm to reach no interpreter, run, and compared global by global with
# the interpreter's own answer (compilation-unit.py); compiled clean on both
# toolchains with a provenance comment over every definition (compile-clean.py);
# and the printed pins paired, spelling-only, and shown to bite (print-deduced.py).
# A trailing global on a RUN line under `not` is the off-by-one negative proof:
# the mutation must fail naming that global, so the gate's teeth stay in the suite.

# A confined ordinary field owns a returned table beyond its container's lifetime.
# RUN: %compilation_unit --module %{obj}/owned_method_table_slots.pipeline.emitc.mlir --js %S/owned-method-table-slot.js --work %t --name owned_method_table_slots
# RUN: %compilation_unit --module %{obj}/owned_method_table_slots.pipeline.deduced.emitc.mlir --js %S/owned-method-table-slot.js --work %t --name owned_method_table_slots_deduced
# RUN: %compile_clean --module %{obj}/owned_method_table_slots.pipeline.emitc.mlir --work %t --name owned_method_table_slots
# RUN: %compile_clean --module %{obj}/owned_method_table_slots.pipeline.deduced.emitc.mlir --work %t --name owned_method_table_slots_deduced
# RUN: %print_deduced --plain %{obj}/owned_method_table_slots.pipeline.emitc.mlir --deduced %{obj}/owned_method_table_slots.pipeline.deduced.emitc.mlir --mutated %{obj}/owned_method_table_slots.pipeline.mutated.emitc.mlir --work %t --name owned_method_table_slots
