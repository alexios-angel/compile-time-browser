# Native differential test of closure.js. Native.cmake's
# ctcompile_add_native_pipeline builds the modules: it runs closed-world
# analysis, closure lifting and native lowering (and writes no module while
# any function carries `ctnative.not_native`), then applies the printing
# policy and its seeded mutation. The RUN lines check that the C++ compiles
# standalone with no ctbrowser library, links no interpreter symbol (by nm),
# and prints the interpreter's value for every global (compilation-unit.py);
# that it compiles warning-free on both toolchains with a provenance comment
# over every definition (compile-clean.py); and that the plain and deduced
# printings differ only in type spelling and the mutated one fails (print-deduced.py).
# A `not ... --mutate G` line corrupts global G and requires the check to name G.

# Closures that closure lifting turns into native functions.
# RUN: %compilation_unit --module %{obj}/closures.pipeline.emitc.mlir --js %S/closure.js --work %t --name closures
# RUN: %compilation_unit --module %{obj}/closures.pipeline.deduced.emitc.mlir --js %S/closure.js --work %t --name closures_deduced
# RUN: %compile_clean --module %{obj}/closures.pipeline.emitc.mlir --work %t --name closures
# RUN: %compile_clean --module %{obj}/closures.pipeline.deduced.emitc.mlir --work %t --name closures_deduced
# RUN: %print_deduced --plain %{obj}/closures.pipeline.emitc.mlir --deduced %{obj}/closures.pipeline.deduced.emitc.mlir --mutated %{obj}/closures.pipeline.mutated.emitc.mlir --work %t --name closures
