# THE NATIVE GATE OVER local-function.js. The modules are the build's: Native.cmake's
# ctcompile_add_native_pipeline lowers this program through the closed world,
# the lift and the lowering (refusing to write a module while any function
# carries `ctnative.not_native`), then applies the printing policy and its
# mutation. Each is gated here: compiled standalone with no ctbrowser library,
# shown by nm to reach no interpreter, run, and compared global by global with
# the interpreter's own answer (compilation-unit.py); compiled clean on both
# toolchains with a provenance comment over every definition (compile-clean.py);
# and the printed pins paired, spelling-only, and shown to bite (print-deduced.py).
# A trailing global on a RUN line under `not` is the off-by-one negative proof:
# the mutation must fail naming that global, so the gate's teeth stay in the suite.

# Step 4: a local binding that holds a function.
# RUN: %compilation_unit --module %{obj}/local_functions.pipeline.emitc.mlir --js %S/local-function.js --work %t --name local_functions
# RUN: not %compilation_unit --module %{obj}/local_functions.pipeline.emitc.mlir --js %S/local-function.js --work %t --name local_functions_off_by_one --mutate recur15 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# OFF-BY-ONE: global 'recur15' differs
# RUN: %compilation_unit --module %{obj}/local_functions.pipeline.deduced.emitc.mlir --js %S/local-function.js --work %t --name local_functions_deduced
# RUN: %compile_clean --module %{obj}/local_functions.pipeline.emitc.mlir --work %t --name local_functions
# RUN: %compile_clean --module %{obj}/local_functions.pipeline.deduced.emitc.mlir --work %t --name local_functions_deduced
# RUN: %print_deduced --plain %{obj}/local_functions.pipeline.emitc.mlir --deduced %{obj}/local_functions.pipeline.deduced.emitc.mlir --mutated %{obj}/local_functions.pipeline.mutated.emitc.mlir --work %t --name local_functions
