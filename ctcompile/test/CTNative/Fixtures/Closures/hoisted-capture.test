# Native differential test of hoisted-capture.js. Native.cmake's
# ctcompile_add_native_pipeline builds the modules: it runs closed-world
# analysis, closure lifting and native lowering (and writes no module while
# any function carries `ctnative.not_native`), then applies the printing
# policy and its seeded mutation. The RUN lines check that the C++ compiles
# standalone with no ctbrowser library, links no interpreter symbol (by nm),
# and prints the interpreter's value for every global (compilation-unit.py);
# that it compiles warning-free on both toolchains with a provenance comment
# over every definition (compile-clean.py); and that the plain and deduced
# printings differ only in type spelling and the mutated one fails (print-deduced.py).
# A `not ... --mutate G` line corrupts global G and requires the check to name G.

# A captured binding with one dominating write.
# RUN: %compilation_unit --module %{obj}/hoisted_captures.pipeline.emitc.mlir --js %S/hoisted-capture.js --work %t --name hoisted_captures
# RUN: not %compilation_unit --module %{obj}/hoisted_captures.pipeline.emitc.mlir --js %S/hoisted-capture.js --work %t --name hoisted_captures_off_by_one --mutate three32 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# OFF-BY-ONE: global 'three32' differs
# RUN: %compilation_unit --module %{obj}/hoisted_captures.pipeline.deduced.emitc.mlir --js %S/hoisted-capture.js --work %t --name hoisted_captures_deduced
# RUN: %compile_clean --module %{obj}/hoisted_captures.pipeline.emitc.mlir --work %t --name hoisted_captures
# RUN: %compile_clean --module %{obj}/hoisted_captures.pipeline.deduced.emitc.mlir --work %t --name hoisted_captures_deduced
# RUN: %print_deduced --plain %{obj}/hoisted_captures.pipeline.emitc.mlir --deduced %{obj}/hoisted_captures.pipeline.deduced.emitc.mlir --mutated %{obj}/hoisted_captures.pipeline.mutated.emitc.mlir --work %t --name hoisted_captures
