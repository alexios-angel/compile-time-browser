# THE NATIVE GATE OVER divergence.js. The modules are the build's: Native.cmake's
# ctcompile_add_native_pipeline lowers this program through the closed world,
# the lift and the lowering (refusing to write a module while any function
# carries `ctnative.not_native`), then applies the printing policy and its
# mutation. Each is gated here: compiled standalone with no ctbrowser library,
# shown by nm to reach no interpreter, run, and compared global by global with
# the interpreter's own answer (compilation-unit.py); compiled clean on both
# toolchains with a provenance comment over every definition (compile-clean.py);
# and the printed pins paired, spelling-only, and shown to bite (print-deduced.py).
# A trailing global on a RUN line under `not` is the off-by-one negative proof:
# the mutation must fail naming that global, so the gate's teeth stay in the suite.

# Phase 63 Step 5: the EMITTED half of docs/native-divergences.md - `**` and
# its guard, `%` as fmod, -0, undefined as NaN, an out-of-range index as NaN.
# RUN: %compilation_unit --module %{obj}/divergence.pipeline.emitc.mlir --js %S/divergence.js --work %t --name divergence
# RUN: %compilation_unit --module %{obj}/divergence.pipeline.deduced.emitc.mlir --js %S/divergence.js --work %t --name divergence_deduced
# RUN: %compile_clean --module %{obj}/divergence.pipeline.emitc.mlir --work %t --name divergence
# RUN: %compile_clean --module %{obj}/divergence.pipeline.deduced.emitc.mlir --work %t --name divergence_deduced
# RUN: %print_deduced --plain %{obj}/divergence.pipeline.emitc.mlir --deduced %{obj}/divergence.pipeline.deduced.emitc.mlir --mutated %{obj}/divergence.pipeline.mutated.emitc.mlir --work %t --name divergence
