# Node, the VM and the GCC/Clang native programs must agree on template
# literals. Disable precomputation so the test reaches ctnative::format,
# including JavaScript's Number::toString and escaped literal braces.

# RUN: rm -rf %t && mkdir -p %t
# RUN: %node %S/template-literal.js > %t/node.txt
# RUN: %native_reference --page %S/template-literal.html --script %S/template-literal.js > %t/vm.txt
# RUN: cmp %t/node.txt %t/vm.txt
# RUN: FileCheck %s --match-full-lines --strict-whitespace < %t/vm.txt
# RUN: %cmake -DTRANSLATE=ctjs-translate -DOPT=ctjs-opt -DSOURCE=%S/template-literal.js -DOUTPUT=%t/template.mlir -DOPTIMIZE=OFF -P %S/../../Checks/pipeline.cmake
# RUN: ctjs-translate --mlir-to-cpp %t/template.mlir -o %t/template.cpp
# RUN: FileCheck %s --check-prefix=CPP < %t/template.cpp
# RUN: python3 %S/console_log.py --cpp %t/template.cpp --expected %t/vm.txt --build %build --include %{monorepo}/ctbrowser/include --work %t

# CPP: ctnative::format(
# CPP: ctnative::format("braces {{[{][{]x[}][}]}} and {{[{][{][{][{]y[}][}][}][}]}}: {}",

# CHECK:plain
# CHECK-NEXT:sum 0.30000000000000004
# CHECK-NEXT:neg 0
# CHECK-NEXT:big 1e+21
# CHECK-NEXT:small 1e-7
# CHECK-NEXT:nan NaN
# CHECK-NEXT:inf Infinity
# CHECK-NEXT:nested inner 2 outer
# CHECK-NEXT:braces {x} and {{[{][{]y[}][}]}}: 3
# CHECK-NEXT:multi 1 two true null undefined
# CHECK-NEXT:9 true
# CHECK-NEXT:6 true
# CHECK-NOT:{{.}}
