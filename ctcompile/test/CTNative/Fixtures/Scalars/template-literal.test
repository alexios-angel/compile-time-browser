# Differential test of template-literal lowering (StringValues/Operations.cpp:
# a template's Concat chain becomes one ctnative::format call; Runtime/Format.hpp
# writes the substitutions). The VM runs template-literal.js in a page and
# records each console.log line; the native pipeline lowers the same file
# (refusing while any function is not native), and its program, built with GCC
# and Clang and linked with ctbrowser's Core library (template_literal.py),
# must print the same lines. FileCheck pins the VM's lines, so an empty or
# shortened output cannot pass. 1e21 and 1e-7 go through the runtime's
# Number::toString and must print as `1e+21` and `1e-7`, the JavaScript
# spellings (a std::format fallback would print `1e+21` and `1e-07`).

# RUN: rm -rf %t && mkdir -p %t
# RUN: %native_reference --page %S/template-literal.html --script %S/template-literal.js > %t/vm.txt
# RUN: FileCheck %s --match-full-lines --strict-whitespace < %t/vm.txt
# RUN: %cmake -DTRANSLATE=ctjs-translate -DOPT=ctjs-opt -DSOURCE=%S/template-literal.js -DOUTPUT=%t/template.mlir -P %S/../../Checks/pipeline.cmake
# RUN: ctjs-translate --mlir-to-cpp %t/template.mlir -o %t/template.cpp
# RUN: grep -c 'ctnative::format(' %t/template.cpp | FileCheck %s --check-prefix=CALLS
# CALLS: {{[1-9][0-9]*}}
# RUN: python3 %S/template_literal.py --cpp %t/template.cpp --expected %t/vm.txt --build %build --include %{monorepo}/ctbrowser/include --work %t

# CHECK:plain
# CHECK-NEXT:sum 0.30000000000000004
# CHECK-NEXT:neg 0
# CHECK-NEXT:big 1e+21
# CHECK-NEXT:small 1e-7
# CHECK-NEXT:nan NaN
# CHECK-NEXT:inf Infinity
# CHECK-NEXT:nested inner 2 outer
# CHECK-NEXT:braces {x} and {{y}}: 3
# CHECK-NEXT:multi 1 two true null undefined
# CHECK-NOT:{{.}}
