# Differential test of optional-scalars.js. Native.cmake's ctcompile_add_native_pipeline
# lowers the program to C++ (refusing while any function still carries
# `ctnative.not_native`), and also writes a variant whose deduced types print
# as `auto` plus a CTCOMPILE_PIN type check, and a copy with one pin wrong.
# The RUN lines check that the C++ compiles with no ctbrowser library, reaches
# no interpreter symbol (nm), and prints the same value for every global as
# the interpreter (compilation-unit.py); that it compiles warning-free on both
# toolchains with a provenance comment over every definition (compile-clean.py);
# and that the deduced spelling is right and the wrong pin fails (print-deduced.py).
# A `not ... --mutate G` line corrupts global G and requires the comparison to
# fail naming G, which proves the comparison can catch a wrong value.

# Tagged optional scalars distinguish null, undefined and present NaN.
# RUN: %compilation_unit --module %{obj}/optional_scalars.pipeline.emitc.mlir --js %S/optional-scalars.js --work %t --name optional_scalars
# RUN: not %compilation_unit --module %{obj}/optional_scalars.pipeline.emitc.mlir --js %S/optional-scalars.js --work %t --name optional_scalars_off_by_one --mutate number_present 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# OFF-BY-ONE: global 'number_present' differs
# RUN: %compilation_unit --module %{obj}/optional_scalars.pipeline.deduced.emitc.mlir --js %S/optional-scalars.js --work %t --name optional_scalars_deduced
# RUN: %compile_clean --module %{obj}/optional_scalars.pipeline.emitc.mlir --work %t --name optional_scalars
# RUN: %compile_clean --module %{obj}/optional_scalars.pipeline.deduced.emitc.mlir --work %t --name optional_scalars_deduced
# RUN: %print_deduced --plain %{obj}/optional_scalars.pipeline.emitc.mlir --deduced %{obj}/optional_scalars.pipeline.deduced.emitc.mlir --mutated %{obj}/optional_scalars.pipeline.mutated.emitc.mlir --work %t --name optional_scalars
