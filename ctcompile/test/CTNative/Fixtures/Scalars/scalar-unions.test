# Differential test of scalar-unions.js. Native.cmake's ctcompile_add_native_pipeline
# lowers the program to C++ (refusing while any function still carries
# `ctnative.not_native`), and also writes a variant whose deduced types print
# as `auto` plus a CTCOMPILE_PIN type check, and a copy with one pin wrong.
# The RUN lines check that the C++ compiles with no ctbrowser library, reaches
# no interpreter symbol (nm), and prints the same value for every global as
# the interpreter (compilation-unit.py); that it compiles warning-free on both
# toolchains with a provenance comment over every definition (compile-clean.py);
# and that the deduced spelling is right and the wrong pin fails (print-deduced.py).
# A `not ... --mutate G` line corrupts global G and requires the comparison to
# fail naming G, which proves the comparison can catch a wrong value.

# A closed scalar union preserves boolean/number identity, including Data's
# short-circuit getter and its retained nested Map environment.
# RUN: %compilation_unit --module %{obj}/scalar_unions.pipeline.emitc.mlir --js %S/scalar-unions.js --work %t --name scalar_unions
# RUN: not %compilation_unit --module %{obj}/scalar_unions.pipeline.emitc.mlir --js %S/scalar-unions.js --work %t --name scalar_unions_off_by_one --mutate zz_lifetime 2>&1 | FileCheck %s --check-prefix=OFF-BY-ONE
# OFF-BY-ONE: global 'zz_lifetime' differs
# RUN: %compilation_unit --module %{obj}/scalar_unions.pipeline.deduced.emitc.mlir --js %S/scalar-unions.js --work %t --name scalar_unions_deduced
# RUN: %compile_clean --module %{obj}/scalar_unions.pipeline.emitc.mlir --work %t --name scalar_unions
# RUN: %compile_clean --module %{obj}/scalar_unions.pipeline.deduced.emitc.mlir --work %t --name scalar_unions_deduced
# RUN: %print_deduced --plain %{obj}/scalar_unions.pipeline.emitc.mlir --deduced %{obj}/scalar_unions.pipeline.deduced.emitc.mlir --mutated %{obj}/scalar_unions.pipeline.mutated.emitc.mlir --work %t --name scalar_unions
