# Listeners an ordinary script registers run natively when the host dispatches
# a click, as they run on the interpreter, with no VM linked into the native
# build.
# RUN: %{obj}/ctcompile-test-events %S/events.html %S/events.js > %t.vm
# RUN: env CTBROWSER_TEST_ENGINE=native %{obj}/ctcompile-test-events-native %S/events.html %S/events.js > %t.native
# RUN: diff %t.vm %t.native
# RUN: env CTBROWSER_TEST_ENGINE=native %{obj}/ctcompile-test-events-native-gcc %S/events.html %S/events.js > %t.gcc
# RUN: diff %t.vm %t.gcc
# RUN: FileCheck %s --input-file %t.native
# RUN: %nm -C %{obj}/ctcompile-test-events-native | not grep -E "ctbrowser::script::"
# RUN: %nm -C %{obj}/ctcompile-test-events-native-gcc | not grep -E "ctbrowser::script::"
# CHECK: clicks=0 order= seen=| phases=| notes=note:heard note:canceled! | counted=| named=| jobs=sj| init=cancelable:true,false bubbles:true,false{{$}}
# CHECK-NEXT: top: clicks=1 order=r+ seen=| phases=Dtop c W | notes=note:heard note:canceled! | counted=gh| named=n| jobs=sjc| init=cancelable:true,false bubbles:true,false{{$}}
# CHECK-NEXT: leaf: clicks=1 order=r+b seen=click:leaf@page! | phases=Dtop c W Dleaf c | notes=note:heard note:canceled! | counted=ghg| named=n| jobs=sjc| init=cancelable:true,false bubbles:true,false{{$}}
# CHECK-NEXT: page: clicks=2 order=r+bbr- seen=click:leaf@page! click:page@page! | phases=Dtop c W Dleaf c Dpage c W | notes=note:heard note:canceled! | counted=ghggh| named=n| jobs=sjcc| init=cancelable:true,false bubbles:true,false{{$}}
