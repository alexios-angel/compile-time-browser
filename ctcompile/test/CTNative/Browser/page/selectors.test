# The element calls of Bootstrap's SelectorEngine and Manipulator answer
# natively what they answer on the interpreter, with no VM linked into the
# native build.
# RUN: %{obj}/ctcompile-test-selectors %S/selectors.html %S/selectors.js > %t.vm
# RUN: env CTBROWSER_TEST_ENGINE=native %{obj}/ctcompile-test-selectors-native %S/selectors.html %S/selectors.js > %t.native
# RUN: diff %t.vm %t.native
# RUN: FileCheck %s --input-file %t.native
# RUN: FileCheck %s --check-prefix=SPELLING --input-file %{obj}/selectors.generated.cpp
# RUN: %nm -C %{obj}/ctcompile-test-selectors-native | not grep -E "ctbrowser::script::"
# CHECK: {{^}}1none|top/h/null/yesnull/null;0h:true|top/b/null/yesnull/null;|a,c,d,|a,c,d,tail,|none|no parent|list|b|none{{$}}
