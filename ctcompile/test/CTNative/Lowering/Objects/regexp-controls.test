# NUL: false true

# NATIVE: ctnative::RegExp.prototype.test.call
# OUTPUT-DAG: line=true
# OUTPUT-DAG: carriage=true
# OUTPUT-DAG: tab=true
# OUTPUT-DAG: control=true

#--- controls.js
var line = new RegExp("\n").test("\n");
var carriage = new RegExp("\r").test("\r");
var tab = new RegExp("\t").test("\t");
var control = new RegExp("\x01F").test("\x01F");

#--- nul.html
<!doctype html><html><body></body></html>
#--- nul.js
console.log(new RegExp("a\0b").test("a"), new RegExp("a\0b").test("a\0b"));
