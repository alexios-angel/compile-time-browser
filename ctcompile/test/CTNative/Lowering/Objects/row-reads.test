# A row of an array of rows read at an index not proved in bounds, as
# css-dump.js reads `els[i][1]` from FROM up to Math.min(FROM + COUNT,
# els.length): every use of `rows[i]` reads a position of it, which past the
# end would throw a TypeError, so the row is read with ctnative::vec_row,
# which throws that TypeError itself. The answers match the interpreter's
# under GCC and Clang, and a mutation of `joined` must be caught.
# RUN: split-file %s %t
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/values.js -o %t/input.mlir
# RUN: ctjs-opt %t/input.mlir --pass-pipeline="builtin.module(ctjs-resolve-globals,ctjs-lift-to-scf,ctnative-lower-to-emitc{optimize=false},emitc.func(canonicalize,convert-scf-to-emitc,convert-arith-to-emitc,canonicalize,ctnative-prune-dead-stores,canonicalize))" -o %t/runtime.mlir
# RUN: FileCheck %s --check-prefix=NATIVE --implicit-check-not=ctnative.not_native --implicit-check-not=ctjs.func < %t/runtime.mlir
# RUN: %compilation_unit --cxx g++ --module %t/runtime.mlir --js %t/values.js --work %t --name rows_gcc --core-build %build
# RUN: %compilation_unit --cxx %dom_clang --module %t/runtime.mlir --js %t/values.js --work %t --name rows_clang --core-build %build
# RUN: not %compilation_unit --cxx g++ --module %t/runtime.mlir --js %t/values.js --work %t --name rows_mutation --mutate joined --mutate-as string --core-build %build 2>&1 | FileCheck %s --check-prefix=MUTATION

# NATIVE: ctnative::vec_row
# MUTATION: global 'joined' differs

#--- values.js
function rowsFrom(from, count) {
    var rows = [];
    rows.push(['a', 1]);
    rows.push(['b', 2]);
    rows.push(['c', 3]);
    var out = '';
    var last = Math.min(from + count, rows.length);
    for (var i = from; i < last; i++) {
        out += rows[i][0] + rows[i][1];
    }
    return out;
}
var joined = rowsFrom(1, 5) + '|' + rowsFrom(0, 2);
