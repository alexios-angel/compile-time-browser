# A constructor's parameter takes a pointer to the object literal a `new`
# passes, as a function's does at a call (argumentCensus): the `new` sites
# are the constructor's calls when nothing else can run it. So the literal
# stays in the caller's frame, and a configuration parameter tested with
# `typeof` and spread into defaults is written out for its one shape
# (Lowering/ClosureLifting/SpreadParameters.h), as Bootstrap's FocusTrap does
# with the `{trapElement}` its two `new` sites pass.
#
# point.js reads two fields of its argument; trap.js spreads its argument
# into defaults; made.js passes it on from a function to the `new`. Each
# lowers completely, and GCC, Clang, the interpreter and Node print the same
# r.
#
# RUN: split-file %s %t
# RUN: for name in point trap made; do \
# RUN:   ctjs-translate --ctbrowser-js-to-ctjs %t/$name.js --mlir-print-debuginfo 2>/dev/null \
# RUN:   | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc=observe-globals=true -o %t/$name.mlir; \
# RUN:   ctjs-opt %t/$name.mlir '--pass-pipeline=builtin.module(emitc.func(canonicalize,convert-scf-to-emitc,convert-arith-to-emitc,canonicalize,ctnative-prune-dead-stores,canonicalize))' | ctjs-translate --mlir-to-cpp > %t/$name.cpp; \
# RUN:   FileCheck %s --check-prefix=NATIVE --implicit-check-not=ctnative.not_native < %t/$name.mlir; done
# RUN: FileCheck %s --check-prefix=POINT-CPP < %t/point.cpp
# RUN: FileCheck %s --check-prefix=TRAP-CPP < %t/trap.cpp
# RUN: %gxx -O2 %t/point.cpp -o %t/point-gcc && %t/point-gcc | FileCheck %s --check-prefix=POINT
# RUN: %clangxx -O2 %t/point.cpp -o %t/point-clang && %t/point-clang | FileCheck %s --check-prefix=POINT
# RUN: %native_reference %t/point.js | FileCheck %s --check-prefix=POINT
# RUN: %node -e 'const fs = require("fs"), vm = require("vm"), scope = {}; vm.runInNewContext(fs.readFileSync(process.argv[1], "utf8"), scope); console.log("r=" + scope.r);' %t/point.js | FileCheck %s --check-prefix=POINT
# RUN: %gxx -O2 %t/trap.cpp -o %t/trap-gcc && %t/trap-gcc | FileCheck %s --check-prefix=TRAP
# RUN: %clangxx -O2 %t/trap.cpp -o %t/trap-clang && %t/trap-clang | FileCheck %s --check-prefix=TRAP
# RUN: %native_reference %t/trap.js | FileCheck %s --check-prefix=TRAP
# RUN: %node -e 'const fs = require("fs"), vm = require("vm"), scope = {}; vm.runInNewContext(fs.readFileSync(process.argv[1], "utf8"), scope); console.log("r=" + scope.r);' %t/trap.js | FileCheck %s --check-prefix=TRAP
# RUN: %gxx -O2 %t/made.cpp -o %t/made-gcc && %t/made-gcc | FileCheck %s --check-prefix=MADE
# RUN: %clangxx -O2 %t/made.cpp -o %t/made-clang && %t/made-clang | FileCheck %s --check-prefix=MADE
# RUN: %native_reference %t/made.js | FileCheck %s --check-prefix=MADE
# RUN: %node -e 'const fs = require("fs"), vm = require("vm"), scope = {}; vm.runInNewContext(fs.readFileSync(process.argv[1], "utf8"), scope); console.log("r=" + scope.r);' %t/made.js | FileCheck %s --check-prefix=MADE
#
# Anything else keeps the spread and the test: backdrop.js passes two shapes
# from its two `new` sites, as Bootstrap's Modal and Offcanvas do for
# Backdrop, and in kinds.js the constructor is also kept in an array and
# constructed through it with a number.
# RUN: for name in backdrop kinds; do \
# RUN:   ctjs-translate --ctbrowser-js-to-ctjs %t/$name.js 2>/dev/null \
# RUN:   | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc=observe-globals=true \
# RUN:   | FileCheck %s --check-prefix=KEPT; done

# NATIVE: emitc.func @main
# POINT-CPP: Point_{{[0-9]+}}(Point* const v{{[0-9]+}}, ctn_x_y* const
# TRAP-CPP: FocusTrap_{{[0-9]+}}(FocusTrap* const v{{[0-9]+}}, ctn_trapElement* const
# POINT: r=41
# TRAP: r=57
# MADE: r=57
# KEPT-DAG: ctjs.unary typeof
# KEPT-DAG: ctjs.copy_props

#--- point.js
var r = (function () {
    class Point {
        constructor(config) {
            this.x = config.x;
            this.y = config.y;
        }
    }
    const a = new Point({ x: 1, y: 2 });
    const b = new Point({ x: 3, y: 4 });
    return a.x + b.y * 10;
})();

#--- trap.js
var r = (function () {
    class FocusTrap {
        constructor(config) {
            const merged = { autofocus: true, trapElement: 0, ...(typeof config === "object" ? config : {}) };
            this.autofocus = merged.autofocus;
            this.trapElement = merged.trapElement;
            this.active = false;
        }
        activate() {
            if (this.active) { return 0; }
            this.active = true;
            return this.autofocus ? this.trapElement : -1;
        }
    }
    const modal = new FocusTrap({ trapElement: 5 });
    const offcanvas = new FocusTrap({ trapElement: 7 });
    return modal.activate() * 10 + offcanvas.activate();
})();

#--- made.js
var r = (function () {
    class FocusTrap {
        constructor(config) {
            const merged = { autofocus: true, trapElement: 0, ...(typeof config === "object" ? config : {}) };
            this.trapElement = merged.trapElement;
        }
    }
    function makeTrap(config) {
        return new FocusTrap(config).trapElement;
    }
    return makeTrap({ trapElement: 5 }) * 10 + makeTrap({ trapElement: 7 });
})();

#--- backdrop.js
var r = (function () {
    class Backdrop {
        constructor(config) {
            const merged = {
                className: "modal-backdrop",
                isVisible: true,
                isAnimated: false,
                ...(typeof config === "object" ? config : {})
            };
            this.visible = merged.isVisible;
            this.animated = merged.isAnimated;
        }
    }
    const modal = new Backdrop({ isVisible: true, isAnimated: false });
    const offcanvas = new Backdrop({ className: "offcanvas-backdrop", isVisible: false, isAnimated: true });
    return (modal.visible ? 1 : 0) + (offcanvas.animated ? 2 : 0);
})();

#--- kinds.js
var r = (function () {
    function Settings(config) {
        const merged = { depth: 1, ...(typeof config === "object" ? config : {}) };
        this.depth = merged.depth;
    }
    const kinds = [Settings];
    const a = new Settings({ depth: 2 });
    const b = new kinds[0](5);
    return a.depth * 10 + b.depth;
})();
