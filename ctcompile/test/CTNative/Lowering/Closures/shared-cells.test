# A binding of a frame that a kept callback writes is shared through a
# std::shared_ptr<ctnative::cell<T>> (rule 2b in ClosureLifter.h): the frame,
# the promise handlers and the call-only closure `bump` hold one handle, so
# every write is seen by all of them after the frame has returned. Node, the
# VM and both native builds print "sn111n113". The timer and listener forms of
# the rule are run by Browser/page/timers.test and events.test.
#
# The negatives: a kept callback storing a closure over the shared binding
# into that binding would make a reference cycle; the closure is refused by
# the rule that a closure written into a carried binding does not lift, and
# admission's check that a shared cell holds only primitives guards the same
# cycle a second time. A binding reaching a kept callback through an
# enclosing closure is still refused by name.
#
# RUN: split-file %s %t
# RUN: %node %t/expected.cjs %t/shared.js sn111n113
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/shared.js -o %t/input.mlir
# RUN: ctjs-opt %t/input.mlir --pass-pipeline="builtin.module(ctjs-resolve-globals,ctjs-lift-to-scf,ctnative-lower-to-emitc,emitc.func(canonicalize,convert-scf-to-emitc,convert-arith-to-emitc,canonicalize,ctnative-prune-dead-stores,canonicalize))" -o %t/runtime.mlir
# RUN: FileCheck %s --check-prefix=NATIVE --implicit-check-not=ctnative.not_native --implicit-check-not=ctjs.func < %t/runtime.mlir
# RUN: %compilation_unit --cxx g++ --module %t/runtime.mlir --js %t/shared.js --work %t --name shared_gcc --core-build %build
# RUN: %compilation_unit --cxx %dom_clang --module %t/runtime.mlir --js %t/shared.js --work %t --name shared_clang --core-build %build
# RUN: not %compilation_unit --cxx g++ --module %t/runtime.mlir --js %t/shared.js --work %t --name shared_mutation --mutate seen --mutate-as string --core-build %build 2>&1 | FileCheck %s --check-prefix=MUTATION
# RUN: %node %t/expected.cjs %t/recursive.js 4
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/recursive.js -o %t/recursive.mlir
# RUN: ctjs-opt %t/recursive.mlir --pass-pipeline="builtin.module(ctjs-resolve-globals,ctjs-lift-to-scf,ctnative-lower-to-emitc,emitc.func(canonicalize,convert-scf-to-emitc,convert-arith-to-emitc,canonicalize,ctnative-prune-dead-stores,canonicalize))" -o %t/recursive.emitc.mlir
# RUN: FileCheck %s --check-prefix=RECURSIVE --implicit-check-not=ctnative.not_native --implicit-check-not=ctjs.func < %t/recursive.emitc.mlir
# RUN: %compilation_unit --cxx g++ --module %t/recursive.emitc.mlir --js %t/recursive.js --work %t/recursive-gcc --name recursive_gcc --core-build %build
# RUN: %compilation_unit --cxx %dom_clang --module %t/recursive.emitc.mlir --js %t/recursive.js --work %t/recursive-clang --name recursive_clang --core-build %build
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/cycle.js | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc | FileCheck %s --check-prefix=CYCLE
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/nested.js | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc | FileCheck %s --check-prefix=NESTED

# NATIVE-DAG: call_opaque "std::make_shared<ctnative::cell<ctnative::js_num>>"
# NATIVE-DAG: emitc.func @bump_{{[0-9]+}}(%arg0: !emitc.opaque<"std::shared_ptr<ctnative::cell<ctnative::js_num>>">)
# NATIVE-DAG: call_opaque "ctnative::cell_place"
# RECURSIVE: emitc.func @walk_{{[0-9]+}}(%arg0: !emitc.opaque<"std::shared_ptr<ctnative::cell<ctnative::js_num>>">
# RECURSIVE: call @walk_{{[0-9]+}}
# MUTATION: global 'seen' differs
# CYCLE: closure_reason = "it is written into a binding this tier carries by pointer, so the name holds a variable and not one function
# NESTED: closure_reason = "the handler of Promise.prototype.then captures binding 0, which is written after it is captured and reaches it through an enclosing closure

#--- shared.js
var seen = "";
function run() {
    var n = 0;
    function bump() {
        n = n + 100;
    }
    Promise.resolve(1).then(function (v) {
        n = n + v;
        seen = seen + "n" + n;
    });
    Promise.resolve(2).then(function (v) {
        n = n + v;
        seen = seen + "n" + n;
    });
    n = 10;
    bump();
    seen = seen + "s";
}
run();

#--- recursive.js
// Recursive calls forward the same handle, not its payload or its address.
var seen = "";
function run() {
    var n = 0;
    Promise.resolve(1).then(function (v) {
        n = n + v;
        seen = "" + n;
    });
    (function walk(k) {
        if (k > 0) {
            n = n + 1;
            walk(k - 1);
        }
    })(3);
}
run();

#--- expected.cjs
const assert = require("node:assert/strict");
const fs = require("node:fs");
const vm = require("node:vm");
const scope = {};
vm.runInNewContext(fs.readFileSync(process.argv[2], "utf8"), scope);
setTimeout(() => assert.equal(scope.seen, process.argv[3]), 0);

#--- cycle.js
var seen = 0;
function run() {
    var f = 0;
    Promise.resolve(1).then(function () {
        f = function () {
            return f;
        };
        seen = 1;
    });
}
run();

#--- nested.js
var seen = 0;
function run() {
    var n = 0;
    function inner() {
        Promise.resolve(1).then(function () {
            n = n + 1;
            seen = n;
        });
    }
    inner();
    n = 5;
}
run();
