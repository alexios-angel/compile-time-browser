# A refused function that nothing able to run creates or calls is removed
# after admission, with a row saying so, and is counted as removed rather than
# native. Here the page has no jQuery: `globalThis.jQuery` folds to undefined
# (CTJS/Transforms/absent-global-properties.mlir), precomputation drops the
# branch that would register the plugin, and the plugin's function and the
# callback inside it are refused and unreachable. Both go in one walk; the
# rest of the program lowers natively and prints what Node and the VM print,
# with GCC and Clang. The probe reads `globalThis`, not `window`, because the
# VM reference the differential check runs has no window.
#
# The control keeps a refused function that only a refused but reachable
# function creates: the outer function runs, so the closure it makes can too.
#
# RUN: split-file %s %t
# RUN: %node %t/expected.cjs %t/plugin.js
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/plugin.js -o %t/input.mlir
# RUN: ctjs-opt %t/input.mlir --pass-pipeline="builtin.module(ctjs-resolve-globals,ctjs-lift-to-scf,ctnative-lower-to-emitc{observe-globals=true},emitc.func(canonicalize,convert-scf-to-emitc,convert-arith-to-emitc,canonicalize,ctnative-prune-dead-stores,canonicalize))" -o %t/runtime.mlir
# RUN: FileCheck %s --check-prefix=REMOVED --implicit-check-not=ctnative.not_native --implicit-check-not=ctjs.func < %t/runtime.mlir
# RUN: %compilation_unit --cxx g++ --module %t/runtime.mlir --js %t/plugin.js --work %t --name unreachable_gcc --core-build %build
# RUN: %compilation_unit --cxx %dom_clang --module %t/runtime.mlir --js %t/plugin.js --work %t --name unreachable_clang --core-build %build
# RUN: not %compilation_unit --cxx g++ --module %t/runtime.mlir --js %t/plugin.js --work %t --name unreachable_mutation --mutate registered 2>&1 | FileCheck %s --check-prefix=MUTATION
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/kept.js | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc=observe-globals=true | FileCheck %s --check-prefix=KEPT --implicit-check-not=unreachable_refusals
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/plugin.js | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc="optimize=false observe-globals=true" | FileCheck %s --check-prefix=UNOPTIMIZED --implicit-check-not=unreachable_refusals

# REMOVED: ctnative.unreachable_refusals = [{function = "fn$3", reason = "removed: unreachable (no function that can run creates or calls it; it was refused: uses `this`)"}, {function = "fn$4", reason = "removed: unreachable (no function that can run creates or calls it; it was refused: uses `this` - a closure used as a value: {{.*}})"}]
# MUTATION: global 'registered' differs
# KEPT: ctjs.func @fn$2({{.*}}ctnative.not_native = "uses `this`
# UNOPTIMIZED: ctjs.func @fn$3({{.*}}ctnative.not_native =

#--- plugin.js
var registered = 0;
function getjQuery() {
    return globalThis.jQuery && !document.body.hasAttribute("data-bs-no-jquery")
        ? globalThis.jQuery
        : null;
}
function definePlugin(name) {
    var $ = getjQuery();
    if ($) {
        $.fn[name] = function () {
            return this.each(function () {
                return this;
            });
        };
        registered = registered + 1;
    }
    return registered;
}
var plugins = definePlugin("collapse") + definePlugin("modal");

#--- expected.cjs
const assert = require("node:assert/strict");
const fs = require("node:fs");
const vm = require("node:vm");
const scope = {};
vm.runInNewContext(fs.readFileSync(process.argv[2], "utf8"), scope);
assert.equal(scope.plugins, 0);

#--- kept.js
function outer() {
    var self = function () {
        return this;
    };
    return typeof arguments[0] + typeof self;
}
var kept = outer(1);
