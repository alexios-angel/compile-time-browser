# An executor's resolve function captured by a then-handler made in the
# executor, which only calls it with one value, lifts with the handler: the
# handler is bound with a copy of the resolve function, which shares the
# promise and its [[AlreadyResolved]] record, so a call from the microtask
# queue settles the promise the executor made. Its calls join the promise's
# value type, and a call with a promise adopts it. `Promise.resolve()` is a
# promise of undefined. In `late` the handler lifts a round before its
# executor, which waits for the closure it is made in, so the executor finds
# its resolve function already passed to the lifted `then` call. Node, the VM
# and both native builds print "el3shiq1wv6r7": the second executor resolves
# before its handler runs, so the handler's call is ignored.
#
# The negatives keep the resolve rule's refusal: a handler that calls it with
# two values, relays it to a closure of its own, stores it or assigns it; a
# local closure that captures it; an executor that assigns its parameter or
# stores it beside the handler that captures it. A
# then-handler that calls its own value parameter is not calling a resolve
# function, and is refused instead of crashing the lowering.
#
# RUN: split-file %s %t
# RUN: %node %t/expected.cjs %t/captured.js el3shiq1wv6r7
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/captured.js -o %t/input.mlir
# RUN: ctjs-opt %t/input.mlir --pass-pipeline="builtin.module(ctjs-resolve-globals,ctjs-lift-to-scf,ctnative-lower-to-emitc,emitc.func(canonicalize,convert-scf-to-emitc,convert-arith-to-emitc,canonicalize,ctnative-prune-dead-stores,canonicalize))" -o %t/runtime.mlir
# RUN: FileCheck %s --check-prefix=NATIVE --implicit-check-not=ctnative.not_native --implicit-check-not=ctjs.func < %t/runtime.mlir
# RUN: %compilation_unit --cxx g++ --module %t/runtime.mlir --js %t/captured.js --work %t --name captured_gcc --core-build %build
# RUN: %compilation_unit --cxx %dom_clang --module %t/runtime.mlir --js %t/captured.js --work %t --name captured_clang --core-build %build
# RUN: not %compilation_unit --cxx g++ --module %t/runtime.mlir --js %t/captured.js --work %t --name captured_mutation --mutate log --mutate-as string --core-build %build 2>&1 | FileCheck %s --check-prefix=MUTATION
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/two.js | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc | FileCheck %s --check-prefix=REFUSED
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/relay.js | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc | FileCheck %s --check-prefix=REFUSED
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/stored.js | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc | FileCheck %s --check-prefix=REFUSED
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/local.js | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc | FileCheck %s --check-prefix=REFUSED
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/written.js | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc | FileCheck %s --check-prefix=REFUSED
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/assigned.js | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc | FileCheck %s --check-prefix=REFUSED
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/kept.js | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc | FileCheck %s --check-prefix=REFUSED
# RUN: ctjs-translate --ctbrowser-js-to-ctjs %t/value.js | ctjs-opt --ctjs-resolve-globals --ctjs-lift-to-scf --ctnative-lower-to-emitc | FileCheck %s --check-prefix=VALUE

# NATIVE-DAG: call_opaque "std::bind_front"({{.*}}) {{.*}}: (!emitc.opaque<"auto">, !emitc.opaque<"ctnative::promise_resolve_function<ctnative::js_num, ctnative::no_rejection>">
# NATIVE-DAG: call_opaque "ctnative::invoke_callable"({{.*}}) {{.*}}: (!emitc.opaque<"ctnative::promise_resolve_function<ctnative::js_num, ctnative::no_rejection>">, !emitc.opaque<"ctnative::js_promise<ctnative::js_num>">)
# NATIVE-DAG: call_opaque "ctnative::Promise.resolve"({{.*}}) {{.*}}: (!emitc.opaque<"ctnative::nullable_scalar">) -> !emitc.opaque<"ctnative::js_promise<ctnative::nullable_scalar>">
# MUTATION: global 'log' differs
# REFUSED: closure_reason = "the executor of new Promise uses its resolve function other than by calling it with one value
# VALUE: ctnative.not_native = "`ctjs.call` is not native yet"

#--- expected.cjs
const assert = require("node:assert/strict");
const fs = require("node:fs");
const vm = require("node:vm");
const scope = {};
vm.runInNewContext(fs.readFileSync(process.argv[2], "utf8"), scope);
setTimeout(() => assert.equal(scope.log, process.argv[3]), 0);

#--- captured.js
var log = "";
function seven() {
    return new Promise(function (t) {
        t(7);
    });
}
function run() {
    var k = 3;
    var p = new Promise(function (t) {
        Promise.resolve().then(function () {
            log = log + "h";
            t(k * 2);
        });
        log = log + "e";
    });
    p.then(function (v) {
        log = log + "v" + v;
    });
    var q = new Promise(function (t) {
        t(1);
        Promise.resolve().then(function () {
            t(9);
            log = log + "i";
        });
    });
    q.then(function (v) {
        log = log + "q" + v;
    });
    var r = new Promise(function (t) {
        Promise.resolve().then(function () {
            t(seven());
        });
    });
    r.then(function (v) {
        log = log + "r" + v;
    });
    var late = function () {
        new Promise(function (t) {
            Promise.resolve().then(function () {
                t(5);
                log = log + "w";
            });
            log = log + "l" + k;
        });
    };
    late();
    log = log + "s";
}
run();

#--- two.js
var seen = 0;
function run() {
    new Promise(function (t) {
        Promise.resolve().then(function () {
            t(1, 2);
        });
    }).then(function (v) {
        seen = v;
    });
}
run();

#--- relay.js
var seen = 0;
function run() {
    new Promise(function (t) {
        Promise.resolve().then(function () {
            Promise.resolve().then(function () {
                t(1);
            });
        });
    }).then(function (v) {
        seen = v;
    });
}
run();

#--- stored.js
var keep = 0;
function run() {
    new Promise(function (t) {
        Promise.resolve().then(function () {
            keep = t;
        });
    });
}
run();

#--- local.js
var seen = 0;
function run() {
    new Promise(function (t) {
        var f = function () {
            t(1);
        };
        f();
    }).then(function (v) {
        seen = v;
    });
}
run();

#--- written.js
var seen = 0;
function run() {
    new Promise(function (t) {
        Promise.resolve().then(function () {
            t(1);
        });
        t = 5;
    }).then(function (v) {
        seen = v;
    });
}
run();

#--- assigned.js
var seen = 0;
function run() {
    new Promise(function (t) {
        Promise.resolve().then(function () {
            t(1);
            t = 5;
        });
    }).then(function (v) {
        seen = v;
    });
}
run();

#--- kept.js
var keep = 0;
function run() {
    new Promise(function (t) {
        Promise.resolve().then(function () {
            t(1);
        });
        keep = t;
    });
}
run();

#--- value.js
var seen = 0;
function run() {
    Promise.resolve(1).then(function (v) {
        seen = v(2);
    });
}
run();
