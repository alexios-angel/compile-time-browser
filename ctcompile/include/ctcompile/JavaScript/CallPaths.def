/* Every way JavaScript starts running in ctbrowser, as an X-macro table.
 *
 * Phase 0's Call-Path Inventory. It exists because mixed-mode execution is
 * decided ENTRY BY ENTRY: each of these is a place where the AOT backend must
 * either take over or hand off, and an entry nobody listed becomes a bug that
 * appears only under one specific browser callback - a timer, a promise
 * settling, a generator being stepped - long after the code that caused it ran.
 *
 * CT_CALL_PATH(name, signature, canonical, resets_stack, clears_failure,
 *              drains_microtasks, note)
 *
 *   canonical          whether this is the ONE path AOT work should target.
 *                      Phase 3 must route or eliminate every non-canonical one.
 *   resets_stack       clears frames_ and registers_ and repoints program_.
 *                      True only for a TOP-LEVEL entry; doing it from a nested
 *                      one throws away the stack of whoever was running.
 *   clears_failure     resets the failure flag, which belongs to the TURN.
 *   drains_microtasks  runs the promise queue at the end, likewise the turn's.
 *
 * VERIFIED against ctbrowser/lib/Script/vm/call.cpp and vm.hpp at 9521928: the
 * five functions that reach run_loop() are call, run_reentrant, execute,
 * generator_resume and resume, and everything else here is a wrapper over one
 * of them.
 */

/* THE CANONICAL ONE, and the entry every C++ caller uses.
 *
 * PHASE 3 LANDED, and not quite where this row predicted. The prediction was
 * that `context::call` would be where the mixed-mode check belongs; what it is
 * is one of FIVE places that ask the same question, and the question itself
 * moved to `script/dispatch.hpp::enter_compiled` - the one read of
 * `function_proto::aot_entry` in the engine.
 *
 * Five rather than one because the register-window handoff differs: `op::call`
 * reuses the caller's window with no copying, `context::call` sizes its own,
 * and the three top-level entries have no caller at all. Routing them all
 * through one FUNCTION would have meant copying arguments on the interpreter's
 * call path. Routing them all through one DECISION is what this phase actually
 * needed, and is what "one place decides interpreted or native" means here. */
CT_CALL_PATH(/* name */ call,
             /* signature */ "value call(value callable, span<const value> args, value this_value)",
             /* canonical */ true, /* resets_stack */ false, /* clears_failure */ false,
             /* drains_microtasks */ false,
             /* note */ "pushes a frame and runs to its depth; the receiver lives in a C++ local "
             "and is rooted through current_this_")

/* Construction. A separate entry rather than a flag on call() because it also
 * builds the receiver and threads new.target. */
CT_CALL_PATH(/* name */ construct,
             /* signature */ "value construct(value callee, span<const value> args)",
             /* canonical */ false, /* resets_stack */ false, /* clears_failure */ false,
             /* drains_microtasks */ false,
             /* note */ "reaches the VM through call(); pending_new_target_ is a GC root for exactly "
             "the window between the two instructions")

/* THE TOP-LEVEL ENTRY, and the only one that may reset the stack. */
CT_CALL_PATH(/* name */ execute,
             /* signature */ "value execute(const program & prog, const function_proto & entry)",
             /* canonical */ false, /* resets_stack */ true, /* clears_failure */ false,
             /* drains_microtasks */ false,
             /* note */ "clears frames_ and registers_ and points program_ at its argument")

/* A whole turn: execute() plus the bookkeeping that belongs to a turn rather
 * than to a program. */
CT_CALL_PATH(/* name */ run, /* signature */ "run_result run(const program & prog)",
             /* canonical */ false, /* resets_stack */ true, /* clears_failure */ true,
             /* drains_microtasks */ true, /* note */ "the ordinary way a page's script runs")

/* A program run from INSIDE a running one - an imported module evaluating
 * while its importer is mid-statement. */
CT_CALL_PATH(/* name */ run_reentrant,
             /* signature */ "run_result run_reentrant(const program & prog)",
             /* canonical */ false, /* resets_stack */ false, /* clears_failure */ false,
             /* drains_microtasks */ false,
             /* note */ "saves and restores program_ so the importer's later calls still index its own "
             "function table; deliberately does NOT drain - that would run the importer's "
             "pending handlers before its next statement")

/* `new Function(...)` evaluating its own body mid-statement. Not execute(),
 * for the same reason run_reentrant is not: it would discard the caller's
 * stack. Implemented as a closure over the program's entry, called normally. */
CT_CALL_PATH(/* name */ run_nested, /* signature */ "value run_nested(const program & prog)",
             /* canonical */ false, /* resets_stack */ false, /* clears_failure */ false,
             /* drains_microtasks */ false,
             /* note */ "a wrapper over call(); the closure's `owner` is what makes every op::closure "
             "inside it index the right function table")

/* SUSPENSION, and the two paths that resume it. These are the ones Phase 14
 * has to reconcile with AOT frames: coroutine_object saves a frame by copying
 * its REGISTER WINDOW out of the flat registers_ vector, and an AOT frame has
 * no register window to copy. */
CT_CALL_PATH(/* name */ generator_resume,
             /* signature */ "value generator_resume(value generator, value sent, resume_mode how)",
             /* canonical */ false, /* resets_stack */ false, /* clears_failure */ false,
             /* drains_microtasks */ false,
             /* note */ "next/throw/return on a generator; restores a saved register window and runs "
             "to the saved depth")
CT_CALL_PATH(/* name */ resume,
             /* signature */ "void resume(value coroutine, value with, bool rejected)",
             /* canonical */ false, /* resets_stack */ false, /* clears_failure */ false,
             /* drains_microtasks */ false,
             /* note */ "an await settling; same register-window restore, driven by the microtask queue")

/* The queue itself. Not a VM entry in its own right - it calls call() in a
 * loop - but it IS a place script starts running with no syntactic cause, and
 * a bounded one: a job that queues a job forever raises rather than hangs. */
CT_CALL_PATH(/* name */ drain_microtasks, /* signature */ "void drain_microtasks()",
             /* canonical */ false, /* resets_stack */ false, /* clears_failure */ false,
             /* drains_microtasks */ true,
             /* note */ "FIFO, and a job queued BY a job runs in the same drain, which is what makes "
             "a promise chain complete before the turn ends")

/* Class field initialisers, run as part of construction but compiled as their
 * own bodies. */
CT_CALL_PATH(/* name */ run_field_initialisers,
             /* signature */ "void run_field_initialisers(value constructor, value self)",
             /* canonical */ false, /* resets_stack */ false, /* clears_failure */ false,
             /* drains_microtasks */ false,
             /* note */ "reaches the VM through call(), once per field, with self as the receiver")

/* Module instantiation. Runs no user code itself - it creates export cells
 * before anything evaluates, which is the specification's instantiate-then-
 * evaluate split - but it is listed because Phase 15 serializes its output and
 * a compiled module image has to reproduce the same cells. */
CT_CALL_PATH(/* name */ instantiate_module,
             /* signature */ "void instantiate_module(const program & prog, module_record & into)",
             /* canonical */ false, /* resets_stack */ false, /* clears_failure */ false,
             /* drains_microtasks */ false,
             /* note */ "no user code; creates the bindings a cyclic importer needs before evaluation")
