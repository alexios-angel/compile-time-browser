/* Every place a call frame ENDS, as an X-macro table - ctcompile Phase 55O.
 *
 * The escape oracle adjudicates a frame's allocations at the moment the frame
 * ends: that is when "still reachable from a root" becomes the answer to "did
 * it escape". So every path that truncates `context::frames_` is either a
 * hook - the oracle sees the frame go - or a documented hole whose records are
 * reported UNCHECKED, never confined. This table is the list, and the escape
 * self-test (ctcompile/test/TypeOracle.cpp) asserts its shape so another
 * exit path cannot be added without deciding which it is.
 *
 * CT_FRAME_END(name, where, hooked, note)
 *
 *   name     the row, as the self-test and this file's readers refer to it
 *   where    the site, cited BY NAME first and by file:line second. The line
 *            is checked by check-def-citations.cmake (inside the file, no
 *            more than that) and is the one at the commit that wrote the row;
 *            the name is what to search for when it has moved.
 *   hooked   1 if the oracle's hook runs there, 0 if the records of a frame
 *            ending here are UNCHECKED
 *   note     what ends the frame, and why the hook is or is not there
 *
 * Three hooked paths cover interpreted returns, caught throws, and compiled
 * returns with an explicit result handoff. Compiled observations retain
 * `compiled_pc`, never a bytecode PC derived from a catch-pad id; mixed
 * unwinds still fold compiled records as UNCHECKED.
 * The six unhooked paths are suspensions (the frame is copied into a coroutine and
 * comes back as a NEW frame with a serial of its own), abandonments after a
 * failure nothing caught, a fresh top level clearing a dirty stack, and the
 * legacy compiled exit without a result handoff. The two compiled rows name
 * the observed and unobserved branches of the same release helper.
 */

CT_FRAME_END(
    /* name */ ret,
    /* where */ "run_loop.cpp VM_CASE(ret)/VM_CASE(ret_undef): VM_POP_FRAME (run_loop.cpp:774)",
    /* hooked */ 1,
    /* note */
    "after frames_.pop_back(), before the result lands in the caller's register; "
    "the return value is rooted by the hook through temporaries_ while it walks")
CT_FRAME_END(
    /* name */ unwind,
    /* where */ "vm.hpp context::unwind_to_handler: frames_.resize(h.frame + 1) (vm.hpp:1519)",
    /* hooked */ 1,
    /* note */
    "before the resize, so the ending frames are inspectable; thrown_ is still set "
    "and is cleared only after the landing write, so it is a root here; "
    "compiled allocations are folded as UNCHECKED")
CT_FRAME_END(/* name */ await,
             /* where */ "run_loop.cpp VM_CASE(await_value): frames_.pop_back() (run_loop.cpp:900)",
             /* hooked */ 0,
             /* note */
             "the frame's window is copied into a coroutine_object first and is traced from "
             "the heap; its records stay pending and are reported UNCHECKED")
CT_FRAME_END(/* name */ yield,
             /* where */ "run_loop.cpp VM_CASE(yield_value): frames_.pop_back() (run_loop.cpp:956)",
             /* hooked */ 0,
             /* note */ "the window is copied into the generator's coroutine_object; same as await")
CT_FRAME_END(/* name */ execute_clear,
             /* where */ "call/run.cpp context::execute: frames_.clear()",
             /* hooked */ 0,
             /* note */
             "a new top level clears whatever a raise() left on the stack; those frames' "
             "records were already pending and stay UNCHECKED")
CT_FRAME_END(
    /* name */ gen_abandon,
    /* where */
    "call/coroutines.cpp context::generator_resume: while (frames_.size() > stop) pop_back",
    /* hooked */ 0,
    /* note */
    "a generator resumed with .throw() whose body caught nothing; the unwinder "
    "already ran and found no handler")
CT_FRAME_END(
    /* name */ resume_abandon,
    /* where */ "call/coroutines.cpp context::resume: while (frames_.size() > stop) pop_back",
    /* hooked */ 0,
    /* note */ "a rejected await nothing caught; the async function's own promise rejects")
CT_FRAME_END(/* name */ aot_leave,
             /* where */
             "aot_bridge/frames.cpp aot_bridge::leave: cx.frames_.resize(held.frame_index)",
             /* hooked */ 0,
             /* note */
             "legacy exits, failed exits and foreign-frame cleanup lack a valid result handoff; "
             "their compiled allocations remain UNCHECKED")
CT_FRAME_END(/* name */ aot_return,
             /* where */ "aot_bridge/frames.cpp ct_aot_leave_return: aot_bridge::leave",
             /* hooked */ 1,
             /* note */
             "a normal compiled return passes the constructor-normalized result; the frame "
             "is removed before a bounded mark with that value rooted through temporaries; "
             "compiled_pc still has no static source attribution")
