# Files clang-format must not touch. Patterns are relative to this file and
# use the .gitignore glob syntax; clang-format 18 and later read it.
#
# Two categories, and the distinction matters:
#
# GENERATED. Reformatting these changes nothing that survives the next run of
# the generator, and makes the diff between "the generator changed" and "the
# formatter ran" impossible to read.
include/ctbrowser/font8x8.hpp
src/raster/font8x8.hpp
src/dom/entities.hpp
src/gpu/shaders/tile_spv.hpp
examples/*.inc
examples-v2/*.inc

