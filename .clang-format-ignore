# Files clang-format must not touch. Patterns are relative to this file and
# use the .gitignore glob syntax; clang-format 18 and later read it.
#
# Two categories, and the distinction matters:
#
# GENERATED. Reformatting these changes nothing that survives the next run of
# the generator, and makes the diff between "the generator changed" and "the
# formatter ran" impossible to read.
ctbrowser/include/ctbrowser/raster/text/font8x8.hpp
ctbrowser/include/ctbrowser/dom/entities.hpp
ctbrowser/include/ctbrowser/gpu/shaders/tile_spv.hpp

# mlir-tblgen's output, which is generated for the same reason and is not
# committed either (Principle 10 - generated files are build artifacts). Listed
# BEFORE the first generator runs rather than after someone reformats a build
# directory, which is the mistake this entry exists to prevent.
*.h.inc
*.cpp.inc

# Submodules and the fetched toolchain are separate projects entirely.
third-party/*
tools/llvm-mingw/*
tools/clang-std-embed/*

# A port of ctjs's backtracking matcher. Reformatting it would make "the
# port changed" and "the formatter ran" indistinguishable in the diff.
ctbrowser/include/ctbrowser/script/regex.hpp

# VENDORED, which is the third category and the strictest. This is upstream's
# EmitC emitter forked at llvmorg-22.1.8, kept so that `diff` against upstream
# is three hunks and re-syncing at the next LLVM bump is mechanical. Every line
# reformatted toward this project's style is a line that has to be re-applied by
# hand forever. See ctcompile/lib/Target/Cpp/TranslateToCpp.cpp.
#
# TranslateRegistration.cpp is NOT here: it is rewritten rather than vendored -
# a different namespace, a different function name and our own comments - so it
# is ours to format.
ctcompile/lib/Target/Cpp/TranslateToCpp.cpp
