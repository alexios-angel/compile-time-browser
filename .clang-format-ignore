# the next update reviewable, and NOTICE names these by name.
include/ctbrowser/stb_image.h
include/ctbrowser/stb_image_write.h

# Submodules and the fetched toolchain are separate projects entirely.
external/*
tools/llvm-mingw/*
tools/clang-std-embed/*
