{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "${sourceDir}/tools/clang-std-embed/bin/clang++"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer (the thread-safe DOM's real test)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CTBROWSER_BUILD_EXAMPLES": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_CXX_COMPILER": "${sourceDir}/tools/clang-std-embed/bin/clang++"
      }
    },
    {
      "name": "asan",
      "displayName": "Address/UB sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CTBROWSER_BUILD_EXAMPLES": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_CXX_COMPILER": "${sourceDir}/tools/clang-std-embed/bin/clang++"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows x86_64 cross (llvm-mingw)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows",
      "toolchainFile": "${sourceDir}/cmake/toolchain-windows-x86_64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CTBROWSER_BUILD_TESTS": "ON",
        "CTBROWSER_EMBED_FONTS": "ON",
        "CTBROWSER_WINDOWS_CONSOLE": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "windows", "configurePreset": "windows" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    }
  ]
}
