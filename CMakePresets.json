{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja Release (std::embed clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "fetch",
      "displayName": "Ninja Release + compile-time fetches",
      "inherits": "default",
      "cacheVariables": {
        "CTBROWSER_EXAMPLES_FETCH": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "v2 + ThreadSanitizer (the thread-safe DOM's real test)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CTBROWSER_BUILD_EXAMPLES": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_CXX_COMPILER": "/home/linuxbrew/.linuxbrew/bin/clang++",
        "CTBROWSER_BUILD_V1": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "v2 + Address/UB sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CTBROWSER_BUILD_EXAMPLES": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_CXX_COMPILER": "/home/linuxbrew/.linuxbrew/bin/clang++",
        "CTBROWSER_BUILD_V1": "OFF"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows x86_64 cross (llvm-mingw std::embed)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows",
      "toolchainFile": "${sourceDir}/cmake/toolchain-windows-x86_64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CTBROWSER_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows-fetch",
      "displayName": "Windows cross + compile-time fetches",
      "inherits": "windows",
      "cacheVariables": {
        "CTBROWSER_EXAMPLES_FETCH": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "fetch",
      "configurePreset": "fetch"
    },
    {
      "name": "windows",
      "configurePreset": "windows"
    },
    {
      "name": "windows-fetch",
      "configurePreset": "windows-fetch"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fetch",
      "configurePreset": "fetch",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
