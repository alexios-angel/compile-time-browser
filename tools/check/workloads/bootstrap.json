{
  "title": "Bootstrap 5 (ctbrowser/vendor/bootstrap)",
  "scripts": [
    "ctbrowser/vendor/bootstrap/bootstrap.bundle.js",
    {"pattern": "tools/check/css-dump.js", "string_entries": ["css_dump_table"]}
  ],
  "pages": ["ctbrowser/examples/pages/bootstrap-*.html"],
  "ctests": ["bootstrap_layout", "css_syntax"],
  "options": {
    "build-native": {"dom": true},
    "native-run": {
      "runner": ["ctest", "--test-dir", "{build}", "--output-on-failure", "--no-tests=error",
                 "-R", "^{test}[.]native$"]
    }
  }
}
