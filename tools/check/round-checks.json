{
  "about": "tools/check/round-checks.py's mapping from changed paths to the focused checks that cover them. `prefixes`: a changed file under `path` selects these lit paths (relative to ctcompile/test; a trailing / means a directory), CTests (exact names), build targets and commands. The longest matching prefix wins, so a shared helper can be given a narrow entry under a broad one. A changed lit test or test helper under ctcompile/test with no entry selects itself (a test file) or its directory (a helper). `always` is added whenever anything is selected. Edit freely; round-checks.py --self-test does not read this file.",
  "always": {
    "lit": ["CTNative/Lowering/Objects/", "CTNative/Lowering/Closures/", "CTNative/Optimization/",
            "CTNative/Fixtures/"],
    "targets": ["ctjs-opt", "ctjs-translate", "ctcompile-tool", "ctcompile-test-native-reference",
                "ctcompile-fixture-inputs"],
    "commands": ["python3 tools/check/check-workload.py fixture"],
    "notes": ["CTNative/Fixtures reads build-time pipeline modules: build ctcompile-fixture-inputs, or the Fixtures tests fail on stale inputs (ctcompile/test/README.md)."]
  },
  "prefixes": [
    {"path": "ctcompile/lib/CTNative/Lowering/", "lit": ["CTNative/Lowering/"]},
    {"path": "ctcompile/lib/CTNative/Lowering/EmitC/", "lit": ["CTNative/Lowering/", "Target/Cpp/"]},
    {"path": "ctcompile/lib/CTNative/Lowering/ClosureLifting/",
     "lit": ["CTNative/Lowering/", "CTNative/Ownership/"]},
    {"path": "ctcompile/lib/CTNative/Analysis/", "lit": ["CTNative/Lowering/", "Analysis/"],
     "ctests": ["ctcompile_type_inference"], "targets": ["ctcompile-test-type-inference"]},
    {"path": "ctcompile/lib/CTNative/Reachability/", "lit": ["CTNative/Lowering/"]},
    {"path": "ctcompile/lib/CTNative/HostContract/", "lit": ["CTNative/HostContract/"]},
    {"path": "ctcompile/lib/CTNative/PartialEvaluation/", "lit": ["CTNative/PartialEvaluation/"]},
    {"path": "ctcompile/lib/CTNative/Specialization/", "lit": ["CTNative/Specialization/"]},
    {"path": "ctcompile/lib/CTNative/Supercompilation/", "lit": ["CTNative/Supercompilation/"]},
    {"path": "ctcompile/lib/CTNative/BindingTime/", "lit": ["CTNative/BindingTime/"]},
    {"path": "ctcompile/lib/CTNative/IR/", "lit": ["CTNative/IR/", "CTNative/Lowering/"]},
    {"path": "ctcompile/include/ctcompile/CTNative/IR/", "lit": ["CTNative/IR/", "CTNative/Lowering/"]},
    {"path": "ctcompile/include/ctcompile/CTNative/Analysis/", "lit": ["CTNative/Lowering/"]},
    {"path": "ctcompile/include/ctcompile/CTNative/Runtime/", "lit": ["CTNative/Browser/page/"],
     "ctests": ["ctcompile_native_runtime"], "targets": ["ctcompile-test-native-runtime"]},
    {"path": "ctcompile/lib/CTJS/", "lit": ["CTJS/"]},
    {"path": "ctcompile/lib/Target/Cpp/", "lit": ["Target/Cpp/"]},
    {"path": "ctcompile/test/Runtime/", "ctests": ["ctcompile_native_runtime"],
     "targets": ["ctcompile-test-native-runtime"]},
    {"path": "ctcompile/test/lit.cfg.py", "lit": []},
    {"path": "ctcompile/test/cmake/", "lit": []},
    {"path": "ctcompile/test/CTNative/harness.py", "lit": []},
    {"path": "ctcompile/test/Target/Cpp/harness.py", "lit": []},
    {"path": "ctcompile/test/CTNative/Checks/", "lit": []},
    {"path": "tools/check/check-workload.py",
     "commands": ["python3 tools/check/check-workload.py --self-test"]},
    {"path": "tools/check/native-claims.py",
     "commands": ["python3 tools/check/native-claims.py --self-test"],
     "ctests": ["ctcompile_native_claims_bootstrap", "ctcompile_native_claims_default_bootstrap"]},
    {"path": "tools/check/round-checks", "commands": ["python3 tools/check/round-checks.py --self-test"]}
  ]
}
