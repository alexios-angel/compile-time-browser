# Dependencies for compile-time-browser, converged by tools/remote-build.sh.
#
# BREW RATHER THAN APT, and the reason is versions. Ubuntu 24.04 LTS ships
# libjpeg-turbo 2.1.5, which does not have the API this engine decodes JPEG
# with, and a Boost that packages `boost_url` separately from libboost-dev - so
# a devbox build stopped dead twice on dependencies that were "installed".
# Brew ships current versions AND the same ones the development machine has,
# which keeps the two in step; apt stays right for the box's own furniture
# (build-essential, git, rsync, the toolchain).
brew "glm"   # >=1.0: constexpr vector math. Predates the compile-time engine's
             # retirement and nothing in the tree includes it today; kept
             # because the devbox provisions from this file for several repos.

# SVG. PIN THE VERSIONS TO THE WINDOWS SYSROOT'S - ctbrowser/test/golden/svg.ppm is one
# image byte-compared on both platforms, and ../llvm-mingw/build-sdl3.sh put
# plutosvg 0.0.8 / plutovg 1.3.3 in the mingw sysroot for SDL3_ttf's colour
# glyphs. A host that drifts ahead makes the golden platform-dependent, so
# ctbrowser/lib/Raster/CMakeLists.txt warns when it does.
brew "plutosvg"   # 0.0.8: SVG document -> plutovg canvas
brew "plutovg"    # 1.3.3: the rasteriser under it, pulled in as a dependency
                  # anyway - named so the pin is visible

# The compiled libraries the engine LINKS. All three were apt packages until
# 2026-08-01; see the note at the top for why they are not any more.
brew "boost"          # Boost.URL - COMPILED, not header-only, since 1.87. One
                      # formula rather than apt's split libboost-dev /
                      # libboost-url-dev, which is how a box ended up with the
                      # first and not the second.
brew "libpng"         # PNG, decoded inside the SDL-free engine
brew "jpeg-turbo"     # JPEG, likewise. apt's 2.1.5 predates the tj3_* API;
                      # brew's is 3.x. The decoder is written to the 2.x
                      # spelling anyway so it builds against either, but the
                      # version gap is what moved this file off apt.

# THE ALLOCATOR, backing operator new/delete (ctbrowser/lib/Core/allocator.cpp). Allocator
# traffic was ~4.8% of a Phaser frame and this is the one hot path a library
# answered outright - see ctbrowser/docs/performance.md, which also records why jemalloc
# lost: a tie on wall clock, and no usable Windows cross-build.
#
# PIN IT TO THE WINDOWS SYSROOT'S, exactly as plutosvg is pinned:
# tools/mingw/build-mimalloc-mingw.sh builds v3.4.3 into the mingw sysroot, and two
# platforms on two allocator versions is the kind of difference that makes a
# byte-compared golden disagree for a reason nobody can see.
brew "mimalloc"       # 3.4.3

# base64, and eventually UTF-8 validation. Backs base64_decode's fast path at
# 42x the hand-written loop; that loop stays as the fallback for input simdutf's
# strict mode refuses, so the leniency contract is unchanged.
# PIN IT TO THE WINDOWS SYSROOT'S, as with mimalloc and plutosvg:
# tools/mingw/build-simdutf-mingw.sh builds the same version there.
brew "simdutf"        # 9.0.0

# REAL FONT METRICS, which is a PARITY dependency rather than a rendering one.
# Text measurement lives behind SDL3_ttf (ctbrowser/include/ctbrowser/raster/text/ttf.hpp,
# the one deliberate SDL exception), and without it every glyph advances a full em
# in the 8x8 bitmap font - 2.5x Chrome's width. That does not just look different,
# it WRAPS differently: Chrome fits `width 200, p-3, border` on one line in 166px
# and the bitmap font takes three, so every height and every @y below it differs
# for a reason that has nothing to do with layout. It was the single largest
# remaining cause in tools/check/css-parity.py, and compare.py already points
# Chrome at this repository's own faces so the two sides can agree.
#
# The goldens are unaffected: tools/check/check-render.cmake sets
# CTBROWSER_FONTS=font8x8 explicitly, because two FreeType versions do not
# rasterize identically and a byte comparison across Linux and Windows has to ask
# for the bitmap font. This makes real text AVAILABLE, not mandatory.
brew "sdl3_ttf"   # and sdl3 beneath it, as a dependency

# LLVM AND MLIR, for ctcompile's compiler pipeline ONLY.
#
# NOT A RUNTIME DEPENDENCY, and the distinction is Principle 8 rather than
# tidiness: `ctbrowser` builds and its whole suite runs with none of this
# installed, and ctcompile's own CMakeLists keeps MLIR behind
# CTCOMPILE_ENABLE_MLIR, OFF by default, so that a box which happens to have
# LLVM does not silently start requiring 2 GB of it. This line makes the
# dependency AVAILABLE on a provisioned box; it does not make it required.
#
# PINNED AT 22 by cmake/LLVMVersion.cmake and checked at configure time. ODS,
# PDLL and pass-generation syntax move between releases, so an upgrade is its
# own change rather than a surprise inside mlir-tblgen; see
# ctcompile/docs/LLVMUpgrade.md.
# 23.1.0 (cmake/LLVMVersion.cmake). PINNED ON THE BOX with `brew pin llvm`: on
# 2026-09-02 a `brew bundle install` that ran for an unrelated formula floated
# this from 22.1.8 to 23.1.0 under a build, and the pin is what stops the next
# one. Bumping the major is its own change - ctcompile/docs/LLVMUpgrade.md.
brew "llvm"   # 23.1.0: clang, LLVM, MLIR, mlir-tblgen, FileCheck

# lit IS NOT IN THIS FILE and cannot be, which is worth saying here rather than
# leaving to be rediscovered. brew's llvm bottle ships FileCheck but no
# llvm-lit, Ubuntu's python is PEP 668 managed so `pip install lit` refuses,
# and brew's python refuses for the same reason. ctcompile's lit suite is run
# from a virtual environment:
#
#     python3 -m venv ~/.lit-venv && ~/.lit-venv/bin/pip install lit
#
# ctcompile/test/CMakeLists.txt finds it there or reports that check-ctcompile
# is unavailable, rather than silently running no tests.
