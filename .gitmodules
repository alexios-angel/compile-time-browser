# The two submodule NAMES still say `external/`, which is where these lived
# before the monorepo split, and that is deliberate. A name is not a path: git
# uses it for `.git/modules/<name>` and for the `submodule.<name>.*` config
# keys, so renaming one means moving the module directory, rewriting the
# `gitdir:` line in the submodule's own `.git` file and the `worktree =` line in
# its config, in every existing clone. The paths below are what matters and they
# are correct; the names are local bookkeeping that no checkout reads.
[submodule "external/compile-time-javascript"]
	path = third-party/compile-time-javascript
	url = https://github.com/alexios-angel/compile-time-javascript.git
[submodule "external/compile-time-css"]
	path = third-party/compile-time-css
	url = https://github.com/alexios-angel/compile-time-css.git
