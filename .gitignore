# Whitelist: everything at the repository root is ignored unless it is named
# below. That covers build trees (/build*/), editor and agent state (/.claude/,
# /.c-review-results/), generated files and stray screenshots, profiles or logs
# from tools run by hand. Directories carry their own rules in their own
# .gitignore, which take precedence over these.

*
!/.gitignore

# A directory has to be re-included on its own line BEFORE its contents:
# git never descends into an excluded directory, so "!/x/**" alone re-includes
# nothing.
!/cmake/
!/cmake/**
!/ctbrowser/
!/ctbrowser/**
!/ctcompile/
!/ctcompile/**
!/third-party/
!/third-party/**
!/tools/
!/tools/**

!/.clang-format
!/.clang-format-ignore
!/.gitmodules
!/.jsbeautifyrc
!/CLAUDE.md
!/LICENSE
!/NOTICE
!/pyproject.toml
!/README.md

# Bytecode from importing a Python tool or test driver as a module; the
# re-included directories above would otherwise show it.
__pycache__/
