/* EVERY BYTECODE OPERATION, ONCE, WITH WHAT AN AHEAD-OF-TIME COMPILER HAS TO
 * KNOW ABOUT IT.
 *
 * CT_OPCODE(name, a_kind, b_kind, c_kind,
 *           writes_a, allocates, may_throw, may_reenter, is_safepoint,
 *           may_suspend, resumable, impl)
 *
 * THE OPERANDS. This is a REGISTER machine: an instruction is eight bytes, an
 * `op` and three uint16 operands NAMED a, b AND c in the encoding, and b and c
 * can be read as ONE 32-bit field through bx() (unsigned) or sbx() (signed).
 * There is no stack-effect column because there is no stack.
 *
 * a_kind/b_kind/c_kind say HOW EACH SLOT IS ENCODED, which is the only thing
 * that is constant across opcodes. THE ROLE IS NOT: `a` is the destination for
 * get_prop and the TARGET for set_prop, `b` is the object for get_prop and the
 * KEY for has_property. Each row's roles are in its own comment. Each kind is
 * one of:
 *
 *     reg      a frame slot index
 *     kidx     an index into function_proto::constants
 *     sidx     an index into function_proto::strings
 *     nidx     an index into function_proto::names
 *     fidx     an index into program::functions - NOT the proto's own tables
 *     jump     a signed displacement, read with sbx()
 *     count    a literal count or flag, not an index
 *     bx_hi    this operand is the high half of the preceding bx() field
 *     unused   the handler never reads it
 *
 * kidx, sidx, nidx and fidx are SEPARATE kinds because a bounds check
 * generated from the column must check the right table.
 *
 * THE BEHAVIOUR COLUMNS, and these definitions are what the rows were derived
 * against - not the opcode's name:
 *
 *     writes_a      the handler stores a result into register a
 *     allocates     it can allocate a GC-visible object on SOME path
 *     may_throw     it can raise - see the two-tier note below
 *     may_reenter   it can run USER JAVASCRIPT before it finishes
 *     is_safepoint  a collection can happen inside it; == allocates||may_reenter
 *     may_suspend   it can suspend the frame (await/yield)
 *     resumable     execution can RESUME at this instruction after a suspension
 *     impl          where the semantics live, or "inline"
 *
 * TWO TIERS OF FAILURE, and an AOT backend must keep them apart. `raise()` sets
 * the failure flag and NO try/catch can see it - the allocation ceiling and a
 * missing module are raises. `thrown_` plus unwind_to_handler is the catchable
 * path. Both set may_throw here; only the second is a JavaScript exception.
 *
 * may_reenter IS THE COLUMN THAT COSTS MONEY IF IT IS WRONG: arithmetic
 * re-enters through valueOf, a property read through an accessor or a proxy
 * trap, and `throw_value` because describing an UNCAUGHT throw reads .name
 * and .message off the thrown object.
 *
 * is_safepoint IS A CONTRACT, NOT AN OBSERVATION. In a production run the
 * collector runs only from browser::tick, between callbacks; under
 * context::set_gc_stress it collects at every safepoint, which is what makes
 * the rooting discipline testable.
 *
 * RESUMABLE IS A PROPERTY OF CODE LAYOUT: the resume ip is the instruction
 * AFTER an await_value/yield_value, and the compiler emits every opcode
 * immediately after its last operand's code, so an AOT backend must be able to
 * place a resume label at ANY instruction boundary - no cross-instruction
 * value may live only in a machine register there.
 *
 * Every row was derived from the handler in lib/Script/vm/run_loop.cpp and
 * whatever it delegates to. Where a row disagrees with the opcode's name, a
 * note says so - those disagreements are the most valuable thing in this table.
 *
 * THIS FILE IS THE ONE LIST. run_loop.cpp's dispatch table is built from it, so
 * an opcode added to the enum without a line here fails the BUILD rather than
 * becoming a null entry and a jump to address zero in the computed-goto build.
 */

/* The only pool it reads is `constants`, which never holds a heap pointer,
 * so an AOT backend can materialize these as C++ literals with no runtime
 * pool. `constants[bx()]` is not bounds-checked. */
CT_OPCODE(/* name */ load_const, /* a_kind */ reg, /* b_kind */ kidx, /* c_kind */ bx_hi, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* Reads `strings`, NOT `constants`. The memo is per RUN: context::execute
 * clears string_cache_ and bigint_cache_ on every top-level program, so a
 * second <script> re-allocates every literal. Within one run the identity is
 * stable and collect() roots the cache. */
CT_OPCODE(/* name */ load_string, /* a_kind */ reg, /* b_kind */ sidx, /* c_kind */ bx_hi, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline; vm.hpp:context::string")

/* A literal the lexer accepted but that is not an integer (`1.5n`) does NOT
 * throw - 0n is substituted. Same per-run cache lifetime as load_string. */
CT_OPCODE(/* name */ load_bigint, /* a_kind */ reg, /* b_kind */ sidx, /* c_kind */ bx_hi, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "inline; bigint.hpp:bigint_from_literal + vm.hpp:context::allocate<bigint_object>")

/* Sits at ip 0 of many bodies, so an AOT backend needs entry labels here on
 * both the normal and the resume path. */
CT_OPCODE(/* name */ load_undef, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

CT_OPCODE(/* name */ load_null, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* Not the only way `true` reaches a register - compile_expr also emits
 * load_const with value::boolean(true) - so an AOT backend must handle
 * booleans arriving through load_const too. */
CT_OPCODE(/* name */ load_true, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* value::boolean(false) also arrives through load_const. */
CT_OPCODE(/* name */ load_false, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* The commonest resume target in the whole instruction set. On entry to it
 * the awaited value has already been written into the SUSPENDING
 * instruction's register a by context::resume or generator_resume - so the
 * AOT entry label must be placed before the move and must assume its source
 * register was filled by the runtime, not by the previous native
 * instruction. */
CT_OPCODE(/* name */ move, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* Indexes `names`, not `constants`. The binding table first; a miss asks
 * the embedder's undeclared-name hook, then the global object (own and
 * inherited - the global environment's object record), and a name that is
 * nowhere THROWS ReferenceError (6.2.5.5 GetValue) - EXCEPT when the very
 * next instruction is type_of reading this one's register a, which is how
 * the compiler spells `typeof foo` and the one read that is silent (13.5.3
 * step 2): the run loop peeks, and a backend must lower a load_global whose
 * only consumer is typeof through ct_aot_global_get_soft. may_reenter and
 * is_safepoint because the global object is a proxy whose traps run. */
CT_OPCODE(/* name */ get_global, /* a_kind */ reg, /* b_kind */ nidx, /* c_kind */ bx_hi, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "vm.hpp:context::global_or_named")

/* a is the SOURCE, not a destination - writes_a is false. Indexes `names`.
 * The write bypasses any accessor a binding layer mirrors globals through. */
CT_OPCODE(/* name */ set_global, /* a_kind */ reg, /* b_kind */ nidx, /* c_kind */ bx_hi, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* a is read AND written - the only in-out register operand in this set - so
 * an AOT backend cannot treat it as a pure def, and on the resume path the
 * value it boxes was written by the runtime, not by the preceding native
 * instruction. may_throw is only the allocation ceiling, which is a raise and
 * NOT catchable by JS try/catch. */
CT_OPCODE(/* name */ new_cell, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "inline; vm.hpp:context::allocate<cell_object>")

/* A non-cell in b is not a fault: it yields undefined silently. This is NOT
 * a TDZ check either - an uninitialised let reads as undefined. */
CT_OPCODE(/* name */ cell_get, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* writes_a is FALSE despite a being the first operand: a holds the cell and
 * is only read. If a is not a cell the store is silently dropped. No write
 * barrier exists or is needed: collect() is a full mark from precise roots. */
CT_OPCODE(/* name */ cell_set, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* b is NOT a frame slot: it indexes the running closure's upvalue vector.
 * The column vocabulary has no 'upvalue index', so 'count' is the least wrong
 * kind - an AOT backend must not renumber it with the register allocator.
 * Out-of-range or non-cell entries silently give undefined. */
CT_OPCODE(/* name */ get_upvalue, /* a_kind */ reg, /* b_kind */ count, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* THE BIGGEST OPERAND TRAP IN THIS SET: a is an UPVALUE INDEX, not a frame
 * slot - the only opcode whose a operand is not a register - and writes_a is
 * false. An AOT backend that assumes 'a is always a reg' will renumber this
 * during register allocation and corrupt closure state. Out-of-range index
 * or a non-cell entry drops the write silently. */
CT_OPCODE(/* name */ set_upvalue, /* a_kind */ count, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* op::add is not source `+`: compile_binary maps `+` to add_generic, and
 * op::add comes only from `++` and three internal counters. It is the ONE
 * arithmetic op using static to_number rather than to_number_value, so `x++`
 * on {valueOf:()=>3} is NaN and never runs user code. Needs a resume label
 * because a loop counter sits behind an awaiting/yielding body. */
CT_OPCODE(/* name */ add, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "vm/coerce.cpp:bigint_binary + vm/coerce.cpp:to_number (static)")

/* In every emitted concat, in.b is the ACCUMULATOR: dst is seeded by
 * `move dst, <string>` before any concat, and to_string of a string calls
 * nothing, so only ONE of the two to_string calls can run user JS. Emitted
 * only by template literals; source `+` never reaches it. */
CT_OPCODE(/* name */ concat, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "vm/coerce.cpp:to_string")

/* What the compiler emits for every source-level `+`. The ToPrimitive step
 * is sequenced left-then-right, but the two to_string calls that follow are
 * indeterminately sequenced and BOTH run user code when valueOf and toString
 * each return an object. The operands are held in C++ locals, which the
 * collector does not root: safe only because nothing collects inside a
 * handler outside gc_stress. */
CT_OPCODE(/* name */ add_generic, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "vm/coerce.cpp:to_primitive (+ to_string, bigint_binary, to_number)")

/* The two to_number_value calls are operands of a built-in `-` and are
 * indeterminately sequenced (the spec requires left first); each can run
 * user JS. `--` also emits sub. */
CT_OPCODE(/* name */ sub, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "vm/coerce.cpp:to_number_value (+ vm/coerce.cpp:bigint_binary)")

/* Same indeterminate-sequencing note as sub. Also emitted for `*=`. */
CT_OPCODE(/* name */ mul, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "vm/coerce.cpp:to_number_value (+ vm/coerce.cpp:bigint_binary)")

/* Division by zero is asymmetric and the opcode name hides it: `1/0` on the
 * Number path is Infinity and throws nothing, `1n/0n` is a catchable
 * RangeError. Same sequencing note as sub. */
CT_OPCODE(/* name */ div, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "vm/coerce.cpp:to_number_value (+ vm/coerce.cpp:bigint_binary)")

/* std::fmod, not integer remainder - correct for JS `%` on doubles
 * including sign-of-dividend, so an AOT backend must not lower it to an
 * integer `srem`. Same sequencing note as sub. */
CT_OPCODE(/* name */ mod, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "vm/coerce.cpp:to_number_value + std::fmod (+ vm/coerce.cpp:bigint_binary)")

/* NOT std::pow: context::exponentiate overrides C99 F.10.4.4 so `1 ** NaN`
 * and `(-1) ** Infinity` are NaN rather than 1 - an AOT backend lowering `**`
 * to a libm call reintroduces the bug. Same sequencing note as sub. */
CT_OPCODE(/* name */ pow, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "vm/coerce.cpp:to_number_value + vm/coerce.cpp:exponentiate (+ bigint_binary)")

/* The BigInt test comes FIRST, so to_number_value's "Cannot convert a
 * BigInt value to a number" TypeError is unreachable from `-x`. The reachable
 * faults are a user valueOf/toString throwing, the 512-frame ceiling (a
 * raise, not catchable) and the allocation ceiling. */
CT_OPCODE(/* name */ negate, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "vm/coerce.cpp:to_number_value (bigint arm inline)")

/* The one opcode in this group whose BigInt TypeError is reachable without
 * a bigint PAIR - `+1n` throws here while `1n + 1n` does not. Emitted only
 * for unary `+`, and it is a genuine conversion, not a move. */
CT_OPCODE(/* name */ to_number, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "vm/coerce.cpp:to_number_value")

/* The only opcode of the arithmetic group with every RISK column false -
 * ToBoolean never invokes valueOf - yet resumable is still true, so an AOT
 * backend can lower it to a tag test but must still be able to start at this
 * instruction after a suspension. */
CT_OPCODE(/* name */ logical_not, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "vm/coerce.cpp:truthy")

/* Also the SWITCH dispatcher: compile_switch emits `equal matched, subject,
 * candidate` per case, so `switch` is a chain of effect-free `===`. */
CT_OPCODE(/* name */ equal, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "value.hpp:value::strict_equals")

/* `!=` does NOT come here - it is loose_not_equal - so the pair
 * (equal,not_equal) is effect-free while (loose_equal,loose_not_equal) is
 * not; an AOT peephole that treats all four as one family will attach the
 * wrong effect bits. */
CT_OPCODE(/* name */ not_equal, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "value.hpp:value::strict_equals")

/* Its two hottest emission sites are not `==` at all: the optional-chaining
 * null test is `loose_equal test, base, nullish`, and there loose_equals
 * returns before any to_primitive - so every `?.` site is provably
 * non-reentering and an AOT backend should specialise on a null-literal
 * operand. */
CT_OPCODE(/* name */ loose_equal, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "vm/coerce.cpp:context::loose_equals")

/* Every dynamic instance is a real `!=` on unknown operands - there is no
 * benign specialisation the way there is for loose_equal. */
CT_OPCODE(/* name */ loose_not_equal, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "vm/coerce.cpp:context::loose_equals")

/* Three of its four emission sites are COMPILER-INTERNAL loop bounds -
 * `less test, index, length` for spread, array destructuring and for-of -
 * where both operands are engine-produced numbers; only the compile_binary
 * site is a genuine call site. */
CT_OPCODE(/* name */ less, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "vm/coerce.cpp:context::compare_relational")

/* `unordered` (either side NaN after coercion) makes is_lteq false, so
 * NaN <= NaN is false; an AOT backend must keep the three-way result rather
 * than lowering to a bool. */
CT_OPCODE(/* name */ less_equal, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "vm/coerce.cpp:context::compare_relational")

/* Two strings compare with std::string::compare - UTF-8 byte order rather
 * than UTF-16 code-unit order - so a numeric-only AOT fast path silently
 * reintroduces an all-false string comparison. */
CT_OPCODE(/* name */ greater, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "vm/coerce.cpp:context::compare_relational")

/* A BigInt compares exactly against a Number (bigint_compare_double)
 * instead of rounding through a double - this opcode must not be folded to a
 * double compare when either side may be a bigint. */
CT_OPCODE(/* name */ greater_equal, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "vm/coerce.cpp:context::compare_relational")

/* Two columns fight the name. It MUTATES its right operand - the first `x
 * instanceof F` creates and installs F.prototype (ensure_prototype) - and it
 * never throws where the spec demands: `x instanceof 5`, a non-callable RHS
 * and `x instanceof someProxy` are all silently false, there is no
 * Symbol.hasInstance, and the chain walk stops at 64 links. */
CT_OPCODE(/* name */ instance_of, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "inline; vm/call/construct.cpp:context::ensure_prototype, vm.hpp:context::implicit_prototypes")

/* b is the KEY and c is the TARGET. An array answers only about integer
 * indices so `'length' in []` is false, and a non-object RHS is false rather
 * than a TypeError. */
CT_OPCODE(/* name */ has_property, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "inline; vm/call/invoke.cpp:context::proxy_trap + context::call, vm/objects/lookup.cpp:context::lookup_property, vm/coerce.cpp:context::to_string")

/* The whole bitwise group: in a real engine a bitwise operator CAN re-enter
 * because ToNumeric does ToPrimitive; here the static to_int32/to_uint32 skip
 * the object walk, so `({valueOf:()=>3}) & 7` is 0 where a browser gives 3.
 * A deviation, not an optimisation. allocates/may_throw/is_safepoint on this
 * row are entirely the BigInt arm's doing. */
CT_OPCODE(/* name */ bit_and, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "script/vm.hpp:to_int32 (+ vm/coerce.cpp:bigint_binary)")

/* Same non-re-entrant ToInt32 deviation as bit_and. On the pure-Number path
 * a specialising AOT backend that has proven both operands are Numbers can
 * drop the exception edge, the safepoint AND the runtime call - but not the
 * resume label. */
CT_OPCODE(/* name */ bit_or, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "script/vm.hpp:to_int32 (+ vm/coerce.cpp:bigint_binary)")

/* Same non-re-entrant ToInt32 deviation as bit_and. */
CT_OPCODE(/* name */ bit_xor, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "script/vm.hpp:to_int32 (+ vm/coerce.cpp:bigint_binary)")

/* Two distinct BigInt exceptions (RangeError for an oversized shift,
 * TypeError for a mixed pair) on an opcode whose Number path has no
 * exception edge at all. The uint32 round-trip exists to avoid
 * signed-overflow UB - a naive AOT lowering of `int32 << n` reintroduces it,
 * and so does dropping the & 31U mask. */
CT_OPCODE(/* name */ shl, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "script/vm.hpp:to_int32/to_uint32 (+ vm/coerce.cpp:bigint_binary)")

/* Same non-re-entrant ToInt32 deviation as bit_and, plus the shift-too-
 * large RangeError that shl also carries. */
CT_OPCODE(/* name */ shr, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "script/vm.hpp:to_int32/to_uint32 (+ vm/coerce.cpp:bigint_binary)")

/* The only opcode whose BigInt path is unconditionally a throw: allocates
 * is true SOLELY because make_error builds an Error object, so an AOT
 * backend can treat the allocation as belonging to the throw edge. One
 * bigint gives "Cannot mix BigInt...", two give "BigInts have no unsigned
 * right shift". */
CT_OPCODE(/* name */ ushr, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "script/vm.hpp:to_uint32 (+ vm/coerce.cpp:bigint_binary)")

/* NO JS-CATCHABLE THROW ON EITHER ARM - `~1n` computes and `~obj` is -1 -
 * so may_throw is true only through the allocation ceiling's raise, which
 * is not catchable: an AOT backend needs a fault edge, not an exception
 * edge, and only on the BigInt arm. */
CT_OPCODE(/* name */ bit_not, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "script/vm.hpp:to_int32 (bigint arm inline)")

/* b is the HIGH half and c the LOW half (with_bx does `wide >> 16` into b),
 * so the `bx_hi` label on c is the inverse of the physical layout. No bounds
 * check: the loop head's `ip >= code.size()` test is the only guard, and an
 * out-of-range target ends the whole run_loop invocation with undefined
 * WITHOUT popping the frame. */
CT_OPCODE(/* name */ jump, /* a_kind */ unused, /* b_kind */ jump, /* c_kind */ bx_hi, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* ToBoolean never re-enters here because an object is truthy BY TAG - no
 * valueOf runs - which makes this and its three siblings the only branches
 * in the ISA with neither a safepoint nor an exception edge. */
CT_OPCODE(/* name */ jump_if_false, /* a_kind */ reg, /* b_kind */ jump, /* c_kind */ bx_hi, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "vm/coerce.cpp:context::truthy")

/* Emitted for `||` and for every `?.`; the optional-call form funnels many
 * of these into one shared merge label through optional_exits_, so an AOT
 * CFG builder must expect a join with many predecessors. */
CT_OPCODE(/* name */ jump_if_true, /* a_kind */ reg, /* b_kind */ jump, /* c_kind */ bx_hi, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "vm/coerce.cpp:context::truthy")

/* Tests null/undefined only, never falsiness - `0 ?? 5` is 0 and `"" ??
 * "x"` is "" - and it is emitted for both `??` and `??=`, so rewriting it
 * to jump_if_true during optimisation breaks both silently. */
CT_OPCODE(/* name */ jump_if_not_nullish, /* a_kind */ reg, /* b_kind */ jump, /* c_kind */ bx_hi,
          /* writes_a */ 0, /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0,
          /* is_safepoint */ 0, /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

CT_OPCODE(/* name */ jump_if_defined, /* a_kind */ reg, /* b_kind */ jump, /* c_kind */ bx_hi, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* b is used as a frame-slot offset on one of its two paths - an AOT backend
 * must not lower it as a pure literal count. The handler reads two different
 * sources depending on whether the body also built an `arguments` array,
 * because building that array claimed a register an extra argument may have
 * been sitting in. The compiler happens to emit a == b, which is not a
 * general invariant. may_throw is only the allocation-ceiling raise. */
CT_OPCODE(/* name */ gather_rest, /* a_kind */ reg, /* b_kind */ count, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* UNLIKE op::call THIS RUNS THE CALLEE SYNCHRONOUSLY, in a nested
 * interpreter loop. may_suspend is false by the letter of the definition
 * (this frame is never lifted; the promise just lands in reg(a)), but the
 * instruction can still set the VM-wide suspended_ flag - 'does not suspend'
 * is not 'suspension-neutral'. */
CT_OPCODE(/* name */ apply, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "vm/call/invoke.cpp:call")

/* Like apply, the constructor body runs to completion inside the
 * instruction. */
CT_OPCODE(/* name */ construct_apply, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "vm/call/construct.cpp:construct")

/* writes_a is FALSE - a is the object being defined on. The two target paths
 * differ: object_object::define_accessor erases a shadowing data property
 * first and closure_object's does NOT, and lookup_property checks find()
 * before find_accessor, so a `static get x()` on a class that already has a
 * static data property `x` never runs. The unused half is passed as
 * undefined and accessor_table::define skips undefined halves, which is what
 * merges a get/set pair into one entry. */
CT_OPCODE(/* name */ define_getter, /* a_kind */ reg, /* b_kind */ nidx, /* c_kind */ reg, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "inline (shared block with define_setter)")

/* Installing an accessor only STORES the function; it never invokes it, so
 * may_reenter is false here even though every later get_prop/set_prop of
 * that property WILL re-enter. Same closure-target asymmetry as
 * define_getter. Do not fuse the two opcodes into one handler keyed on a
 * flag operand: the discriminator is the OPCODE ITSELF, and no operand
 * carries it. */
CT_OPCODE(/* name */ define_setter, /* a_kind */ reg, /* b_kind */ nidx, /* c_kind */ reg, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "inline (shared block with define_getter)")

/* may_throw is only the allocation ceiling's raise, NOT catchable by a JS
 * try/catch, so an AOT backend needs an abort edge here, not an exception
 * edge. */
CT_OPCODE(/* name */ new_object, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "vm.hpp:context::make_object")

/* Same as new_object: the only failure is the allocation ceiling's raise. */
CT_OPCODE(/* name */ new_array, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "vm.hpp:context::make_array")

/* Despite bytecode.hpp's 'inline-cache site' there is NO cache - it is an
 * unconditional call into lookup_property, so an innocent named load both
 * runs user JS and allocates. C++17 sequences the RHS before `reg(in.a)`,
 * which is the only reason the reference survives registers_ reallocation
 * during the nested call - an AOT backend MUST re-derive the frame pointer
 * after any reentrant call. A getter that throws is harmless to the catch
 * slot: compile_try allocates the catch register BEFORE the try body, so
 * every temporary in the body sits strictly above it. */
CT_OPCODE(/* name */ get_prop, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ nidx, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "vm/objects/lookup.cpp:lookup_property")

/* writes_a is FALSE despite a being the first operand - a names the target
 * object. store_property's array arm honours only `length` on an array
 * target and DROPS every other named write, and its tail drops a write to a
 * primitive. Whether this opcode re-enters is decided by the RUNTIME TYPE of
 * the target, not by the instruction. */
CT_OPCODE(/* name */ set_prop, /* a_kind */ reg, /* b_kind */ nidx, /* c_kind */ reg, /* writes_a */ 0,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "vm/objects/store.cpp:store_property")

/* The surprise is the KEY, not the property: `o[k]` runs user code for the
 * key's coercion as well as for any getter or proxy trap on the result. Only
 * array-with-number and string-with-number are re-entry-free, and the string
 * fast path still allocates one heap string per read AND indexes BYTES, not
 * code points. */
CT_OPCODE(/* name */ get_index, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "vm/objects/lookup.cpp:lookup_index")

/* writes_a is FALSE - a is the target object. The typed-array/element path
 * calls the NON-coercing to_number, so `typed[i] = objWithValueOf` stores
 * NaN instead of running valueOf, while the identical write to a plain
 * object DOES run toString on the key. Re-entry, allocation and throw all
 * depend on the runtime types of BOTH a and b. */
CT_OPCODE(/* name */ set_index, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ reg, /* writes_a */ 0,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "inline + vm/objects/store.cpp:store_property")

/* NOT Array.prototype.push: it neither reads nor writes `length` as a
 * property, never consults a prototype, and is a SILENT NO-OP when a is not
 * heap_kind::array. Unguarded against a typed-array view, whose `items`
 * stays empty. An AOT backend must preserve the new_array-then-append
 * invariant rather than assume it. */
CT_OPCODE(/* name */ append, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* bx is a FUNCTION index into program::functions, not a constant-pool
 * index, and WHICH program it indexes is a run-time choice - the running
 * closure's owner. may_throw is ONLY the allocation ceiling's raise. */
CT_OPCODE(/* name */ closure, /* a_kind */ reg, /* b_kind */ fidx, /* c_kind */ bx_hi, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* A CALLABLE PROXY IS REJECTED: value::is_callable() is true for a proxy
 * over a function but the handler only accepts is_kind(function)/
 * is_kind(native), so calling a function proxy takes the TypeError path -
 * whereas op::apply on the same value runs it. The JS-closure path does NOT
 * run the callee: it pushes a frame whose base IS the caller's argument
 * window (base+a+1) and falls back to dispatch, so a is written later by the
 * callee's ret. writes_a is therefore true only on the native and generator
 * paths. may_reenter comes from natives and from the error path's ToString,
 * never from the frame push. pending_new_target_ is consumed here only on
 * the frame-push path, so a native or generator callee leaves it set for
 * the next call. */
CT_OPCODE(/* name */ call, /* a_kind */ reg, /* b_kind */ count, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "inline (frame push); vm/call/coroutines.cpp:make_generator for a generator callee; vm/call/invoke.cpp:describe_callee + vm/call/invoke.cpp:callee_origin and vm.hpp:throw_error -> vm.hpp:unwind_to_handler on the TypeError path")

/* c is a NAME-TABLE index. Register a is the receiver on the way in and the
 * result on the way out. The handler can enter user JavaScript twice in one
 * instruction (getter or proxy trap during the lookup, then a native
 * callee), and it can allocate on the lookup alone with no user code
 * involved. */
CT_OPCODE(/* name */ call_method, /* a_kind */ reg, /* b_kind */ count, /* c_kind */ nidx, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "vm/objects/lookup.cpp:lookup_property for the callee, then the shared op::call body (inline frame push / native fn / vm/call/coroutines.cpp:make_generator)")

/* Up to three user-JS entries in one instruction, in this order: the key's
 * ToString, the property lookup's getter or proxy trap, and a native callee
 * - and the key's ToString runs twice if the callee turns out not to be a
 * function. The string-index fast path allocates a heap string, so even
 * `s[0]()` on a plain string allocates with no user code running. */
CT_OPCODE(/* name */ call_computed, /* a_kind */ reg, /* b_kind */ count, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "vm/objects/lookup.cpp:lookup_index (-> vm/coerce.cpp:to_string, vm/objects/lookup.cpp:lookup_property) for the callee, then the shared op::call body")

/* `new C()` RE-ENTERS USER JAVASCRIPT BEFORE C'S BODY STARTS, via class
 * field initialisers run in a nested interpreter loop. The instance is
 * allocated and the initialisers run BEFORE the is-a-function check, so the
 * failing path has already allocated an object with a prototype installed.
 * Unlike op::call this sets the frame's new_target to the callee itself and
 * never consumes pending_new_target_. */
CT_OPCODE(/* name */ construct, /* a_kind */ reg, /* b_kind */ count, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "inline; vm/call/construct.cpp:construct for proxy and native callees; vm/call/construct.cpp:ensure_prototype and vm/call/construct.cpp:run_field_initialisers on the closure path")

/* The only call opcode that does no property lookup, so a getter cannot
 * fire during callee resolution - but the error path can still run user
 * JavaScript. It is the opcode a non-spread `super(...)` uses, which makes
 * it (with op::apply) one of the two consumers of pending_new_target_; a
 * native or generator callee returns without consuming it. */
CT_OPCODE(/* name */ call_receiver, /* a_kind */ reg, /* b_kind */ count, /* c_kind */ reg, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "inline (frame push); vm/call/coroutines.cpp:make_generator for a generator callee; vm/call/invoke.cpp:describe_callee on the TypeError path")

/* `{...o}` is specified to READ each own enumerable property and therefore
 * to run source getters, but accessors live in a separate table this
 * handler never touches - so spread silently DROPS every accessor property,
 * and may_reenter is false where an AOT backend would guess true. A no-op
 * when the target is not heap_kind::object, and a proxy/native/string/
 * closure SOURCE copies nothing (no ownKeys/get traps). The target is always
 * a fresh new_object. */
CT_OPCODE(/* name */ copy_props, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* b indexes `names`. is_object() is exactly heap_kind::object, so delete on
 * an array, proxy, native or closure is a silent no-op. Either way the
 * expression still evaluates to `true`. */
CT_OPCODE(/* name */ delete_prop, /* a_kind */ reg, /* b_kind */ nidx, /* c_kind */ unused, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* THE PAIR DISAGREES: delete_prop cannot re-enter, allocate or throw;
 * delete_index can do all three - purely because the key arrives as a
 * value. The coercion is guarded, so `delete arr[objKey]` and
 * `delete proxy[objKey]` never run the key's toString at all, where the
 * spec's ToPropertyKey is unconditional. */
CT_OPCODE(/* name */ delete_index, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 0,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline + vm/coerce.cpp:to_string")

/* Emitted as `{op::own_keys, source, source}`, so a and b ALIAS - safe only
 * because the array is made first and reg(in.a) is written last; an AOT
 * backend must preserve that order. OWN keys only (no prototype walk), a
 * proxy enumerates its TARGET (no ownKeys trap), and a native/string/closure
 * operand yields an EMPTY array. GC HAZARD: the array under construction
 * lives only in a C++ local across N allocations, and the collector does not
 * root C++ locals. The same shape appears in make_arguments and gather_rest. */
CT_OPCODE(/* name */ own_keys, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* One of the largest user-JS re-entry points (every for-of and spread), but
 * only a generator body or an accessor on an INDEX key runs. Three surprises
 * for an AOT backend: it MATERIALIZES (an infinite generator hangs); and its
 * is_array() fast path returns THE SAME array, so `for (x of arr)` aliases
 * rather than copies, while every other input is a fresh array. Because
 * re-entry can throw, unwind_to_handler may redirect this very frame's ip
 * before `reg(in.a) = ...` executes. */
CT_OPCODE(/* name */ iterable, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "vm/call/invoke.cpp:context::iterable_values")

/* writes_a is FALSE even though a is written in the JS sense - it MUTATES
 * the object in register a rather than storing into the register. No cycle
 * check, which is exactly why lookup_property and assign_through_accessor
 * both carry a depth-64 cap. Silently a no-op when a is a
 * closure/array/proxy/native - it cannot do what Object.setPrototypeOf does
 * for a closure. */
CT_OPCODE(/* name */ set_proto, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* is_object() is heap_kind::object exactly, so this reports undefined for
 * an array, string, proxy, native and CLOSURE (whose chain is
 * closure_object::proto_link, never read here). A fresh object's prototype
 * is value::null() and only `extends` sets it, so `super.m()` in a
 * base-class method reads NULL here. Emitted as `{op::get_proto, dst, dst}`
 * right after load_home, so a and b alias. */
CT_OPCODE(/* name */ get_proto, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* It takes NO operand for the object - the source is implicit VM state (the
 * running frame's closure), which an AOT backend must model as a read of the
 * frame. The home object is an ORDINARY, observable property named "__home"
 * installed by op::set_prop on the constructor and on each method closure,
 * so a page that assigns obj.__home changes what `super` resolves against. */
CT_OPCODE(/* name */ load_home, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* await NEVER re-enters user JS here (no `then` is called on a thenable,
 * the promise state is read with own-property find). An AOT backend must
 * compile this as a return-with-continuation, since the suspend path pops
 * the frame and stores into the caller's slot, not into a. is_pending_promise
 * uses is_object() == heap_kind::object exactly, so a promise behind a Proxy
 * is never seen as pending and `await proxyPromise` falls straight through
 * to the read path. */
CT_OPCODE(/* name */ await_value, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 1, /* resumable */ 1,
          /* impl */ "inline (suspend path calls vm.hpp:context::attach_resume + the installed pending_promise_factory_; resumed by vm/call/coroutines.cpp:context::resume)")

/* writes_a is FALSE even though a is the destination of `var x = yield y`.
 * Like await_value this is a FRAME EXIT - the frame is popped and the
 * produced value returned out of run_loop to generator_resume - so a
 * frame-suspending opcode comes out NOT a safepoint under the rule; an AOT
 * backend must still keep the whole register window live across it, because
 * it is copied wholesale. The raise is reachable only if a yield executes
 * under a run_loop that is not generator_resume's. */
CT_OPCODE(/* name */ yield_value, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 1, /* resumable */ 1,
          /* impl */ "inline (resumed by vm/call/coroutines.cpp:context::generator_resume)")

/* The "already a promise" test is is_object() && own __value, so any plain
 * object carrying an own __value is left unwrapped, and because is_object()
 * is heap_kind::object exactly an array, function or proxy returned from an
 * async function is ALWAYS re-wrapped. In a context with no promise_factory_
 * installed make_promise is the identity, so allocates, may_throw and
 * is_safepoint all collapse to false - the columns are true only because
 * install_promise ran. */
CT_OPCODE(/* name */ wrap_promise, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "vm.hpp:context::wrap_in_promise (the already-a-promise test AND context::make_promise -> the installed promise_factory_, builtins/internal.hpp:make_promise). Shared with the compiled tier: ct_aot_wrap_promise is that member and nothing else")

/* writes_a is FALSE even though the opcode produces a value: a is a SOURCE
 * operand, and the destination is the caller's result_reg. A constructor
 * frame's `return <primitive>` is silently rewritten to `this`, and when
 * frames_.size() <= stop_depth this RETURNS OUT OF run_loop entirely, which
 * is how context::invoke, generator_resume and resume collect their result. */
CT_OPCODE(/* name */ ret, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* All three operands are genuinely dead. Its one non-obvious effect is the
 * shared constructing-frame substitution, which is what makes a class
 * constructor with no explicit return evaluate to the instance rather than
 * to undefined - so an AOT backend that lowers this to `return undefined`
 * miscompiles every `new`. */
CT_OPCODE(/* name */ ret_undef, /* a_kind */ unused, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* `typeof` looks like the cheapest opcode in the set and is in fact the only
 * NON-arithmetic allocator here - one heap string per execution, so
 * interning the eight fixed answers is an obvious AOT win. may_throw is only
 * the allocation ceiling. `typeof undeclared` is get_global + this on one
 * register, and it is the get_global that makes the pair silent - see its
 * row. */
CT_OPCODE(/* name */ type_of, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "vm/coerce.cpp:type_of")

/* Classic script entry receives the realm's stable global_this value; module
 * entry receives undefined. Arrows retain their lexical receiver through
 * effective_this. Bare calls have no sloppy-mode substitution: a frame
 * entered with no receiver observes raw undefined. The mutable globalThis
 * binding is not consulted when selecting any frame's receiver. */
CT_OPCODE(/* name */ load_this, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "vm.hpp:context::effective_this")

/* Reads call_frame::new_target. context::resume rebuilds the frame without
 * copying new_target, so `new.target` reads undefined after an await inside
 * a constructor-invoked function. */
CT_OPCODE(/* name */ load_new_target, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused,
          /* writes_a */ 1, /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0,
          /* is_safepoint */ 0, /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* A ZERO-OPERAND opcode, welded to the call that follows. The pending value
 * is cleared in only two places, both JS-closure frame pushes; the inline
 * call path returns early for a native callee and for a generator, and
 * op::construct sets its own new_target without clearing it. So
 * `class X extends Array { constructor(){ super(); } }` leaves
 * pending_new_target_ = X set, and the next ordinary JS call anywhere in the
 * program sees a truthy `new.target`. An AOT backend must reproduce the set
 * AND the leak, or reproduce neither. */
CT_OPCODE(/* name */ pass_new_target, /* a_kind */ unused, /* b_kind */ unused, /* c_kind */ unused,
          /* writes_a */ 0, /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0,
          /* is_safepoint */ 0, /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* The only opcode in this set that reads c as an index rather than as a bx
 * half - b is the EXPORT NAME and c the SPECIFIER, which is the reverse of
 * the reading order. What lands in register a is a CELL, not a value, so
 * every later read goes through cell_get (bind_imports marks the local boxed
 * and deliberately emits NO new_cell); on both failure paths register a is
 * left holding undefined. A missing module or missing export is an
 * UNCATCHABLE engine fault here, not the ReferenceError a spec-conformant
 * AOT backend might be tempted to emit. */
CT_OPCODE(/* name */ load_import, /* a_kind */ reg, /* b_kind */ nidx, /* c_kind */ nidx, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "vm/call/modules.cpp:context::module_import_cell")

/* Data flows record -> register: the handler ADOPTS the record's
 * pre-existing cell INTO register a, because context::instantiate_module
 * created every cell before any module in the graph ran. writes_a is
 * conditional on being inside a module - outside one the register keeps the
 * local it already held, which is why context::module_export_cell takes
 * that value and answers it rather than answering undefined. b is
 * structurally the bx high half but is ALWAYS 0 here, so a decoder that
 * reads only b gets index 0 and silently exports the wrong name. */
CT_OPCODE(/* name */ bind_export, /* a_kind */ reg, /* b_kind */ nidx, /* c_kind */ bx_hi, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "vm/call/modules.cpp:context::module_export_cell")

/* TWO independent user-JS re-entries before it returns (the specifier's
 * toString, then the imported graph), and the referrer comes from
 * vm_frame->proto->module rather than current_module_. Unlike load_import
 * and load_namespace, this handler does NOT write undefined into register a
 * on its way in, and the store is skipped after any raise - an AOT backend
 * that models dyn_import as "always defines a" is wrong on that path.
 * may_suspend stays false: the imported module's top-level frame can
 * suspend, but this frame does not. */
CT_OPCODE(/* name */ dyn_import, /* a_kind */ reg, /* b_kind */ reg, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "vm/call/modules.cpp:context::dynamic_import (calls the embedder's module_loader_; ctbrowser installs one in Shell/browser.cpp)")

/* Encoding asymmetry an AOT backend must reproduce exactly: bind_export
 * uses the bx pair while load_namespace and load_import read a plain 16-bit
 * b. The namespace object is identity-cached in
 * module_record::namespace_object, so two `import * as` of the same module
 * produce the same object; reading a property OFF it later is an accessor
 * call, so the re-entry cost is paid by get_prop, not here. */
CT_OPCODE(/* name */ load_namespace, /* a_kind */ reg, /* b_kind */ nidx, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "vm/call/modules.cpp:context::module_namespace_for")

/* Despite the name it does not build a function object; the closure already
 * exists and is already a GC root through the frame. Emitted only for a
 * named function expression's self-binding, immediately followed by new_cell
 * when the name is captured. Yields undefined in the top-level script frame,
 * which has no closure. resumable=true rests on the generator-start path. */
CT_OPCODE(/* name */ load_callee, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 1,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 1, /* impl */ "inline")

/* b and c are unused but the instruction has a HIDDEN read of slots
 * 0..argc-1, so an AOT backend must keep those live and must not sink it
 * below the parameter prologue; argc comes from the frame, never from
 * proto->param_count; and it writes the frame side-slot arguments_object
 * that gather_rest reads. */
CT_OPCODE(/* name */ make_arguments, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused,
          /* writes_a */ 1, /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 0,
          /* is_safepoint */ 1, /* may_suspend */ 0, /* resumable */ 1,
          /* impl */ "inline; vm.hpp:context::make_array")

/* writes_a is FALSE despite bytecode.hpp's "a = catch register". The branch
 * offset is added to the ALREADY-INCREMENTED ip, which is what patch_jump's
 * `target - at_index - 1` compensates for. It is also the only opcode that
 * captures the register high-water ABSOLUTELY (handler::reg_top =
 * registers_.size()), which await_value and yield_value rebase to
 * frame-relative when a frame suspends and resume/generator_resume rebase
 * back. */
CT_OPCODE(/* name */ push_handler, /* a_kind */ reg, /* b_kind */ jump, /* c_kind */ bx_hi, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* It pops the GLOBALLY innermost handler without consulting
 * vm_frame->handler_base, so a mis-balanced emission silently drops a
 * CALLER's catch; balance is a compiler invariant only (compile_break and
 * compile_continue emit one per open try when leaving the block). */
CT_OPCODE(/* name */ pop_handler, /* a_kind */ unused, /* b_kind */ unused, /* c_kind */ unused,
          /* writes_a */ 0, /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0,
          /* is_safepoint */ 0, /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")

/* may_reenter TRUE hides on the path nobody instruments: only an UNCAUGHT
 * throw reads .name/.message (or falls to to_string), so `throw` of an
 * object with a getter for message, or of a Proxy, runs page JavaScript
 * while formatting a fatal error. unwind_to_handler searches the GLOBAL
 * handlers_ stack, so a throw from inside a re-entrant handler can redirect
 * the current frame's ip before that handler's own trailing register write
 * executes. */
CT_OPCODE(/* name */ throw_value, /* a_kind */ reg, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 0,
          /* allocates */ 1, /* may_throw */ 1, /* may_reenter */ 1, /* is_safepoint */ 1,
          /* may_suspend */ 0, /* resumable */ 0,
          /* impl */ "inline (vm.hpp:context::unwind_to_handler, vm/call/invoke.cpp:context::describe_thrown)")

/* Dead by construction: the compiler never emits halt, so its only
 * reachable form is a zero-initialised instruction (an all-zero 64-bit word
 * decodes as halt). Its handler returns out of run_loop WITHOUT popping the
 * frame, so were it ever reached from a nested loop the caller would resume
 * with a stale frame left on frames_ - a genuine difference from ret that an
 * AOT backend must not paper over by treating halt as "return". */
CT_OPCODE(/* name */ halt, /* a_kind */ unused, /* b_kind */ unused, /* c_kind */ unused, /* writes_a */ 0,
          /* allocates */ 0, /* may_throw */ 0, /* may_reenter */ 0, /* is_safepoint */ 0,
          /* may_suspend */ 0, /* resumable */ 0, /* impl */ "inline")
